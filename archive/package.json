{
  "name": "archive",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "thumbhash": "node scripts/generate-thumbhash.mjs",
    "prebuild": "node scripts/generate-thumbnails.mjs && node scripts/generate-thumbhash.mjs && node scripts/generate-og-image.mjs",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "astro": "astro",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:update": "playwright test --update-snapshots"
  },
  "dependencies": {
    "@astrojs/alpinejs": "^0.4.9",
    "@astrojs/rss": "^4.0.14",
    "@astrojs/sitemap": "^3.6.1",
    "@astrojs/tailwind": "^6.0.2",
    "@pagefind/default-ui": "^1.4.0",
    "alpinejs": "^3.15.3",
    "astro": "^5.16.6",
    "pixi.js": "^8.15.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.0",
    "thumbhash": "^0.1.1",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "pagefind": "^1.4.0",
    "serve": "^14.2.5"
  }
}