---
import { ViewTransitions } from 'astro:transitions';
import SearchModal from '../components/SearchModal.astro';

interface Props {
  title?: string;
  description?: string;
  structuredData?: object;
  image?: string;
}

const {
  title = 'Collection',
  description = 'A curated collection of coins, jewelry, rings, cylinder seals, and small antiques.',
  structuredData,
  image
} = Astro.props;

const defaultStructuredData = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "The Archive",
  "description": description,
  "url": Astro.url.href
};

const pathname = Astro.url.pathname;
const base = import.meta.env.BASE_URL;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const defaultOgImage = new URL('/og-image.png', Astro.site).href;
const ogImage = image ? new URL(image, Astro.site).href : defaultOgImage;

function url(path: string): string {
  return `${base}${path}`.replace(/\/+/g, '/');
}

function isActive(path: string): boolean {
  const fullPath = url(path);
  return pathname === fullPath || pathname === fullPath + '/';
}
---

<!DOCTYPE html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0a0a0f" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/png" sizes="32x32" href={url('/favicon-32.png')} />
    <link rel="icon" type="image/png" sizes="16x16" href={url('/favicon-16.png')} />
    <link rel="apple-touch-icon" sizes="180x180" href={url('/apple-touch-icon.png')} />
    <link rel="alternate" type="application/rss+xml" title="The Archive Articles" href={url('/rss.xml')} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="The Antique Archive" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Additional SEO -->
    <meta name="robots" content="index, follow" />
    <meta name="author" content="The Antique Archive" />
    <meta name="geo.region" content="HK" />
    <meta name="geo.placename" content="Hong Kong" />
    <style set:html={`
      @font-face {
        font-family: 'Space Grotesk';
        font-style: normal;
        font-weight: 300 700;
        font-display: swap;
        src: url('${base}/fonts/space-grotesk-variable.woff2') format('woff2');
      }
      @font-face {
        font-family: 'JetBrains Mono';
        font-style: normal;
        font-weight: 400;
        font-display: swap;
        src: url('${base}/fonts/JetBrainsMono-Regular.woff2') format('woff2');
      }
      @font-face {
        font-family: 'Noto Sans Cuneiform';
        font-style: normal;
        font-weight: 400;
        font-display: swap;
        src: url('${base}/fonts/noto-sans-cuneiform.woff2') format('woff2');
      }
      @font-face {
        font-family: 'Noto Sans Egyptian Hieroglyphs';
        font-style: normal;
        font-weight: 400;
        font-display: swap;
        src: url('${base}/fonts/noto-sans-egyptian-hieroglyphs.woff2') format('woff2');
      }
    `} />
    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify(structuredData || defaultStructuredData)} />
    <ViewTransitions />
  </head>
  <body class="min-h-screen flex flex-col bg-void">
    <!-- Skip to main content link for accessibility -->
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-[100] focus:bg-accent focus:text-void focus:px-4 focus:py-2 focus:rounded focus:font-mono focus:text-sm">
      Skip to content
    </a>

    <!-- Preload font glyphs for matrix effect (hidden) -->
    <div aria-hidden="true" style="position:absolute;left:-9999px;font-size:1px;">
      <span style="font-family:'Noto Sans Cuneiform'">𒀀𒀁𒀂𒀃𒀄𒀅𒁀𒁁𒁂𒁃𒂀𒂁𒃸𒄀𒄁𒄂𒅀𒅁𒆀𒆁𒇀𒇁</span>
      <span style="font-family:'Noto Sans Egyptian Hieroglyphs'">𓀀𓀁𓀂𓀃𓁀𓁁𓁂𓁃𓂀𓂁𓂂𓃀𓃁𓃂𓄀𓄁𓅀𓅁𓆀𓆁𓇀𓇁𓈀𓈁𓉀𓊀𓋀𓌀𓍀𓎀𓏀</span>
    </div>
    <!-- Matrix background effect -->
    <canvas id="matrix-bg" aria-hidden="true"></canvas>

    <!-- Navigation progress bar -->
    <div
      id="nav-progress"
      class="fixed top-0 left-0 h-0.5 bg-gradient-to-r from-accent to-cyan-300 z-[100] opacity-0"
      style="width: 0%; transition: width 400ms cubic-bezier(0.4, 0, 0.2, 1), opacity 200ms ease;"
    ></div>

    <div x-data="{ mobileMenuOpen: false }">
      <header class="sticky top-0 z-50 bg-void/80 backdrop-blur-xl border-b border-white/5" transition:persist>
        <nav class="container-narrow py-4 flex items-center justify-between">
          <a href={url('/')} class="font-mono text-lg tracking-wider text-text hover:text-accent transition-all duration-300 hover:drop-shadow-[0_0_8px_rgba(34,211,238,0.5)]">
            <span class="font-cuneiform text-accent" aria-hidden="true">𒃸𒁀</span> ARCHIVE
          </a>

          <!-- Desktop Navigation -->
          <div class="hidden md:flex items-center gap-6">
            <a
              href={url('/artifacts')}
              class:list={["nav-link font-mono text-xs uppercase tracking-widest", isActive('/artifacts') && "nav-link-active"]}
              aria-current={isActive('/artifacts') ? 'page' : undefined}
            >Artifacts</a>
            <a
              href={url('/coins')}
              class:list={["nav-link font-mono text-xs uppercase tracking-widest", isActive('/coins') && "nav-link-active"]}
              aria-current={isActive('/coins') ? 'page' : undefined}
            >Coins</a>
            <a
              href={url('/timeline')}
              class:list={["nav-link font-mono text-xs uppercase tracking-widest", isActive('/timeline') && "nav-link-active"]}
              aria-current={isActive('/timeline') ? 'page' : undefined}
            >Timeline</a>
            <a
              href={url('/library')}
              class:list={["nav-link font-mono text-xs uppercase tracking-widest", pathname.startsWith(url('/library')) && "nav-link-active"]}
              aria-current={pathname.startsWith(url('/library')) ? 'page' : undefined}
            >Library</a>
            <a
              href={url('/about')}
              class:list={["nav-link font-mono text-xs uppercase tracking-widest", isActive('/about') && "nav-link-active"]}
              aria-current={isActive('/about') ? 'page' : undefined}
            >About</a>
            <button
              @click="window.dispatchEvent(new CustomEvent('toggle-search'))"
              class="nav-link font-mono text-xs uppercase tracking-widest flex items-center gap-1.5"
              aria-label="Search (Cmd+K)"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
              </svg>
              <span>Search</span>
              <kbd class="ml-1 px-1.5 py-0.5 text-[9px] bg-surface-light/50 rounded border border-border text-text-dim">⌘K</kbd>
            </button>
          </div>

          <!-- Mobile Menu Button -->
          <button
            @click.prevent="mobileMenuOpen = !mobileMenuOpen"
            type="button"
            class="md:hidden relative z-50 w-12 h-12 flex items-center justify-center text-text-muted hover:text-accent active:text-accent transition-colors rounded-lg active:bg-white/10 touch-manipulation"
            :class="mobileMenuOpen && 'text-accent'"
            :aria-expanded="mobileMenuOpen"
            aria-label="Toggle navigation menu"
          >
            <span class="sr-only" x-text="mobileMenuOpen ? 'Close menu' : 'Open menu'"></span>
            <div class="w-5 h-4 flex flex-col justify-between pointer-events-none">
              <span
                class="block h-0.5 bg-current rounded-full transition-all duration-300 origin-center"
                :class="mobileMenuOpen ? 'translate-y-[7px] rotate-45' : ''"
              ></span>
              <span
                class="block h-0.5 bg-current rounded-full transition-all duration-300"
                :class="mobileMenuOpen ? 'opacity-0 scale-x-0' : ''"
              ></span>
              <span
                class="block h-0.5 bg-current rounded-full transition-all duration-300 origin-center"
                :class="mobileMenuOpen ? '-translate-y-[7px] -rotate-45' : ''"
              ></span>
            </div>
          </button>
        </nav>
      </header>

      <!-- Mobile Navigation Menu - Outside header to avoid stacking context issues -->
      <div
        x-show="mobileMenuOpen"
        x-cloak
        x-transition:enter="transition ease-out duration-200"
        x-transition:enter-start="opacity-0"
        x-transition:enter-end="opacity-100"
        x-transition:leave="transition ease-in duration-150"
        x-transition:leave-start="opacity-100"
        x-transition:leave-end="opacity-0"
        class="fixed inset-x-0 top-[57px] bottom-0 z-[9999] md:hidden overflow-y-auto"
        style="background-color: #0a0a0f;"
        @keydown.escape.window="mobileMenuOpen = false"
      >
        <nav class="container-narrow py-6 flex flex-col gap-1">
          <a
            href={url('/artifacts')}
            @click="mobileMenuOpen = false"
            class:list={["mobile-nav-link font-mono text-sm uppercase tracking-widest py-3", isActive('/artifacts') && "text-accent border-accent"]}
            aria-current={isActive('/artifacts') ? 'page' : undefined}
          >
            <span class="text-accent mr-2">></span> Artifacts
          </a>
          <a
            href={url('/coins')}
            @click="mobileMenuOpen = false"
            class:list={["mobile-nav-link font-mono text-sm uppercase tracking-widest py-3", isActive('/coins') && "text-accent border-accent"]}
            aria-current={isActive('/coins') ? 'page' : undefined}
          >
            <span class="text-accent mr-2">></span> Coins
          </a>
          <a
            href={url('/timeline')}
            @click="mobileMenuOpen = false"
            class:list={["mobile-nav-link font-mono text-sm uppercase tracking-widest py-3", isActive('/timeline') && "text-accent border-accent"]}
            aria-current={isActive('/timeline') ? 'page' : undefined}
          >
            <span class="text-accent mr-2">></span> Timeline
          </a>
          <div class="py-1">
            <a
              href={url('/library')}
              @click="mobileMenuOpen = false"
              class:list={["mobile-nav-link font-mono text-sm uppercase tracking-widest py-3", pathname.startsWith(url('/library')) && "text-accent border-accent"]}
              aria-current={pathname.startsWith(url('/library')) ? 'page' : undefined}
            >
              <span class="text-accent mr-2">></span> Library
            </a>
            <div class="ml-6 flex flex-col gap-1 mt-1">
              <a
                href={url('/library/articles')}
                @click="mobileMenuOpen = false"
                class:list={["font-mono text-xs uppercase tracking-widest py-2 text-text-muted hover:text-accent transition-colors", isActive('/library/articles') && "text-accent"]}
              >
                <span class="text-accent/50 mr-2">-</span> Articles
              </a>
              <a
                href={url('/library/books')}
                @click="mobileMenuOpen = false"
                class:list={["font-mono text-xs uppercase tracking-widest py-2 text-text-muted hover:text-accent transition-colors", isActive('/library/books') && "text-accent"]}
              >
                <span class="text-accent/50 mr-2">-</span> Books
              </a>
            </div>
          </div>
          <a
            href={url('/about')}
            @click="mobileMenuOpen = false"
            class:list={["mobile-nav-link font-mono text-sm uppercase tracking-widest py-3", isActive('/about') && "text-accent border-accent"]}
            aria-current={isActive('/about') ? 'page' : undefined}
          >
            <span class="text-accent mr-2">></span> About
          </a>
          <a
            href={url('/search')}
            @click="mobileMenuOpen = false"
            class:list={["mobile-nav-link font-mono text-sm uppercase tracking-widest py-3 flex items-center", isActive('/search') && "text-accent border-accent"]}
            aria-current={isActive('/search') ? 'page' : undefined}
          >
            <span class="text-accent mr-2">></span>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
            Search
          </a>
        </nav>
      </div>
    </div>

    <main id="main-content" class="flex-1 relative">
      <div class="absolute inset-0 bg-gradient-to-b from-surface/30 to-transparent pointer-events-none" />
      <slot />
    </main>

    <footer>
      <div class="container-narrow py-8 flex flex-col md:flex-row items-center justify-between gap-4">
        <p class="font-mono text-xs text-text-dim tracking-wide">
          <span class="text-accent">></span> Personal Collection Display
        </p>
        <p class="font-mono text-xs text-text-dim">
          Hong Kong, {new Date().getFullYear()}
        </p>
      </div>
    </footer>

    <!-- Global Search Modal (⌘K) -->
    <SearchModal />

    <script>
      // Navigation progress bar for View Transitions
      document.addEventListener('astro:before-preparation', () => {
        const bar = document.getElementById('nav-progress');
        if (bar) {
          bar.style.opacity = '1';
          bar.style.width = '25%';
        }
      });

      document.addEventListener('astro:after-preparation', () => {
        const bar = document.getElementById('nav-progress');
        if (bar) {
          bar.style.width = '60%';
        }
      });

      document.addEventListener('astro:before-swap', () => {
        const bar = document.getElementById('nav-progress');
        if (bar) {
          bar.style.width = '85%';
        }
      });

      document.addEventListener('astro:page-load', () => {
        const bar = document.getElementById('nav-progress');
        if (bar) {
          bar.style.width = '100%';
          setTimeout(() => {
            bar.style.opacity = '0';
            setTimeout(() => {
              bar.style.width = '0%';
            }, 200);
          }, 150);
        }
      });
    </script>

    <script>
      import { initMatrixEffect } from '../scripts/matrix-effect';
      initMatrixEffect();
    </script>

    <script>
      // Ensure mobile menu closes on navigation and Alpine reinitializes
      document.addEventListener('astro:before-swap', () => {
        // Close mobile menu before page swap
        const xDataEl = document.querySelector('[x-data]');
        if (xDataEl && window.Alpine) {
          const data = window.Alpine.$data(xDataEl);
          if (data) {
            data.mobileMenuOpen = false;
          }
        }
      });
    </script>

    <script>
      // Scroll reveal animations with IntersectionObserver
      function initRevealObserver() {
        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        if (prefersReducedMotion) {
          document.querySelectorAll('.reveal').forEach(el => el.classList.add('revealed'));
          return;
        }

        const observer = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              entry.target.classList.add('revealed');
              observer.unobserve(entry.target);
            }
          });
        }, {
          threshold: 0.1,
          rootMargin: '50px'
        });

        document.querySelectorAll('.reveal').forEach(el => observer.observe(el));
      }

      initRevealObserver();
      document.addEventListener('astro:page-load', initRevealObserver);
    </script>

  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
