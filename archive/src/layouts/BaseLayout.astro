---
import { ViewTransitions } from 'astro:transitions';
import SearchModal from '../components/SearchModal.astro';
import NewsletterSignup from '../components/NewsletterSignup.astro';
import ChangelogNotification from '../components/ChangelogNotification.astro';
import LatestArticlePopup from '../components/LatestArticlePopup.astro';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';
import { getI18nData, DEFAULT_LOCALE, generateHreflangTags, getTranslations } from '../lib/i18n';
import type { Locale } from '../lib/i18n';

interface Props {
  title?: string;
  description?: string;
  structuredData?: object;
  image?: string;
  locale?: Locale;
  alternateUrls?: Record<Locale, string>;
}

// Get i18n data from Astro context
const i18n = getI18nData(Astro);
const { locale, t, pathWithoutLocale, alternateUrls: defaultAlternateUrls, htmlLang, ogLocale } = i18n;

const {
  title = t.meta.siteName,
  description = t.meta.siteDescription,
  structuredData,
  image,
  alternateUrls = defaultAlternateUrls,
} = Astro.props;

const defaultStructuredData = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": t.structuredData.collectionName,
  "description": description,
  "url": Astro.url.href,
  "inLanguage": htmlLang,
};

const pathname = Astro.url.pathname;
const base = import.meta.env.BASE_URL;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const defaultOgImage = new URL('/og-image.png', Astro.site).href;
const ogImage = image ? new URL(image, Astro.site).href : defaultOgImage;

// Generate hreflang tags
const hreflangTags = generateHreflangTags(locale, alternateUrls, pathWithoutLocale);

function url(path: string): string {
  return `${base}${path}`.replace(/\/+/g, '/');
}

function isActive(path: string): boolean {
  const fullPath = url(path);
  return pathname === fullPath || pathname === fullPath + '/';
}
---

<!DOCTYPE html>
<html lang={htmlLang} class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0a0a0f" />
    
    <!-- Canonical and Alternate URLs -->
    <link rel="canonical" href={canonicalURL} />
    {hreflangTags.map(tag => (
      <link rel={tag.rel} hreflang={tag.hreflang} href={tag.href} />
    ))}
    
    <link rel="icon" type="image/png" sizes="32x32" href={url('/favicon-32.png')} />
    <link rel="icon" type="image/png" sizes="16x16" href={url('/favicon-16.png')} />
    <link rel="apple-touch-icon" sizes="180x180" href={url('/apple-touch-icon.png')} />
    <link rel="manifest" href={url('/manifest.webmanifest')} />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Archive" />
    <link rel="apple-touch-startup-image" media="screen and (device-width: 430px) and (device-height: 932px) and (-webkit-device-pixel-ratio: 3) and (orientation: portrait)" href={url('/splash/splash-1290x2796.png')} />
    <link rel="apple-touch-startup-image" media="screen and (device-width: 393px) and (device-height: 852px) and (-webkit-device-pixel-ratio: 3) and (orientation: portrait)" href={url('/splash/splash-1179x2556.png')} />
    <link rel="apple-touch-startup-image" media="screen and (device-width: 390px) and (device-height: 844px) and (-webkit-device-pixel-ratio: 3) and (orientation: portrait)" href={url('/splash/splash-1170x2532.png')} />
    <link rel="alternate" type="application/rss+xml" title="The Archive Articles" href={url('/rss.xml')} />

    <!-- Preload only the primary display font - saves 90KB by not preloading JetBrains Mono -->
    <link rel="preload" href="/fonts/space-grotesk-variable.woff2" as="font" type="font/woff2" crossorigin />
    <!-- JetBrains Mono (90KB) loads on-demand - fallback font shows briefly, acceptable tradeoff -->
    <!-- Specialty fonts (847KB) load only if already cached via font-display: optional -->

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={t.meta.siteName} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={ogLocale} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Additional SEO -->
    <meta name="robots" content="index, follow" />
    <meta name="author" content={t.meta.siteName} />
    <meta name="geo.region" content="HK" />
    <meta name="geo.placename" content="Hong Kong" />
    <style set:html={`
      @font-face {
        font-family: 'Space Grotesk';
        font-style: normal;
        font-weight: 300 700;
        font-display: swap;
        src: url('/fonts/space-grotesk-variable.woff2') format('woff2');
      }
      @font-face {
        font-family: 'JetBrains Mono';
        font-style: normal;
        font-weight: 400;
        font-display: swap;
        src: url('/fonts/JetBrainsMono-Regular.woff2') format('woff2');
      }
      /* Specialty fonts - use 'optional' to prevent blocking render.
         These fonts only load if already cached, otherwise fallback is used.
         This saves 847KB on first load. */
      @font-face {
        font-family: 'Noto Sans Cuneiform';
        font-style: normal;
        font-weight: 400;
        font-display: optional;
        src: url('/fonts/noto-sans-cuneiform.woff2') format('woff2');
      }
      @font-face {
        font-family: 'Noto Sans Egyptian Hieroglyphs';
        font-style: normal;
        font-weight: 400;
        font-display: optional;
        src: url('/fonts/noto-sans-egyptian-hieroglyphs.woff2') format('woff2');
      }
    `} />
    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify(structuredData || defaultStructuredData)} />
    <ViewTransitions />
  </head>
  <body class="min-h-screen flex flex-col bg-void">
    <!-- Skip to main content link for accessibility -->
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-[100] focus:bg-accent focus:text-void focus:px-4 focus:py-2 focus:rounded focus:font-mono focus:text-sm">
      {t.common.skipToContent}
    </a>

    <!-- Preload font glyphs for matrix effect (hidden) -->
    <div aria-hidden="true" style="position:absolute;left:-9999px;font-size:1px;">
      <span style="font-family:'Noto Sans Cuneiform'">𒀀𒀁𒀂𒀃𒀄𒀅𒁀𒁁𒁂𒁃𒂀𒂁𒃸𒄀𒄁𒄂𒅀𒅁𒆀𒆁𒇀𒇁</span>
      <span style="font-family:'Noto Sans Egyptian Hieroglyphs'">𓀀𓀁𓀂𓀃𓁀𓁁𓁂𓁃𓂀𓂁𓂂𓃀𓃁𓃂𓄀𓄁𓅀𓅁𓆀𓆁𓇀𓇁𓈀𓈁𓉀𓊀𓋀𓌀𓍀𓎀𓏀</span>
    </div>
    <!-- Matrix background effect -->
    <canvas id="matrix-bg" aria-hidden="true"></canvas>

    <!-- Navigation progress bar -->
    <div
      id="nav-progress"
      class="fixed top-0 left-0 h-0.5 bg-gradient-to-r from-accent to-cyan-300 z-[100] opacity-0"
      style="width: 0%; transition: width 400ms cubic-bezier(0.4, 0, 0.2, 1), opacity 200ms ease;"
    ></div>

    <header class="sticky top-0 z-50 bg-void/80 backdrop-blur-xl border-b border-white/5 pt-[env(safe-area-inset-top)]" transition:persist x-data>
      <nav class="container-narrow py-4 flex items-center justify-between">
        <a href={url('/')} class="font-mono text-lg tracking-wider text-text hover:text-accent transition-all duration-300 hover:drop-shadow-[0_0_8px_rgba(34,211,238,0.5)]">
          <span class="font-cuneiform text-accent" aria-hidden="true">𒃸𒁀</span> ARCHIVE
        </a>

        <!-- Desktop Navigation -->
        <div class="hidden md:flex items-center gap-6">
          <a
            href={url('/artifacts')}
            class:list={["nav-link font-mono text-xs uppercase tracking-widest", isActive('/artifacts') && "nav-link-active"]}
            aria-current={isActive('/artifacts') ? 'page' : undefined}
          >{t.nav.artifacts}</a>
          <a
            href={url('/coins')}
            class:list={["nav-link font-mono text-xs uppercase tracking-widest", isActive('/coins') && "nav-link-active"]}
            aria-current={isActive('/coins') ? 'page' : undefined}
          >{t.nav.coins}</a>
          <a
            href={url('/timeline')}
            class:list={["nav-link font-mono text-xs uppercase tracking-widest", isActive('/timeline') && "nav-link-active"]}
            aria-current={isActive('/timeline') ? 'page' : undefined}
          >{t.nav.timeline}</a>
          <a
            href={url('/library')}
            class:list={["nav-link font-mono text-xs uppercase tracking-widest", pathname.startsWith(url('/library')) && "nav-link-active"]}
            aria-current={pathname.startsWith(url('/library')) ? 'page' : undefined}
          >{t.nav.library}</a>
          <a
            href={url('/about')}
            class:list={["nav-link font-mono text-xs uppercase tracking-widest", isActive('/about') && "nav-link-active"]}
            aria-current={isActive('/about') ? 'page' : undefined}
          >{t.nav.about}</a>
          <div class="flex items-center">
            <a
              href={url('/search')}
              class="nav-link font-mono text-xs uppercase tracking-widest flex items-center gap-1.5"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
              </svg>
              <span>{t.nav.search}</span>
            </a>
            <button
              @click="window.dispatchEvent(new CustomEvent('toggle-search'))"
              class="ml-2 px-2.5 py-1 text-[10px] font-mono bg-surface-light/50 rounded border border-accent/30 text-accent/70 shadow-[0_0_6px_rgba(34,211,238,0.15)] hover:border-accent/50 hover:text-accent hover:shadow-[0_0_12px_rgba(34,211,238,0.35)] transition-all"
              aria-label="Quick search (Cmd+K)"
            >⌘K</button>
          </div>
          
          <!-- Language Switcher -->
          <div class="border-l border-white/10 pl-4 ml-2">
            <LanguageSwitcher currentLocale={locale} />
          </div>
        </div>

        <!-- Mobile Menu Button -->
        <button
          @click="$store.nav.toggle()"
          type="button"
          class="md:hidden relative z-50 w-14 h-14 -mr-2 flex items-center justify-center text-text-muted hover:text-accent active:text-accent transition-colors rounded-lg active:bg-white/10"
          style="-webkit-tap-highlight-color: transparent; touch-action: manipulation;"
          :class="$store.nav.mobileMenuOpen && 'text-accent'"
          :aria-expanded="$store.nav.mobileMenuOpen"
          aria-label={t.common.toggleMenu}
        >
          <span class="sr-only" x-text="$store.nav.mobileMenuOpen ? 'Close menu' : 'Open menu'"></span>
          <div class="w-6 h-5 flex flex-col justify-between pointer-events-none">
            <span
              class="block h-0.5 bg-current rounded-full transition-all duration-300 origin-center"
              :class="$store.nav.mobileMenuOpen ? 'translate-y-[9px] rotate-45' : ''"
            ></span>
            <span
              class="block h-0.5 bg-current rounded-full transition-all duration-300"
              :class="$store.nav.mobileMenuOpen ? 'opacity-0 scale-x-0' : ''"
            ></span>
            <span
              class="block h-0.5 bg-current rounded-full transition-all duration-300 origin-center"
              :class="$store.nav.mobileMenuOpen ? '-translate-y-[9px] -rotate-45' : ''"
            ></span>
          </div>
        </button>
      </nav>
    </header>

    <!-- Mobile Navigation Menu - Separate from header for cleaner stacking -->
    <div
      x-data
      x-show="$store.nav.mobileMenuOpen"
      x-cloak
      x-transition:enter="transition ease-out duration-200"
      x-transition:enter-start="opacity-0"
      x-transition:enter-end="opacity-100"
      x-transition:leave="transition ease-in duration-150"
      x-transition:leave-start="opacity-100"
      x-transition:leave-end="opacity-0"
      class="md:hidden"
      style="position: fixed; top: 57px; left: 0; right: 0; bottom: 0; z-index: 9999; background-color: #0a0a0f; overflow-y: auto; -webkit-overflow-scrolling: touch;"
      @keydown.escape.window="$store.nav.close()"
    >
      <nav class="container-narrow py-6 flex flex-col gap-1">
        <a
          href={url('/artifacts')}
          @click="$store.nav.close()"
          class:list={["mobile-nav-link font-mono text-sm uppercase tracking-widest py-3", isActive('/artifacts') && "text-accent border-accent"]}
          aria-current={isActive('/artifacts') ? 'page' : undefined}
        >
          <span class="text-accent mr-2">></span> {t.nav.artifacts}
        </a>
        <a
          href={url('/coins')}
          @click="$store.nav.close()"
          class:list={["mobile-nav-link font-mono text-sm uppercase tracking-widest py-3", isActive('/coins') && "text-accent border-accent"]}
          aria-current={isActive('/coins') ? 'page' : undefined}
        >
          <span class="text-accent mr-2">></span> {t.nav.coins}
        </a>
        <a
          href={url('/timeline')}
          @click="$store.nav.close()"
          class:list={["mobile-nav-link font-mono text-sm uppercase tracking-widest py-3", isActive('/timeline') && "text-accent border-accent"]}
          aria-current={isActive('/timeline') ? 'page' : undefined}
        >
          <span class="text-accent mr-2">></span> {t.nav.timeline}
        </a>
        <div class="py-1">
          <a
            href={url('/library')}
            @click="$store.nav.close()"
            class:list={["mobile-nav-link font-mono text-sm uppercase tracking-widest py-3", pathname.startsWith(url('/library')) && "text-accent border-accent"]}
            aria-current={pathname.startsWith(url('/library')) ? 'page' : undefined}
          >
            <span class="text-accent mr-2">></span> {t.nav.library}
          </a>
          <div class="ml-6 flex flex-col gap-1 mt-1">
            <a
              href={url('/library/articles')}
              @click="$store.nav.close()"
              class:list={["font-mono text-xs uppercase tracking-widest py-2 text-text-muted hover:text-accent transition-colors", isActive('/library/articles') && "text-accent"]}
            >
              <span class="text-accent/50 mr-2">-</span> {t.nav.articles}
            </a>
            <a
              href={url('/library/books')}
              @click="$store.nav.close()"
              class:list={["font-mono text-xs uppercase tracking-widest py-2 text-text-muted hover:text-accent transition-colors", isActive('/library/books') && "text-accent"]}
            >
              <span class="text-accent/50 mr-2">-</span> {t.nav.books}
            </a>
          </div>
        </div>
        <a
          href={url('/about')}
          @click="$store.nav.close()"
          class:list={["mobile-nav-link font-mono text-sm uppercase tracking-widest py-3", isActive('/about') && "text-accent border-accent"]}
          aria-current={isActive('/about') ? 'page' : undefined}
        >
          <span class="text-accent mr-2">></span> {t.nav.about}
        </a>
        <a
          href={url('/search')}
          @click="$store.nav.close()"
          class:list={["mobile-nav-link font-mono text-sm uppercase tracking-widest py-3 flex items-center", isActive('/search') && "text-accent border-accent"]}
          aria-current={isActive('/search') ? 'page' : undefined}
        >
          <span class="text-accent mr-2">></span>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          {t.nav.search}
        </a>
        
        <!-- Mobile Language Switcher -->
        <div class="border-t border-white/10 mt-4 pt-4">
          <p class="font-mono text-xs text-text-dim mb-2 px-3">Language / Langue / Idioma / 语言</p>
          <div class="px-3">
            <LanguageSwitcher currentLocale={locale} />
          </div>
        </div>
      </nav>
    </div>

    <main id="main-content" class="flex-1 relative w-full max-w-full overflow-x-hidden">
      <div class="absolute inset-0 bg-gradient-to-b from-surface/30 to-transparent pointer-events-none" />
      <slot />
    </main>

    <footer class="border-t border-white/5">
      <div class="container-narrow py-10">
        <div class="grid md:grid-cols-2 gap-8 mb-8">
          <div>
            <p class="font-mono text-xs uppercase tracking-wider text-accent mb-2">{t.footer.stayUpdated}</p>
            <p class="text-text-dim text-sm mb-4">{t.footer.getNotified}</p>
            <NewsletterSignup variant="compact" />
          </div>
          <div class="flex flex-col md:items-end justify-center gap-2">
            <div class="flex items-center gap-4">
              <a href={url('/support')} class="font-mono text-xs text-text-dim hover:text-accent transition-colors">
                {t.footer.support}
              </a>
              <a href={url('/rss.xml')} class="font-mono text-xs text-text-dim hover:text-accent transition-colors flex items-center gap-1.5">
                <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M6.18 15.64a2.18 2.18 0 0 1 2.18 2.18C8.36 19 7.38 20 6.18 20C5 20 4 19 4 17.82a2.18 2.18 0 0 1 2.18-2.18M4 4.44A15.56 15.56 0 0 1 19.56 20h-2.83A12.73 12.73 0 0 0 4 7.27V4.44m0 5.66a9.9 9.9 0 0 1 9.9 9.9h-2.83A7.07 7.07 0 0 0 4 12.93V10.1Z"/>
                </svg>
                RSS
              </a>
            </div>
            <p class="font-mono text-xs text-text-dim">
              <span class="text-accent">></span> {t.footer.personalCollection}
            </p>
            <p class="font-mono text-xs text-text-dim">
              {t.footer.location}, {new Date().getFullYear()}
            </p>
          </div>
        </div>
      </div>
    </footer>

    <!-- Global Search Modal (⌘K) -->
    <SearchModal />

    <!-- Changelog Notification -->
    <ChangelogNotification />

    <!-- Latest Article Popup -->
    <LatestArticlePopup />

    <script>
      // Navigation progress bar for View Transitions
      document.addEventListener('astro:before-preparation', () => {
        const bar = document.getElementById('nav-progress');
        if (bar) {
          bar.style.opacity = '1';
          bar.style.width = '25%';
        }
      });

      document.addEventListener('astro:after-preparation', () => {
        const bar = document.getElementById('nav-progress');
        if (bar) {
          bar.style.width = '60%';
        }
      });

      document.addEventListener('astro:before-swap', () => {
        const bar = document.getElementById('nav-progress');
        if (bar) {
          bar.style.width = '85%';
        }
      });

      document.addEventListener('astro:page-load', () => {
        const bar = document.getElementById('nav-progress');
        if (bar) {
          bar.style.width = '100%';
          setTimeout(() => {
            bar.style.opacity = '0';
            setTimeout(() => {
              bar.style.width = '0%';
            }, 200);
          }, 150);
        }
      });
    </script>

    <script>
      import { initMatrixEffect } from '../scripts/matrix-effect';
      initMatrixEffect();
    </script>

    <script>
      // Update nav active state after View Transitions (header persists so we need client-side update)
      function updateNavActiveState() {
        const pathname = window.location.pathname;
        const base = import.meta.env.BASE_URL || '/';

        function url(path: string): string {
          return `${base}${path}`.replace(/\/+/g, '/');
        }

        function isActive(path: string): boolean {
          const fullPath = url(path);
          return pathname === fullPath || pathname === fullPath.replace(/\/$/, '') || pathname === fullPath + '/';
        }

        // Desktop nav links
        document.querySelectorAll('header nav a.nav-link').forEach((link) => {
          const href = link.getAttribute('href');
          if (!href) return;

          // Extract the path from href
          let path = href.replace(base, '/').replace(/\/+/g, '/');
          if (path !== '/' && path.endsWith('/')) path = path.slice(0, -1);

          // Special case for library (uses startsWith)
          const isLibrary = path === '/library' || path === url('/library');
          const shouldBeActive = isLibrary
            ? pathname.startsWith(url('/library'))
            : isActive(path);

          if (shouldBeActive) {
            link.classList.add('nav-link-active');
            link.setAttribute('aria-current', 'page');
          } else {
            link.classList.remove('nav-link-active');
            link.removeAttribute('aria-current');
          }
        });

        // Mobile nav links
        document.querySelectorAll('.mobile-nav-link').forEach((link) => {
          const href = link.getAttribute('href');
          if (!href) return;

          let path = href.replace(base, '/').replace(/\/+/g, '/');
          if (path !== '/' && path.endsWith('/')) path = path.slice(0, -1);

          const isLibrary = path === '/library' || path === url('/library');
          const shouldBeActive = isLibrary
            ? pathname.startsWith(url('/library'))
            : isActive(path);

          if (shouldBeActive) {
            link.classList.add('text-accent', 'border-accent');
            link.setAttribute('aria-current', 'page');
          } else {
            link.classList.remove('text-accent', 'border-accent');
            link.removeAttribute('aria-current');
          }
        });
      }

      // Run on initial load and after each View Transition
      document.addEventListener('astro:page-load', updateNavActiveState);
    </script>

    <script>
      // Scroll reveal animations with IntersectionObserver
      function initRevealObserver() {
        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        if (prefersReducedMotion) {
          document.querySelectorAll('.reveal').forEach(el => el.classList.add('revealed'));
          return;
        }

        const observer = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              entry.target.classList.add('revealed');
              observer.unobserve(entry.target);
            }
          });
        }, {
          threshold: 0.1,
          rootMargin: '50px'
        });

        document.querySelectorAll('.reveal').forEach(el => observer.observe(el));
      }

      initRevealObserver();
      document.addEventListener('astro:page-load', initRevealObserver);
    </script>

    <!-- Service Worker for aggressive caching -->
    <script>
      if ('serviceWorker' in navigator) {
        navigator.serviceWorker.register('/sw.js').catch(() => {});
      }
    </script>

    <!-- Counterscale Analytics -->
    <script
      id="counterscale-script"
      data-site-id="theantiquearchive"
      src="https://counterscale.alexcamill.workers.dev/tracker.js"
      defer
    ></script>

  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
