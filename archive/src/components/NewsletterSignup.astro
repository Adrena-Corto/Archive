---
interface Props {
  variant?: 'compact' | 'full';
  showOptions?: boolean;
}

const { variant = 'compact', showOptions = true } = Astro.props;

const BUTTONDOWN_USERNAME = 'TheAntiqueArchive';
---

{variant === 'compact' ? (
  <form
    action={`https://buttondown.com/api/emails/embed-subscribe/${BUTTONDOWN_USERNAME}`}
    method="post"
    target="_blank"
    x-data="{
      email: '',
      articles: true,
      items: true,
      getTags() {
        const tags = [];
        if (this.articles) tags.push('articles');
        if (this.items) tags.push('items');
        return tags.join(',');
      }
    }"
    class="flex flex-col gap-3"
  >
    <div class="flex flex-col sm:flex-row gap-2">
      <div class="relative flex-1">
        <input
          x-model="email"
          type="email"
          name="email"
          placeholder="your@email.com"
          required
          class="w-full bg-surface border border-border rounded px-3 py-2 font-mono text-xs text-text placeholder-text-dim focus:outline-none focus:border-accent/50 focus:ring-1 focus:ring-accent/30 transition-colors"
        />
      </div>
      <input type="hidden" name="embed" value="1" />
      <input type="hidden" name="tag" :value="getTags()" />
      <button
        type="submit"
        :disabled="!email || (!articles && !items)"
        class="shrink-0 px-4 py-2 bg-accent/10 border border-accent/30 rounded font-mono text-xs text-accent uppercase tracking-wider hover:bg-accent/20 hover:border-accent/50 transition-all disabled:opacity-50 disabled:cursor-not-allowed"
      >
        Subscribe
      </button>
    </div>

    {showOptions && (
      <div class="flex items-center gap-4">
        <label class="flex items-center gap-2 cursor-pointer group">
          <input
            type="checkbox"
            x-model="articles"
            class="w-3.5 h-3.5 rounded border-border bg-surface text-accent focus:ring-accent/30 focus:ring-offset-0 cursor-pointer"
          />
          <span class="font-mono text-micro text-text-dim group-hover:text-text-muted transition-colors">Articles</span>
        </label>
        <label class="flex items-center gap-2 cursor-pointer group">
          <input
            type="checkbox"
            x-model="items"
            class="w-3.5 h-3.5 rounded border-border bg-surface text-accent focus:ring-accent/30 focus:ring-offset-0 cursor-pointer"
          />
          <span class="font-mono text-micro text-text-dim group-hover:text-text-muted transition-colors">New Items</span>
        </label>
      </div>
    )}
  </form>
) : (
  <div class="glass-panel p-6">
    <div class="flex items-center gap-2 mb-2">
      <svg class="w-4 h-4 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
      </svg>
      <p class="font-mono text-xs uppercase tracking-wider text-accent">Stay Updated</p>
    </div>
    <p class="text-text-muted text-sm mb-4">Get notified when new articles are published or items are added to the collection.</p>

    <form
      action={`https://buttondown.com/api/emails/embed-subscribe/${BUTTONDOWN_USERNAME}`}
      method="post"
      target="_blank"
      x-data="{
        email: '',
        articles: true,
        items: true,
        getTags() {
          const tags = [];
          if (this.articles) tags.push('articles');
          if (this.items) tags.push('items');
          return tags.join(',');
        }
      }"
      class="space-y-4"
    >
      <div class="flex flex-col sm:flex-row gap-3">
        <input
          x-model="email"
          type="email"
          name="email"
          placeholder="your@email.com"
          required
          class="flex-1 bg-surface border border-border rounded-lg px-4 py-2.5 font-mono text-sm text-text placeholder-text-dim focus:outline-none focus:border-accent/50 focus:ring-1 focus:ring-accent/30 transition-colors"
        />
        <input type="hidden" name="embed" value="1" />
        <input type="hidden" name="tag" :value="getTags()" />
        <button
          type="submit"
          :disabled="!email || (!articles && !items)"
          class="shrink-0 px-5 py-2.5 bg-accent/10 border border-accent/30 rounded-lg font-mono text-sm text-accent uppercase tracking-wider hover:bg-accent/20 hover:border-accent/50 hover:shadow-glow-cyan transition-all disabled:opacity-50 disabled:cursor-not-allowed"
        >
          Subscribe
        </button>
      </div>

      <div class="flex items-center gap-6">
        <label class="flex items-center gap-2 cursor-pointer group">
          <input
            type="checkbox"
            x-model="articles"
            class="w-4 h-4 rounded border-border bg-surface text-accent focus:ring-accent/30 focus:ring-offset-0 cursor-pointer"
          />
          <span class="font-mono text-xs text-text-muted group-hover:text-text transition-colors">New Articles</span>
        </label>
        <label class="flex items-center gap-2 cursor-pointer group">
          <input
            type="checkbox"
            x-model="items"
            class="w-4 h-4 rounded border-border bg-surface text-accent focus:ring-accent/30 focus:ring-offset-0 cursor-pointer"
          />
          <span class="font-mono text-xs text-text-muted group-hover:text-text transition-colors">New Collection Items</span>
        </label>
      </div>
    </form>

    <p class="font-mono text-micro text-text-dim mt-4">No spam. Unsubscribe anytime.</p>
  </div>
)}
