---
import { LOCALE_LABELS, SUPPORTED_LOCALES, DEFAULT_LOCALE, getLocaleFromPath, getLocalePath } from '../lib/i18n';
import type { Locale } from '../lib/i18n';

interface Props {
  currentLocale: Locale;
  class?: string;
}

const { currentLocale, class: className = '' } = Astro.props;
const pathname = Astro.url.pathname;
const { pathWithoutLocale } = getLocaleFromPath(pathname);

// Determine if we're on an article page (where translations may not exist)
const isArticlePage = pathWithoutLocale.startsWith('/library/articles/') && 
  pathWithoutLocale.split('/').length > 3;

// Build locale switch URLs
const localeOptions = SUPPORTED_LOCALES.map(locale => {
  const href = locale === DEFAULT_LOCALE 
    ? pathWithoutLocale || '/'
    : getLocalePath(locale, pathWithoutLocale);
  
  return {
    locale,
    label: LOCALE_LABELS[locale],
    href,
    isActive: locale === currentLocale,
    // For articles, flag that translation may not exist
    hasTranslation: !isArticlePage || locale === DEFAULT_LOCALE,
  };
});
---

<div class={`relative ${className}`} x-data="{ open: false }" @keydown.escape.window="open = false">
  <button
    type="button"
    @click="open = !open"
    class="flex items-center gap-1.5 px-2 py-1 text-xs font-mono text-text-dim hover:text-accent transition-colors rounded border border-transparent hover:border-white/10"
    aria-expanded="false"
    :aria-expanded="open"
    aria-haspopup="listbox"
    aria-label="Select language"
  >
    <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129" />
    </svg>
    <span>{LOCALE_LABELS[currentLocale]}</span>
    <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 opacity-50" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
    </svg>
  </button>

  <!-- Dropdown -->
  <div
    x-show="open"
    x-cloak
    x-transition:enter="transition ease-out duration-100"
    x-transition:enter-start="opacity-0 scale-95"
    x-transition:enter-end="opacity-100 scale-100"
    x-transition:leave="transition ease-in duration-75"
    x-transition:leave-start="opacity-100 scale-100"
    x-transition:leave-end="opacity-0 scale-95"
    @click.outside="open = false"
    class="absolute right-0 top-full mt-1 w-32 bg-surface border border-white/10 rounded shadow-lg z-50 overflow-hidden"
    role="listbox"
    aria-label="Language options"
  >
    {localeOptions.map(option => (
      <a
        href={option.href}
        class:list={[
          "block px-3 py-2 text-xs font-mono transition-colors",
          option.isActive 
            ? "bg-accent/10 text-accent" 
            : "text-text-dim hover:text-text hover:bg-white/5",
          !option.hasTranslation && "opacity-50"
        ]}
        role="option"
        aria-selected={option.isActive}
        aria-disabled={!option.hasTranslation}
        title={!option.hasTranslation ? "Translation not yet available" : undefined}
      >
        {option.label}
        {option.isActive && (
          <svg xmlns="http://www.w3.org/2000/svg" class="inline-block h-3 w-3 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
          </svg>
        )}
        {!option.hasTranslation && (
          <span class="ml-1 text-[10px] text-text-dim/50" title="Translation not available">(*)</span>
        )}
      </a>
    ))}
  </div>
</div>

<style>
  [x-cloak] { display: none !important; }
</style>
