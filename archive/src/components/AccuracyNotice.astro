---
import type { Locale } from '../lib/i18n';
import { DEFAULT_LOCALE, getTranslations, getLocalePath } from '../lib/i18n';

interface Props {
  locale: Locale;
  slug?: string;
  title?: string;
  class?: string;
}

const { locale, slug, title, class: className = '' } = Astro.props;

// Only show on non-English pages
if (locale === DEFAULT_LOCALE) {
  return null;
}

const t = getTranslations(locale);
const currentUrl = Astro.url.href;

// Build report URL with query params
const reportPath = getLocalePath(locale, '/report');
const reportParams = new URLSearchParams();
reportParams.set('url', currentUrl);
reportParams.set('locale', locale);
if (slug) reportParams.set('slug', slug);
if (title) reportParams.set('title', title);

const reportUrl = `${reportPath}?${reportParams.toString()}`;
---

<aside class={`accuracy-notice ${className}`} role="note" aria-label={t.accuracyNotice.title}>
  <div class="accuracy-notice-content">
    <svg xmlns="http://www.w3.org/2000/svg" class="accuracy-notice-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
    </svg>
    <div class="accuracy-notice-text">
      <p>{t.accuracyNotice.message}</p>
      <a href={reportUrl} class="accuracy-notice-link">
        {t.accuracyNotice.reportIssue}
        <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 inline ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
      </a>
    </div>
  </div>
</aside>

<style>
  .accuracy-notice {
    background: linear-gradient(135deg, rgba(34, 211, 238, 0.05) 0%, rgba(34, 211, 238, 0.02) 100%);
    border: 1px solid rgba(34, 211, 238, 0.2);
    border-radius: 0.5rem;
    padding: 0.75rem 1rem;
    margin: 1rem 0;
  }
  
  .accuracy-notice-content {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
  }
  
  .accuracy-notice-icon {
    flex-shrink: 0;
    width: 1.25rem;
    height: 1.25rem;
    color: #22d3ee;
    margin-top: 0.125rem;
  }
  
  .accuracy-notice-text {
    flex: 1;
  }
  
  .accuracy-notice-text p {
    margin: 0;
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.7);
    line-height: 1.5;
  }
  
  .accuracy-notice-link {
    display: inline-flex;
    align-items: center;
    margin-top: 0.375rem;
    font-size: 0.8125rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    color: #22d3ee;
    text-decoration: none;
    transition: opacity 0.2s;
  }
  
  .accuracy-notice-link:hover {
    opacity: 0.8;
    text-decoration: underline;
  }
</style>
