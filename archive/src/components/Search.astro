---
import { getAllItems, getArtifactCategories, getItemById } from '../lib/items';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL || '/';
const items = getAllItems();
const articles = await getCollection('articles', ({ data }) => !data.draft);
const books = await getCollection('books');
const artifactCategories = getArtifactCategories();

const categoryLabels: Record<string, string> = {
  coin: 'Coins',
  jewelry: 'Jewelry',
  ring: 'Rings',
  seal: 'Seals',
  misc: 'Miscellaneous',
};

const typeLabels: Record<string, string> = {
  item: 'Item',
  article: 'Article',
  book: 'Book',
};

const popularTags = ['roman', 'greek', 'silver', 'gold', 'ancient'];
const recentItems = items.slice(0, 3);

function url(path: string): string {
  return `${base}${path}`.replace(/\/+/g, '/');
}

function getArticleImage(article: typeof articles[0]): string | null {
  if (article.data.image) {
    return url(article.data.image);
  }
  if (article.data.featuredItems && article.data.featuredItems.length > 0) {
    const firstItemId = article.data.featuredItems[0];
    const item = getItemById(firstItemId);
    if (item && item.images && item.images.length > 0) {
      return url(`/images/items/${item.id}/${item.images[0]}`);
    }
  }
  return null;
}

// Prepare unified search data
const searchableItems = items.map(item => ({
  id: item.id,
  name: item.name,
  type: 'item',
  category: item.category,
  subtitle: item.era,
  description: item.description,
  image: item.images[0] ? url(`/images/items/${item.id}/${item.images[0]}`) : null,
  url: url(`/item/${item.id}`),
  searchText: [item.name, item.description, item.category, item.material, item.origin, item.period, item.era, ...(item.tags || [])].join(' ').toLowerCase(),
  material: item.material,
  period: item.period,
}));

const searchableArticles = articles.map(article => ({
  id: article.id,
  name: article.data.title,
  type: 'article',
  category: 'article',
  subtitle: article.data.description.slice(0, 80) + '...',
  description: article.data.description,
  image: getArticleImage(article),
  url: url(`/library/articles/${article.id}`),
  searchText: [article.data.title, article.data.description, ...(article.data.tags || [])].join(' ').toLowerCase(),
  material: null,
  period: null,
}));

const searchableBooks = books.map(book => ({
  id: book.id,
  name: book.data.title,
  type: 'book',
  category: 'book',
  subtitle: book.data.author,
  description: book.data.description,
  image: book.data.cover ? url(`/images/books/${book.data.cover}`) : null,
  url: url(`/library/books/${book.id}`),
  searchText: [book.data.title, book.data.author, book.data.description, ...(book.data.tags || [])].join(' ').toLowerCase(),
  material: null,
  period: null,
}));

const allSearchable = [...searchableItems, ...searchableArticles, ...searchableBooks];
const searchData = JSON.stringify(allSearchable);
---

<div id="search-wrapper" class="search-wrapper" data-base-url={base} data-items={searchData}>
  <!-- Custom search input -->
  <div class="search-input-container">
    <div class="search-input-wrapper">
      <svg class="search-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
      </svg>
      <input
        type="text"
        id="search-input"
        class="search-input"
        placeholder="Search items, articles, books..."
        autocomplete="off"
      />
      <button id="search-clear" class="search-clear" style="display: none;">
        × Clear
      </button>
    </div>
  </div>

  <!-- Type filters (persists during search, so visually distinct) -->
  <div class="type-filters">
    <span class="filter-label">// Search in</span>
    <div class="flex flex-wrap gap-2">
      <button class="type-toggle active" data-type="item">
        <span class="toggle-indicator"></span>
        Items
      </button>
      <button class="type-toggle active" data-type="article">
        <span class="toggle-indicator"></span>
        Articles
      </button>
      <button class="type-toggle active" data-type="book">
        <span class="toggle-indicator"></span>
        Books
      </button>
    </div>
  </div>

  <!-- Search status -->
  <div id="search-status" class="search-status" style="display: none;">
    <span class="text-accent">//</span> <span id="search-count">0</span> results for "<span id="search-term"></span>"
  </div>

  <!-- Search results grid -->
  <div id="search-results" class="search-results" style="display: none;">
    <div id="results-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
      <!-- Results rendered by JS -->
    </div>
  </div>

  <!-- Search suggestions (shown when search is empty) -->
  <div id="search-suggestions" class="mt-8 space-y-8">
    <!-- Browse collections -->
    <div>
      <h3 class="font-mono text-xs uppercase tracking-wider text-accent mb-4">// Browse Collections</h3>
      <div class="flex flex-wrap gap-2">
        <button class="browse-btn" data-category="coin">
          {categoryLabels['coin']}
        </button>
        {artifactCategories.map((cat) => (
          <button class="browse-btn" data-category={cat}>
            {categoryLabels[cat]}
          </button>
        ))}
      </div>
    </div>

    <!-- Popular searches -->
    <div>
      <h3 class="font-mono text-xs uppercase tracking-wider text-accent mb-4">// Popular Searches</h3>
      <div class="flex flex-wrap gap-2">
        {popularTags.map((tag) => (
          <button class="search-tag-btn" data-search-term={tag}>
            {tag}
          </button>
        ))}
      </div>
    </div>

    <!-- Recent items -->
    <div>
      <h3 class="font-mono text-xs uppercase tracking-wider text-accent mb-4">// Recent Items</h3>
      <div class="grid sm:grid-cols-3 gap-4">
        {recentItems.map((item) => (
          <a
            href={url(`/item/${item.id}`)}
            class="glass-panel p-4 hover:border-accent/50 transition-all duration-200 group"
          >
            <span class="font-mono text-[10px] uppercase tracking-wider text-accent">
              {categoryLabels[item.category]}
            </span>
            <p class="text-text group-hover:text-accent transition-colors mt-1">
              {item.name}
            </p>
            <p class="data-label mt-1">{item.era}</p>
          </a>
        ))}
      </div>
    </div>
  </div>
</div>

<script>
  interface SearchableItem {
    id: string;
    name: string;
    type: 'item' | 'article' | 'book';
    category: string;
    subtitle: string;
    description: string;
    image: string | null;
    url: string;
    searchText: string;
    material: string | null;
    period: string | null;
  }

  const typeLabels: Record<string, string> = {
    item: 'ITEM',
    article: 'ARTICLE',
    book: 'BOOK',
  };

  const typeColors: Record<string, string> = {
    item: 'text-cyan-400',
    article: 'text-violet-400',
    book: 'text-amber-400',
  };

  const categoryLabels: Record<string, string> = {
    coin: 'COIN',
    jewelry: 'JEWELRY',
    ring: 'RING',
    seal: 'SEAL',
    misc: 'MISC',
  };

  function initSearch() {
    const wrapper = document.getElementById('search-wrapper');
    const searchInput = document.getElementById('search-input') as HTMLInputElement;
    const clearBtn = document.getElementById('search-clear');
    const searchStatus = document.getElementById('search-status');
    const searchCount = document.getElementById('search-count');
    const searchTermEl = document.getElementById('search-term');
    const searchResults = document.getElementById('search-results');
    const resultsGrid = document.getElementById('results-grid');
    const suggestions = document.getElementById('search-suggestions');

    if (!wrapper || !searchInput) return;

    const allItems: SearchableItem[] = JSON.parse(wrapper.dataset.items || '[]');

    // Type filter state
    const activeTypes = new Set<string>(['item', 'article', 'book']);

    function getArticleMinimap(): string {
      return `
        <div class="article-minimap-preview">
          <div class="minimap-line heading" style="width: 60%"></div>
          <div class="minimap-line" style="width: 100%"></div>
          <div class="minimap-line" style="width: 90%"></div>
          <div class="minimap-line" style="width: 100%"></div>
          <div class="minimap-line heading" style="width: 50%; margin-top: 6px"></div>
          <div class="minimap-line" style="width: 100%"></div>
          <div class="minimap-line" style="width: 85%"></div>
          <div class="minimap-line" style="width: 100%"></div>
          <div class="minimap-line" style="width: 75%"></div>
          <div class="minimap-line heading" style="width: 55%; margin-top: 6px"></div>
          <div class="minimap-line" style="width: 100%"></div>
          <div class="minimap-line" style="width: 92%"></div>
        </div>
      `;
    }

    function getBookIcon(): string {
      return `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
      </svg>`;
    }

    function getItemIcon(): string {
      return `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
      </svg>`;
    }

    // Cache for rendered card elements (avoid re-rendering and image reloading)
    const cardCache = new Map<string, HTMLElement>();

    function renderResultCard(item: SearchableItem): string {
      const typeColor = typeColors[item.type] || 'text-accent';
      const typeLabel = item.type === 'item'
        ? (categoryLabels[item.category] || item.category.toUpperCase())
        : typeLabels[item.type];

      return `
        <a href="${item.url}" class="search-result-card group block glass-panel-solid overflow-hidden card-hover" data-item-id="${item.id}" data-item-type="${item.type}">
          <div class="aspect-[4/3] bg-surface-light overflow-hidden relative">
            ${item.type === 'article' && item.image ? `
              <div class="relative w-full h-full article-card-preview">
                <div class="search-img-skeleton absolute inset-0 skeleton-pulse"></div>
                <img
                  src="${item.image}"
                  alt="${item.name}"
                  width="400"
                  height="300"
                  class="search-img absolute inset-0 w-full h-full object-cover brightness-90 group-hover:brightness-100 transition-all duration-300"
                  loading="lazy"
                  onload="this.style.opacity='1'; this.previousElementSibling.style.opacity='0';"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-violet-950/80 via-violet-950/20 to-transparent"></div>
              </div>
            ` : item.image ? `
              <div class="relative w-full h-full search-img-wrapper">
                <div class="search-img-skeleton absolute inset-0 skeleton-pulse"></div>
                <img
                  src="${item.image}"
                  alt="${item.name}"
                  width="400"
                  height="300"
                  class="search-img absolute inset-0 w-full h-full object-cover brightness-90 group-hover:brightness-110 transition-all duration-300"
                  loading="lazy"
                  onload="this.style.opacity='0.9'; this.previousElementSibling.style.opacity='0';"
                />
              </div>
            ` : item.type === 'article' ? `
              <div class="w-full h-full flex items-center justify-center bg-surface/50 p-6">
                ${getArticleMinimap()}
              </div>
            ` : `
              <div class="w-full h-full flex flex-col items-center justify-center gap-2 bg-surface ${typeColor}">
                ${item.type === 'book' ? getBookIcon() : getItemIcon()}
                <span class="font-mono text-[10px] uppercase tracking-wider opacity-60">${typeLabels[item.type]}</span>
              </div>
            `}
            <div class="absolute inset-0 bg-gradient-to-t from-surface/80 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none"></div>
          </div>
          <div class="p-4 space-y-3">
            <div class="flex items-center gap-2">
              <span class="font-mono text-[10px] uppercase tracking-wider ${typeColor}">
                ${typeLabel}
              </span>
              ${item.period ? `
                <span class="text-text-dim">·</span>
                <span class="font-mono text-[10px] uppercase tracking-wider text-text-dim">
                  ${item.period}
                </span>
              ` : ''}
            </div>
            <div class="border-t border-border pt-3">
              <h3 class="text-lg text-text leading-tight group-hover:text-accent transition-colors duration-300 line-clamp-2 min-h-[2.5rem]">
                ${item.name}
              </h3>
            </div>
            <p class="text-sm text-text-dim line-clamp-2">${item.subtitle}</p>
          </div>
        </a>
      `;
    }

    function getOrCreateCard(item: SearchableItem): HTMLElement {
      if (cardCache.has(item.id)) {
        return cardCache.get(item.id)!;
      }
      const template = document.createElement('template');
      template.innerHTML = renderResultCard(item).trim();
      const card = template.content.firstChild as HTMLElement;
      cardCache.set(item.id, card);
      return card;
    }

    function searchItems(query: string): SearchableItem[] {
      if (!query.trim()) return [];
      const q = query.toLowerCase();
      return allItems
        .filter(item => activeTypes.has(item.type))
        .filter(item => item.searchText.includes(q) || item.name.toLowerCase().includes(q));
    }

    function filterByCategory(category: string): SearchableItem[] {
      return allItems
        .filter(item => activeTypes.has(item.type))
        .filter(item => item.category === category);
    }

    // Track currently displayed result IDs to avoid unnecessary DOM manipulation
    let currentResultIds = new Set<string>();

    function showResults(results: SearchableItem[], query: string, isCategory = false) {
      if (resultsGrid) {
        const newResultIds = new Set(results.map(r => r.id));

        // Check if results are exactly the same (same items in same order)
        const currentIds = Array.from(resultsGrid.querySelectorAll('.search-result-card'))
          .map(el => (el as HTMLElement).dataset.itemId);
        const newIds = results.map(r => r.id);
        const isSameOrder = currentIds.length === newIds.length &&
          currentIds.every((id, i) => id === newIds[i]);

        if (!isSameOrder) {
          // Rebuild grid - but reuse cached card elements (preserves loaded images)
          resultsGrid.innerHTML = '';
          results.forEach(item => {
            const card = getOrCreateCard(item);
            resultsGrid.appendChild(card);
          });
          currentResultIds = newResultIds;
        }
      }

      if (searchStatus && searchCount && searchTermEl) {
        searchCount.textContent = results.length.toString();
        searchTermEl.textContent = query;
        searchStatus.style.display = results.length > 0 || query ? 'block' : 'none';
      }

      if (searchResults) {
        searchResults.style.display = results.length > 0 ? 'block' : 'none';
      }

      if (suggestions) {
        suggestions.style.display = results.length > 0 || query ? 'none' : 'block';
      }

      if (clearBtn) {
        clearBtn.style.display = query ? 'block' : 'none';
      }
    }

    // Track current search state
    let currentCategory: string | null = null;
    let lastSearchQuery: string | null = null;

    function handleSearch() {
      const query = searchInput.value.trim();

      // If query changed, clear the card cache
      if (query !== lastSearchQuery) {
        cardCache.clear();
        currentResultIds.clear();
        lastSearchQuery = query;
      }

      // Check if this is a category filter
      if (query.startsWith('category:')) {
        const category = query.replace('category:', '');
        currentCategory = category;
        const results = filterByCategory(category);
        const label = categoryLabels[category.toUpperCase()] || category;
        showResults(results, label, true);
        return;
      }

      currentCategory = null;

      if (!query) {
        showResults([], '');
        return;
      }
      const results = searchItems(query);
      showResults(results, query);
    }

    // Search input handler
    let debounceTimer: number;
    searchInput.addEventListener('input', () => {
      clearTimeout(debounceTimer);
      debounceTimer = window.setTimeout(handleSearch, 150);
    });

    // Clear button handler
    if (clearBtn) {
      clearBtn.addEventListener('click', () => {
        searchInput.value = '';
        showResults([], '');
        searchInput.focus();
      });
    }

    // Browse category buttons
    document.querySelectorAll('.browse-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const category = (btn as HTMLElement).dataset.category;
        if (category) {
          const results = filterByCategory(category);
          const label = categoryLabels[category.toUpperCase()] || category;
          searchInput.value = `category:${category}`;
          showResults(results, label, true);
        }
      });
    });

    // Popular search tag buttons
    document.querySelectorAll('.search-tag-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const term = (btn as HTMLElement).dataset.searchTerm;
        if (term) {
          searchInput.value = term;
          handleSearch();
        }
      });
    });

    // Type toggle buttons
    document.querySelectorAll('.type-toggle').forEach(btn => {
      btn.addEventListener('click', () => {
        const type = (btn as HTMLElement).dataset.type;
        if (!type) return;

        if (activeTypes.has(type)) {
          // Don't allow disabling all types
          if (activeTypes.size > 1) {
            activeTypes.delete(type);
            btn.classList.remove('active');
          }
        } else {
          activeTypes.add(type);
          btn.classList.add('active');
        }

        // Re-run search with new filters
        handleSearch();
      });
    });

    // Auto-focus the search input
    searchInput.focus();
  }

  // Initialize on page load and after View Transitions
  document.addEventListener('astro:page-load', initSearch);
  if (document.readyState === 'complete') {
    initSearch();
  }
</script>

<style>
  .search-input-container {
    position: relative;
  }

  .search-input-wrapper {
    position: relative;
    display: flex;
    align-items: center;
  }

  .search-icon {
    position: absolute;
    left: 16px;
    top: 50%;
    transform: translateY(-50%);
    width: 18px;
    height: 18px;
    color: #22d3ee;
    opacity: 0.8;
    pointer-events: none;
    z-index: 10;
  }

  .search-input {
    width: 100%;
    font-size: 15px;
    font-family: 'JetBrains Mono', monospace;
    padding: 16px 120px 16px 48px;
    background: rgba(18, 18, 26, 0.9);
    backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 12px;
    color: #e4e4e7;
    transition: all 0.3s ease;
  }

  .search-input::placeholder {
    color: #52525b;
    font-family: 'JetBrains Mono', monospace;
  }

  .search-input:focus {
    border-color: rgba(34, 211, 238, 0.5);
    box-shadow: 0 0 0 1px rgba(34, 211, 238, 0.1), 0 0 30px rgba(34, 211, 238, 0.15);
    outline: none;
    background: rgba(18, 18, 26, 0.95);
  }

  .search-clear {
    position: absolute !important;
    right: 12px !important;
    top: 50% !important;
    transform: translateY(-50%) !important;
    padding: 8px 16px;
    background: rgba(34, 211, 238, 0.1);
    border: 1px solid rgba(34, 211, 238, 0.3);
    border-radius: 8px;
    color: #22d3ee;
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    cursor: pointer;
    transition: background 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
    z-index: 10;
  }

  .search-clear:hover {
    background: rgba(34, 211, 238, 0.2);
    border-color: rgba(34, 211, 238, 0.5);
    box-shadow: 0 0 15px rgba(34, 211, 238, 0.2);
  }

  .search-status {
    font-family: 'JetBrains Mono', monospace;
    font-size: 13px;
    color: #6b6b7b;
    padding: 16px 4px;
    text-align: center;
  }

  .search-results {
    margin-top: 8px;
  }

  /* Article minimap preview (fallback when no image) */
  .article-minimap-preview {
    width: 100%;
    max-width: 120px;
    padding: 12px;
    background: rgba(15, 15, 20, 0.8);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 6px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .minimap-line {
    height: 3px;
    background: rgba(255, 255, 255, 0.15);
    border-radius: 1px;
  }

  .minimap-line.heading {
    height: 4px;
    background: rgba(167, 139, 250, 0.5);
  }

  .group:hover .article-minimap-preview {
    border-color: rgba(167, 139, 250, 0.3);
  }

  .group:hover .minimap-line.heading {
    background: rgba(167, 139, 250, 0.7);
  }

  /* Article corner badge */
  .article-corner-badge {
    display: inline-block;
    padding: 4px 10px;
    background: rgba(167, 139, 250, 0.9);
    color: white;
    font-family: 'JetBrains Mono', monospace;
    font-size: 9px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    border-radius: 4px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
    transition: all 0.3s ease;
  }

  .group:hover .article-corner-badge {
    background: rgba(167, 139, 250, 1);
    box-shadow: 0 2px 12px rgba(167, 139, 250, 0.5);
  }

  /* Type filters panel - persists during search */
  .type-filters {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-top: 16px;
    padding: 12px 16px;
    background: rgba(18, 18, 26, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 10px;
  }

  .filter-label {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #22d3ee;
    white-space: nowrap;
  }

  /* Unified chip button base */
  .chip-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 14px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 8px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    color: #71717a;
    cursor: pointer;
    transition: all 0.25s ease;
  }

  .chip-btn:hover {
    background: rgba(34, 211, 238, 0.08);
    border-color: rgba(34, 211, 238, 0.3);
    color: #22d3ee;
  }

  .chip-btn:active {
    transform: scale(0.98);
  }

  /* Type toggles - extend chip-btn with colored indicators */
  .type-toggle {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 14px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
