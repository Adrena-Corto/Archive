---
const COUNTERSCALE_DASHBOARD = 'https://counterscale.alexcamill.workers.dev';
---

<div class="glass-panel p-6 md:p-8" id="site-metrics">
  <h2 class="font-mono text-xs uppercase tracking-wider text-accent mb-4">// Site Analytics</h2>

  <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
    <div>
      <p class="text-text-muted text-sm mb-2">
        Track visitor activity, page views, and traffic sources.
      </p>
      <div class="flex items-center gap-2 text-xs text-text-dim font-mono">
        <span class="inline-block w-2 h-2 rounded-full bg-green-500 animate-pulse"></span>
        Live tracking enabled
      </div>
    </div>

    <a
      href={COUNTERSCALE_DASHBOARD}
      target="_blank"
      rel="noopener noreferrer"
      class="group inline-flex items-center gap-2 px-4 py-2.5 bg-accent/10 hover:bg-accent/20 border border-accent/30 hover:border-accent/50 rounded-lg transition-all duration-200"
    >
      <svg class="w-4 h-4 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
      </svg>
      <span class="font-mono text-sm text-accent group-hover:text-cyan-300 transition-colors">
        View Dashboard
      </span>
      <svg class="w-3 h-3 text-accent/50 group-hover:text-accent group-hover:translate-x-0.5 transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
      </svg>
    </a>
  </div>
</div>
