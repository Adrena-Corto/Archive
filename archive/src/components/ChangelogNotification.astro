---
import changelog from '../data/changelog.json';

const latest = changelog.entries[0];
const currentVersion = changelog.currentVersion;
---

<div
  id="changelog-notification"
  class="fixed bottom-4 left-4 right-4 sm:left-6 sm:bottom-6 z-50 sm:max-w-sm opacity-0 translate-y-4 pointer-events-none transition-all duration-500 ease-out"
  style="--popup-right: auto;"
  data-version={currentVersion}
>
  <div class="glass-panel-solid border border-white/10 rounded-xl overflow-hidden shadow-2xl shadow-black/50">
    <div class="flex items-center justify-between px-4 py-3 border-b border-white/5 bg-white/[0.02]">
      <div class="flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-accent animate-pulse"></span>
        <span class="font-mono text-micro uppercase tracking-wider text-accent">v{currentVersion}</span>
      </div>
      <button
        id="changelog-dismiss"
        class="p-1 rounded-md hover:bg-white/5 transition-colors group"
        aria-label="Dismiss"
      >
        <svg class="w-4 h-4 text-text-dim group-hover:text-text transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <div class="p-4">
      <h3 class="text-base text-text mb-3">{latest.title}</h3>
      <ul class="space-y-1.5 mb-4">
        {latest.changes.map(change => (
          <li class="flex items-start gap-2 text-sm text-text-muted">
            <span class="text-accent mt-0.5">›</span>
            <span>{change}</span>
          </li>
        ))}
      </ul>
      <div class="flex items-center justify-between pt-3 border-t border-white/5">
        <a href="/about#changelog" class="font-mono text-micro uppercase tracking-wider text-text-dim hover:text-accent transition-colors">
          View all updates
        </a>
        <button
          id="changelog-never-show"
          class="font-mono text-micro uppercase tracking-wider text-text-dim hover:text-text transition-colors"
        >
          Don't show again
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  function initChangelogNotification() {
    const popup = document.getElementById('changelog-notification');
    const dismissBtn = document.getElementById('changelog-dismiss');
    const neverShowBtn = document.getElementById('changelog-never-show');

    if (!popup || !dismissBtn || !neverShowBtn) return;

    const version = popup.dataset.version;
    const lastSeenKey = 'changelog-last-seen';
    const neverShowKey = 'changelog-never-show';

    const lastSeen = localStorage.getItem(lastSeenKey);
    const neverShow = localStorage.getItem(neverShowKey);

    if (neverShow === 'true') return;
    if (lastSeen === version) return;

    const adjustPosition = () => {
      const articlePopup = document.getElementById('latest-article-popup');
      const rect = popup.getBoundingClientRect();
      const viewportWidth = window.innerWidth;

      // Check if popup would go off right edge (on narrow screens)
      if (rect.right > viewportWidth - 16) {
        popup.style.right = '1rem';
        popup.style.left = 'auto';
      }

      // Check if article popup is visible and would overlap
      if (articlePopup && !articlePopup.classList.contains('opacity-0')) {
        const articleRect = articlePopup.getBoundingClientRect();
        if (rect.right > articleRect.left - 16) {
          // Stack above the article popup
          popup.style.bottom = `${window.innerHeight - articleRect.top + 16}px`;
        }
      }
    };

    setTimeout(() => {
      popup.classList.remove('opacity-0', 'translate-y-4', 'pointer-events-none');
      popup.classList.add('opacity-100', 'translate-y-0', 'pointer-events-auto');
      requestAnimationFrame(adjustPosition);
    }, 2500);

    window.addEventListener('resize', adjustPosition);

    const dismiss = (permanently = false) => {
      popup.classList.remove('opacity-100', 'translate-y-0', 'pointer-events-auto');
      popup.classList.add('opacity-0', 'translate-y-4', 'pointer-events-none');
      localStorage.setItem(lastSeenKey, version || '');
      window.removeEventListener('resize', adjustPosition);
      if (permanently) {
        localStorage.setItem(neverShowKey, 'true');
      }
    };

    dismissBtn.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      dismiss(false);
    });

    neverShowBtn.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      dismiss(true);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initChangelogNotification);
  } else {
    initChangelogNotification();
  }

  document.addEventListener('astro:page-load', initChangelogNotification);
</script>
