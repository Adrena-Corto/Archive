---
import thumbhashManifest from '../data/thumbhash-manifest.json';

interface Props {
  src: string;
  alt: string;
  width?: number;
  height?: number;
  class?: string;
  loading?: 'lazy' | 'eager';
  priority?: boolean;
  sizes?: string;
}

const { src, alt, width, height, class: className = '', loading = 'lazy', priority = false, sizes = '(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw' } = Astro.props;

const thumbhash = (thumbhashManifest as Record<string, string>)[src] || null;

// Generate WebP srcset for optimized images
function getOptimizedSrc(originalSrc: string) {
  const ext = originalSrc.match(/\.(jpg|jpeg|png)$/i)?.[0] || '';
  const basePath = originalSrc.replace(/\.(jpg|jpeg|png)$/i, '');

  return {
    thumb: `${basePath}-thumb.webp`,
    medium: `${basePath}-medium.webp`,
    original: originalSrc,
  };
}

const optimized = getOptimizedSrc(src);
const srcset = `${optimized.thumb} 400w, ${optimized.medium} 800w`;
---

<div class="blur-image-container relative w-full h-full overflow-hidden">
  {thumbhash && (
    <canvas
      class="blur-image-placeholder absolute inset-0 w-full h-full object-cover"
      data-thumbhash={thumbhash}
      aria-hidden="true"
    />
  )}
  <picture>
    <source
      type="image/webp"
      srcset={srcset}
      sizes={sizes}
    />
    <img
      src={optimized.original}
      alt={alt}
      width={width}
      height={height}
      class:list={[
        'blur-image w-full h-full object-cover',
        'opacity-0 transition-opacity duration-500',
        className
      ]}
      loading={priority ? 'eager' : loading}
      decoding={priority ? 'sync' : 'async'}
      fetchpriority={priority ? 'high' : undefined}
    />
  </picture>
</div>

<script>
  import { thumbHashToDataURL } from 'thumbhash';

  function base64ToBytes(base64: string): Uint8Array {
    const binary = atob(base64);
    const bytes = new Uint8Array(binary.length);
    for (let i = 0; i < binary.length; i++) {
      bytes[i] = binary.charCodeAt(i);
    }
    return bytes;
  }

  function processContainer(container: Element) {
    const canvas = container.querySelector<HTMLCanvasElement>('.blur-image-placeholder');
    const img = container.querySelector<HTMLImageElement>('.blur-image');

    if (!canvas || !img) return;

    const thumbhash = canvas.dataset.thumbhash;
    if (thumbhash) {
      try {
        const hash = base64ToBytes(thumbhash);
        const dataUrl = thumbHashToDataURL(hash);

        const placeholderImg = new Image();
        placeholderImg.onload = () => {
          const ctx = canvas.getContext('2d');
          if (ctx) {
            canvas.width = canvas.offsetWidth;
            canvas.height = canvas.offsetHeight;
            ctx.drawImage(placeholderImg, 0, 0, canvas.width, canvas.height);
          }
        };
        placeholderImg.src = dataUrl;
      } catch (e) {
        // Silently fail - image will load without placeholder
      }
    }

    if (img.complete && img.naturalWidth > 0) {
      img.classList.remove('opacity-0');
      img.classList.add('opacity-100');
      canvas?.classList.add('opacity-0');
    } else {
      img.addEventListener('load', () => {
        img.classList.remove('opacity-0');
        img.classList.add('opacity-100');
        canvas?.classList.add('opacity-0', 'transition-opacity', 'duration-500');
      }, { once: true });
    }
  }

  function initBlurImages() {
    const containers = document.querySelectorAll('.blur-image-container');
    if (containers.length === 0) return;

    // Batch process with requestIdleCallback to avoid blocking main thread
    if ('requestIdleCallback' in window) {
      const containerArray = Array.from(containers);
      let index = 0;
      const batchSize = 4;

      const processBatch = (deadline: IdleDeadline) => {
        while (index < containerArray.length && deadline.timeRemaining() > 0) {
          const end = Math.min(index + batchSize, containerArray.length);
          for (let i = index; i < end; i++) {
            processContainer(containerArray[i]);
          }
          index = end;
        }

        if (index < containerArray.length) {
          (window as any).requestIdleCallback(processBatch, { timeout: 3000 });
        }
      };

      (window as any).requestIdleCallback(processBatch, { timeout: 3000 });
    } else {
      // Fallback: process in batches with setTimeout
      const containerArray = Array.from(containers);
      const batchSize = 4;

      for (let i = 0; i < containerArray.length; i += batchSize) {
        const batch = containerArray.slice(i, i + batchSize);
        setTimeout(() => {
          batch.forEach(processContainer);
        }, Math.floor(i / batchSize) * 50);
      }
    }
  }

  // Run on initial load
  initBlurImages();

  // Run on Astro page transitions
  document.addEventListener('astro:page-load', initBlurImages);
</script>

<style>
  .blur-image-placeholder {
    filter: blur(20px);
    transform: scale(1.1);
  }
</style>
