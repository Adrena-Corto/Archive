---
interface Props {
  itemId: string;
  images: string[];
  caption?: string;
}

const { itemId, images, caption } = Astro.props;
const base = import.meta.env.BASE_URL;

function url(path: string): string {
  return `${base}${path}`.replace(/\/+/g, '/');
}

const itemUrl = url(`/items/${itemId}`);
const imagePaths = images.map(img => url(`/images/items/${itemId}/${img}`));
const isSingleImage = images.length === 1;
---

<figure class="my-8 glass-panel-solid overflow-hidden">
  <a href={itemUrl} class="block group">
    <div class={`${isSingleImage ? '' : 'grid grid-cols-2'} gap-0.5 bg-border`}>
      {imagePaths.map((src, i) => (
        <div class="bg-surface-light overflow-hidden">
          <img
            src={src}
            alt={`Collection item ${itemId} - image ${i + 1}`}
            class="w-full aspect-[4/3] object-cover brightness-90 group-hover:brightness-110 transition-[filter] duration-300"
            loading="lazy"
          />
        </div>
      ))}
    </div>
  </a>

  <div class="p-4 border-t border-border">
    <div class="flex items-center gap-2 mb-2">
      <span class="font-mono text-[10px] uppercase tracking-wider text-accent">From the Collection</span>
    </div>
    {caption && (
      <p class="text-sm text-text-muted leading-relaxed">{caption}</p>
    )}
    <a
      href={itemUrl}
      class="inline-flex items-center gap-1 mt-3 text-sm text-text-muted hover:text-accent transition-colors duration-200"
    >
      View full item details
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
      </svg>
    </a>
  </div>
</figure>
