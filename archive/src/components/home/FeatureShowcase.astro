---
import { getAllItems } from '../../lib/items';
import { getCollection } from 'astro:content';
import { getTimelineItems } from '../../lib/timeline';

const allItems = getAllItems();
const previewItems = allItems.slice(0, Math.min(10, allItems.length));

const articles = (await getCollection('articles'))
  .filter(article => !article.data.draft)
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 4);

const books = await getCollection('books');
const recentBooks = books.slice(0, 6);

const timelineItems = getTimelineItems().slice(0, 20);

const base = import.meta.env.BASE_URL;
function url(path: string): string {
  return `${base}${path}`.replace(/\/+/g, '/');
}

const itemsJson = JSON.stringify(previewItems.map(item => ({
  id: item.id,
  name: item.name,
  image: item.images[0] ? url(`/images/items/${item.id}/${item.images[0]}`) : null,
  category: item.category,
  era: item.era,
})));
---

<section class="py-12 md:py-16">
  <div class="container-narrow">
    <div class="text-center mb-8 md:mb-10">
      <p class="font-mono text-xs uppercase tracking-[0.2em] text-accent mb-3">
        // Explore the Archive
      </p>
      <h2 class="text-3xl md:text-4xl text-text mb-4">Discover & Research</h2>
      <p class="text-text-muted max-w-xl mx-auto">
        Browse the collection, explore through time, and dive into reference materials.
      </p>
    </div>

    <!-- Bento Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-5 gap-4 md:gap-6">

      <!-- Collection Preview (Large - 3 cols) -->
      <a
        href={url('/collection')}
        class="lg:col-span-3 group relative glass-panel overflow-hidden min-h-[320px] md:min-h-[400px] hover:border-accent/30 transition-all duration-500"
      >
        <div class="absolute inset-0 bg-gradient-to-br from-accent/5 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>

        <!-- Film Strip / Pellicule -->
        <div
          id="collection-filmstrip"
          class="absolute inset-0 overflow-hidden opacity-50 group-hover:opacity-75 transition-opacity duration-500"
        >
          <!-- Duplicate items for seamless loop -->
          <div class="filmstrip-track flex h-full items-center gap-2 pl-2">
            {[...previewItems, ...previewItems].map((item, i) => (
              <div
                class="filmstrip-frame flex-shrink-0 h-[85%] aspect-square rounded-md overflow-hidden border border-white/10"
              >
                {item.images[0] && (
                  <img
                    src={url(`/images/items/${item.id}/${item.images[0]}`)}
                    alt=""
                    class="w-full h-full object-cover"
                    loading="lazy"
                  />
                )}
              </div>
            ))}
          </div>
        </div>

        <!-- Overlay Content -->
        <div class="absolute inset-0 flex flex-col justify-end p-6 md:p-8 bg-gradient-to-t from-void/95 via-void/60 to-transparent">
          <div class="flex items-center gap-3 mb-3">
            <div class="w-10 h-10 rounded-lg bg-accent/20 flex items-center justify-center">
              <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
              </svg>
            </div>
            <div>
              <p class="font-mono text-xs uppercase tracking-wider text-accent">Collection</p>
              <p class="font-mono text-[10px] text-text-dim">{allItems.length} items catalogued</p>
            </div>
          </div>
          <h3 class="text-2xl md:text-3xl text-text mb-2 group-hover:text-accent transition-colors">
            Browse the Collection
          </h3>
          <p class="text-text-muted text-sm mb-4 max-w-md">
            Ancient coins, cylinder seals, scarabs, and artifacts spanning 5,000 years of human history.
          </p>
          <span class="inline-flex items-center gap-2 font-mono text-xs uppercase tracking-widest text-accent">
            Explore Items
            <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </span>
        </div>
      </a>

      <!-- Timeline Preview (2 cols) -->
      <a
        href={url('/timeline')}
        id="timeline-preview-link"
        class="lg:col-span-2 group relative glass-panel overflow-hidden min-h-[320px] md:min-h-[400px] hover:border-accent/30 transition-all duration-500"
      >
        <div class="absolute inset-0 bg-gradient-to-br from-gold/5 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>

        <!-- Mini Timeline Visualization (Horizontal) -->
        <div id="timeline-mini" class="absolute inset-x-4 top-8 h-24 opacity-50 group-hover:opacity-80 transition-opacity duration-500">
          <!-- Timeline axis -->
          <div class="absolute left-0 right-0 top-1/2 h-px bg-gradient-to-r from-transparent via-gold/50 to-transparent"></div>

          <!-- Era markers -->
          <div class="absolute left-0 top-1/2 -translate-y-1/2 w-1 h-3 bg-gold/30 rounded-full"></div>
          <div class="absolute left-1/4 top-1/2 -translate-y-1/2 w-1 h-2 bg-gold/20 rounded-full"></div>
          <div class="absolute left-1/2 top-1/2 -translate-y-1/2 w-1 h-3 bg-gold/30 rounded-full"></div>
          <div class="absolute left-3/4 top-1/2 -translate-y-1/2 w-1 h-2 bg-gold/20 rounded-full"></div>
          <div class="absolute right-0 top-1/2 -translate-y-1/2 w-1 h-3 bg-gold/30 rounded-full"></div>

          <!-- Item dots on timeline -->
          {timelineItems.slice(0, 10).map((item, i) => {
            const leftPercent = 5 + (i / 10) * 90;
            const topOffset = (i % 2 === 0 ? -1 : 1) * (12 + (i % 3) * 4);
            return (
              <div
                class="timeline-dot absolute w-2.5 h-2.5 rounded-full bg-gold/50 transform -translate-x-1/2 transition-all duration-300"
                data-index={i}
                style={`left: ${leftPercent}%; top: calc(50% + ${topOffset}px);`}
              >
                <div class="dot-ring absolute inset-[-4px] rounded-full border border-gold/0 transition-all duration-300"></div>
              </div>
            );
          })}

          <!-- Era labels -->
          <div class="absolute -bottom-5 left-0 font-mono text-[8px] text-text-dim">4500 BC</div>
          <div class="absolute -bottom-5 left-1/2 -translate-x-1/2 font-mono text-[8px] text-text-dim">0 AD</div>
          <div class="absolute -bottom-5 right-0 font-mono text-[8px] text-text-dim">1500 AD</div>
        </div>

        <!-- Overlay Content -->
        <div class="absolute inset-0 flex flex-col justify-end p-6 md:p-8 bg-gradient-to-t from-void/95 via-void/60 to-transparent">
          <div class="flex items-center gap-3 mb-3">
            <div class="w-10 h-10 rounded-lg bg-gold/20 flex items-center justify-center">
              <svg class="w-5 h-5 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <div>
              <p class="font-mono text-xs uppercase tracking-wider text-gold">Timeline</p>
              <p class="font-mono text-[10px] text-text-dim">6,000 years visualized</p>
            </div>
          </div>
          <h3 class="text-2xl md:text-3xl text-text mb-2 group-hover:text-gold transition-colors">
            Explore Through Time
          </h3>
          <p class="text-text-muted text-sm mb-4">
            Interactive visualization placing each item in its historical context.
          </p>
          <span class="inline-flex items-center gap-2 font-mono text-xs uppercase tracking-widest text-gold">
            View Timeline
            <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </span>
        </div>
      </a>

      <!-- Library Preview (Full Width) -->
      <a
        href={url('/library')}
        class="lg:col-span-5 group relative glass-panel overflow-hidden min-h-[200px] md:min-h-[240px] hover:border-accent/30 transition-all duration-500"
      >
        <div class="absolute inset-0 bg-gradient-to-br from-purple-500/5 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>

        <!-- Scrolling Content Preview -->
        <div class="absolute inset-0 flex items-center opacity-40 group-hover:opacity-60 transition-opacity duration-500 overflow-hidden">
          <!-- Articles strip -->
          <div class="library-scroll flex gap-4 px-4 animate-scroll-left">
            {[...articles, ...articles].map((article, i) => (
              <div class="flex-shrink-0 w-64 glass-panel-solid p-4 rounded-lg">
                <p class="font-mono text-[10px] text-accent mb-1">ARTICLE</p>
                <p class="text-sm text-text-muted line-clamp-2">{article.data.title}</p>
              </div>
            ))}
          </div>

          <!-- Books strip -->
          <div class="absolute bottom-4 right-0 flex gap-3 px-4 animate-scroll-right">
            {[...recentBooks, ...recentBooks].map((book, i) => (
              <div class="flex-shrink-0 w-12 h-18 md:w-14 md:h-20 rounded overflow-hidden border border-white/10 shadow-lg">
                <img
                  src={url(`/images/books/${book.data.cover}`)}
                  alt=""
                  class="w-full h-full object-cover"
                  loading="lazy"
                />
              </div>
            ))}
          </div>
        </div>

        <!-- Overlay Content -->
        <div class="absolute inset-0 flex flex-col justify-center p-6 md:p-8 bg-gradient-to-r from-void/95 via-void/80 to-transparent">
          <div class="max-w-md">
            <div class="flex items-center gap-3 mb-3">
              <div class="w-10 h-10 rounded-lg bg-purple-500/20 flex items-center justify-center">
                <svg class="w-5 h-5 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
                </svg>
              </div>
              <div>
                <p class="font-mono text-xs uppercase tracking-wider text-purple-400">Library</p>
                <p class="font-mono text-[10px] text-text-dim">{articles.length} articles · {books.length} books</p>
              </div>
            </div>
            <h3 class="text-2xl md:text-3xl text-text mb-2 group-hover:text-purple-400 transition-colors">
              Research & Reference
            </h3>
            <p class="text-text-muted text-sm mb-4">
              Articles, identification guides, and reference books for collectors and enthusiasts.
            </p>
            <span class="inline-flex items-center gap-2 font-mono text-xs uppercase tracking-widest text-purple-400">
              Browse Library
              <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </span>
          </div>
        </div>
      </a>
    </div>
  </div>
</section>

<script>
  function initFilmstrip() {
    const filmstrip = document.getElementById('collection-filmstrip');
    if (!filmstrip) return;

    const track = filmstrip.querySelector('.filmstrip-track') as HTMLElement;
    const parentLink = filmstrip.closest('a');
    if (!parentLink || !track) return;

    const startScroll = () => {
      track.style.animationPlayState = 'running';
    };

    const stopScroll = () => {
      track.style.animationPlayState = 'paused';
    };

    parentLink.addEventListener('mouseenter', startScroll);
    parentLink.addEventListener('mouseleave', stopScroll);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initFilmstrip);
  } else {
    initFilmstrip();
  }

  document.addEventListener('astro:page-load', initFilmstrip);

  // Timeline dot cycling
  function initTimelineCycle() {
    const container = document.getElementById('timeline-mini');
    const parentLink = document.getElementById('timeline-preview-link');
    if (!container || !parentLink) return;

    const dots = container.querySelectorAll('.timeline-dot');
    if (dots.length === 0) return;

    let currentIndex = 0;
    let intervalId: ReturnType<typeof setInterval> | null = null;

    const highlightDot = (index: number) => {
      dots.forEach((dot, i) => {
        const ring = dot.querySelector('.dot-ring') as HTMLElement;
        if (i === index) {
          (dot as HTMLElement).style.transform = 'translateX(-50%) scale(1.5)';
          (dot as HTMLElement).style.backgroundColor = 'rgb(251 191 36)';
          if (ring) ring.style.borderColor = 'rgb(251 191 36 / 0.5)';
        } else {
          (dot as HTMLElement).style.transform = 'translateX(-50%) scale(1)';
          (dot as HTMLElement).style.backgroundColor = 'rgb(251 191 36 / 0.5)';
          if (ring) ring.style.borderColor = 'transparent';
        }
      });
    };

    const startCycle = () => {
      if (intervalId) return;
      highlightDot(currentIndex);
      intervalId = setInterval(() => {
        currentIndex = (currentIndex + 1) % dots.length;
        highlightDot(currentIndex);
      }, 600);
    };

    const stopCycle = () => {
      if (intervalId) {
        clearInterval(intervalId);
        intervalId = null;
      }
      dots.forEach(dot => {
        (dot as HTMLElement).style.transform = 'translateX(-50%) scale(1)';
        (dot as HTMLElement).style.backgroundColor = 'rgb(251 191 36 / 0.5)';
        const ring = dot.querySelector('.dot-ring') as HTMLElement;
        if (ring) ring.style.borderColor = 'transparent';
      });
    };

    parentLink.addEventListener('mouseenter', startCycle);
    parentLink.addEventListener('mouseleave', stopCycle);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initTimelineCycle);
  } else {
    initTimelineCycle();
  }

  document.addEventListener('astro:page-load', initTimelineCycle);
</script>

<style>
  @keyframes filmstrip-scroll {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  .filmstrip-track {
    animation: filmstrip-scroll 25s linear infinite;
    animation-play-state: paused;
  }

  @keyframes timeline-pulse {
    0%, 100% {
      opacity: 0.4;
      transform: translate(-50%, -50%) scale(1);
    }
    50% {
      opacity: 1;
      transform: translate(-50%, -50%) scale(1.3);
    }
  }

  @keyframes scroll-left {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  @keyframes scroll-right {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(50%);
    }
  }

  .animate-scroll-left {
    animation: scroll-left 30s linear infinite;
  }

  .animate-scroll-right {
    animation: scroll-right 25s linear infinite;
  }

  .library-scroll:hover,
  .animate-scroll-right:hover {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    .animate-scroll-left,
    .animate-scroll-right,
    .filmstrip-track {
      animation: none;
    }
  }
</style>
