---
import { getAllItems } from '../lib/items';

const items = getAllItems();
const itemCount = items.length;

const execSync = await import('child_process').then(m => m.execSync);

function getGitStats() {
  try {
    const totalCommits = parseInt(execSync('git log --oneline | wc -l', { encoding: 'utf-8' }).trim());
    const lastCommitDate = execSync('git log -1 --format="%ci"', { encoding: 'utf-8' }).trim().split(' ')[0];
    const firstCommitDate = execSync('git log --format="%ad" --date=short | tail -1', { encoding: 'utf-8' }).trim();

    const commitsByDate = execSync('git log --format="%ad" --date=short', { encoding: 'utf-8' })
      .trim()
      .split('\n')
      .reduce((acc: Record<string, number>, date: string) => {
        acc[date] = (acc[date] || 0) + 1;
        return acc;
      }, {} as Record<string, number>);

    const daysSinceLastCommit = Math.floor(
      (new Date().getTime() - new Date(lastCommitDate).getTime()) / (1000 * 60 * 60 * 24)
    );

    const daysSinceStart = Math.floor(
      (new Date().getTime() - new Date(firstCommitDate).getTime()) / (1000 * 60 * 60 * 24)
    );

    return {
      totalCommits,
      lastCommitDate,
      firstCommitDate,
      daysSinceLastCommit,
      daysSinceStart,
      commitsByDate
    };
  } catch {
    return null;
  }
}

const stats = getGitStats();

function generateActivityData(commitsByDate: Record<string, number>) {
  const weeks: { date: string; count: number; level: number }[][] = [];
  const today = new Date();
  const startDate = new Date(today);
  startDate.setDate(startDate.getDate() - 52 * 7);

  let currentWeek: { date: string; count: number; level: number }[] = [];
  const startDayOfWeek = startDate.getDay();

  for (let i = 0; i < startDayOfWeek; i++) {
    currentWeek.push({ date: '', count: 0, level: -1 });
  }

  for (let d = new Date(startDate); d <= today; d.setDate(d.getDate() + 1)) {
    const dateStr = d.toISOString().split('T')[0];
    const count = commitsByDate[dateStr] || 0;
    const level = count === 0 ? 0 : count <= 2 ? 1 : count <= 4 ? 2 : count <= 6 ? 3 : 4;

    currentWeek.push({ date: dateStr, count, level });

    if (currentWeek.length === 7) {
      weeks.push(currentWeek);
      currentWeek = [];
    }
  }

  if (currentWeek.length > 0) {
    while (currentWeek.length < 7) {
      currentWeek.push({ date: '', count: 0, level: -1 });
    }
    weeks.push(currentWeek);
  }

  return weeks;
}

const activityData = stats ? generateActivityData(stats.commitsByDate) : [];

const levelColors = [
  'bg-surface-elevated/30',
  'bg-accent/20',
  'bg-accent/40',
  'bg-accent/60',
  'bg-accent/80'
];
---

{stats && (
  <div class="glass-panel p-6 md:p-8">
    <h2 class="font-mono text-xs uppercase tracking-wider text-accent mb-6">// System Stats</h2>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
      <div class="text-center p-4 bg-surface-elevated/30 rounded-lg border border-white/5">
        <div class="text-3xl font-light text-text mb-1">{itemCount}</div>
        <div class="font-mono text-xs text-text-muted uppercase tracking-wider">Items</div>
      </div>
      <div class="text-center p-4 bg-surface-elevated/30 rounded-lg border border-white/5">
        <div class="text-3xl font-light text-text mb-1">{stats.totalCommits}</div>
        <div class="font-mono text-xs text-text-muted uppercase tracking-wider">Commits</div>
      </div>
      <div class="text-center p-4 bg-surface-elevated/30 rounded-lg border border-white/5">
        <div class="text-3xl font-light text-text mb-1">{stats.daysSinceStart}</div>
        <div class="font-mono text-xs text-text-muted uppercase tracking-wider">Days Active</div>
      </div>
      <div class="text-center p-4 bg-surface-elevated/30 rounded-lg border border-white/5">
        <div class="text-3xl font-light text-accent mb-1">{stats.daysSinceLastCommit}</div>
        <div class="font-mono text-xs text-text-muted uppercase tracking-wider">Days Since Update</div>
      </div>
    </div>

    <div class="mb-4">
      <h3 class="font-mono text-xs text-text-muted uppercase tracking-wider mb-3">Activity</h3>
      <div class="flex gap-[2px] justify-between w-full">
        {activityData.map((week) => (
          <div class="flex flex-col gap-[2px] flex-1">
            {week.map((day) => (
              <div
                class:list={[
                  'aspect-square w-full max-w-4 rounded-sm transition-all',
                  day.level === -1 ? 'opacity-0' : levelColors[day.level]
                ]}
                title={day.date ? `${day.date}: ${day.count} commit${day.count !== 1 ? 's' : ''}` : ''}
              />
            ))}
          </div>
        ))}
      </div>
      <div class="flex items-center gap-2 mt-3 text-xs text-text-muted">
        <span>Less</span>
        {levelColors.map((color) => (
          <div class:list={['w-3 h-3 rounded-sm', color]} />
        ))}
        <span>More</span>
      </div>
    </div>

    <div class="pt-4 border-t border-white/5 flex flex-wrap items-center justify-between gap-4">
      <div class="flex flex-wrap gap-x-6 gap-y-2 font-mono text-xs text-text-muted">
        <span>First commit: <span class="text-text">{stats.firstCommitDate}</span></span>
        <span>Last update: <span class="text-text">{stats.lastCommitDate}</span></span>
        <span>Avg: <span class="text-text">{(stats.totalCommits / Math.max(stats.daysSinceStart, 1)).toFixed(1)}</span> commits/day</span>
      </div>
      <div class="flex items-center gap-4">
        <a
          href="https://github.com/Adrena-Corto/Archive"
          target="_blank"
          rel="noopener noreferrer"
          class="text-text-muted hover:text-accent transition-colors"
          title="GitHub"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
          </svg>
        </a>
        <a
          href="https://x.com/AdrenaCorto"
          target="_blank"
          rel="noopener noreferrer"
          class="text-text-muted hover:text-accent transition-colors"
          title="X (Twitter)"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
          </svg>
        </a>
      </div>
    </div>
  </div>
)}
