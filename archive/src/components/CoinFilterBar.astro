---
import { getCoins, getAllRulers, getAllDenominations, getAllMaterials, getAllPeriods } from '../lib/items';

const coins = getCoins();
const rulers = getAllRulers();
const denominations = getAllDenominations();
const materials = [...new Set(coins.map(c => c.material))].sort();
const periods = [...new Set(coins.map(c => c.period))].sort();
const totalCoins = coins.length;

const rulerOptions = [
  { value: 'all', label: 'All Rulers' },
  ...rulers.map(r => ({ value: r, label: r }))
];

const denominationOptions = [
  { value: 'all', label: 'All Denominations' },
  ...denominations.map(d => ({ value: d, label: d }))
];

const materialOptions = [
  { value: 'all', label: 'All Materials' },
  ...materials.map(m => ({ value: m, label: m.charAt(0).toUpperCase() + m.slice(1) }))
];

const periodOptions = [
  { value: 'all', label: 'All Periods' },
  ...periods.map(p => ({ value: p, label: p }))
];
---

<div
  x-data={`{
    ruler: 'all',
    denomination: 'all',
    material: 'all',
    period: 'all',
    rulerOpen: false,
    denominationOpen: false,
    materialOpen: false,
    periodOpen: false,
    visibleCount: ${totalCoins},
    totalCoins: ${totalCoins},
    rulerOptions: ${JSON.stringify(rulerOptions)},
    denominationOptions: ${JSON.stringify(denominationOptions)},
    materialOptions: ${JSON.stringify(materialOptions)},
    periodOptions: ${JSON.stringify(periodOptions)},
    init() {
      const params = new URLSearchParams(window.location.search);
      if (params.get('ruler')) this.ruler = params.get('ruler');
      if (params.get('denomination')) this.denomination = params.get('denomination');
      if (params.get('material')) this.material = params.get('material');
      if (params.get('period')) this.period = params.get('period');
      this.filterItems();
    },
    updateURL() {
      const params = new URLSearchParams();
      if (this.ruler !== 'all') params.set('ruler', this.ruler);
      if (this.denomination !== 'all') params.set('denomination', this.denomination);
      if (this.material !== 'all') params.set('material', this.material);
      if (this.period !== 'all') params.set('period', this.period);
      const newURL = params.toString() ? '?' + params.toString() : window.location.pathname;
      window.history.replaceState({}, '', newURL);
    },
    filtering: false,
    filterItems() {
      this.filtering = true;
      const grid = document.getElementById('coin-grid');
      if (grid) grid.style.opacity = '0.5';

      requestAnimationFrame(() => {
        const items = document.querySelectorAll('[data-coin-item]');
        let count = 0;
        items.forEach(item => {
          const matchRuler = this.ruler === 'all' || item.dataset.ruler === this.ruler;
          const matchDenomination = this.denomination === 'all' || item.dataset.denomination === this.denomination;
          const matchMaterial = this.material === 'all' || item.dataset.material === this.material;
          const matchPeriod = this.period === 'all' || item.dataset.period === this.period;
          const visible = matchRuler && matchDenomination && matchMaterial && matchPeriod;
          item.style.display = visible ? '' : 'none';
          if (visible) count++;
        });
        this.visibleCount = count;
        this.updateURL();

        if (grid) grid.style.opacity = '1';
        this.filtering = false;
      });
    },
    clearFilters() {
      this.ruler = 'all';
      this.denomination = 'all';
      this.material = 'all';
      this.period = 'all';
      this.filterItems();
    },
    hasActiveFilters() {
      return this.ruler !== 'all' || this.denomination !== 'all' || this.material !== 'all' || this.period !== 'all';
    },
    closeAll() {
      this.rulerOpen = false;
      this.denominationOpen = false;
      this.materialOpen = false;
      this.periodOpen = false;
    },
    getLabel(options, value) {
      const opt = options.find(o => o.value === value);
      return opt ? opt.label : value;
    }
  }`}
  x-init="init()"
  @keydown.escape.window="closeAll()"
  class="glass-panel p-4 mb-8 overflow-visible relative z-40"
>
  <div class="flex flex-col sm:flex-row sm:flex-wrap sm:items-center gap-4 md:gap-6">
    <!-- Ruler Dropdown -->
    {rulers.length > 0 && (
      <div class="relative" @click.outside="rulerOpen = false">
        <label class="font-mono text-[10px] uppercase tracking-wider text-text-dim block mb-1.5">Ruler</label>
        <button
          type="button"
          @click="rulerOpen = !rulerOpen; denominationOpen = false; materialOpen = false; periodOpen = false"
          class="custom-select group"
          :class="{ 'custom-select-active': ruler !== 'all', 'custom-select-open': rulerOpen }"
          aria-haspopup="listbox"
          :aria-expanded="rulerOpen"
        >
          <span x-text="getLabel(rulerOptions, ruler)" class="truncate"></span>
          <svg class="select-chevron" :class="{ 'rotate-180': rulerOpen }" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
          </svg>
        </button>
        <div
          x-show="rulerOpen"
          x-transition:enter="transition ease-out duration-200"
          x-transition:enter-start="opacity-0 -translate-y-2"
          x-transition:enter-end="opacity-100 translate-y-0"
          x-transition:leave="transition ease-in duration-150"
          x-transition:leave-start="opacity-100 translate-y-0"
          x-transition:leave-end="opacity-0 -translate-y-2"
          class="select-dropdown"
          role="listbox"
          x-cloak
        >
          <template x-for="option in rulerOptions" :key="option.value">
            <button
              type="button"
              @click="ruler = option.value; rulerOpen = false; filterItems()"
              class="select-option"
              :class="{ 'select-option-selected': ruler === option.value }"
              role="option"
              :aria-selected="ruler === option.value"
            >
              <span x-text="option.label"></span>
              <svg x-show="ruler === option.value" class="select-check" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd" />
              </svg>
            </button>
          </template>
        </div>
      </div>
    )}

    <!-- Denomination Dropdown -->
    {denominations.length > 0 && (
      <div class="relative" @click.outside="denominationOpen = false">
        <label class="font-mono text-[10px] uppercase tracking-wider text-text-dim block mb-1.5">Denomination</label>
        <button
          type="button"
          @click="denominationOpen = !denominationOpen; rulerOpen = false; materialOpen = false; periodOpen = false"
          class="custom-select group"
          :class="{ 'custom-select-active': denomination !== 'all', 'custom-select-open': denominationOpen }"
          aria-haspopup="listbox"
          :aria-expanded="denominationOpen"
        >
          <span x-text="getLabel(denominationOptions, denomination)" class="truncate"></span>
          <svg class="select-chevron" :class="{ 'rotate-180': denominationOpen }" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
          </svg>
        </button>
        <div
          x-show="denominationOpen"
          x-transition:enter="transition ease-out duration-200"
          x-transition:enter-start="opacity-0 -translate-y-2"
          x-transition:enter-end="opacity-100 translate-y-0"
          x-transition:leave="transition ease-in duration-150"
          x-transition:leave-start="opacity-100 translate-y-0"
          x-transition:leave-end="opacity-0 -translate-y-2"
          class="select-dropdown"
          role="listbox"
          x-cloak
        >
          <template x-for="option in denominationOptions" :key="option.value">
            <button
              type="button"
              @click="denomination = option.value; denominationOpen = false; filterItems()"
              class="select-option"
              :class="{ 'select-option-selected': denomination === option.value }"
              role="option"
              :aria-selected="denomination === option.value"
            >
              <span x-text="option.label"></span>
              <svg x-show="denomination === option.value" class="select-check" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd" />
              </svg>
            </button>
          </template>
        </div>
      </div>
    )}

    <!-- Material Dropdown -->
    {materials.length > 0 && (
      <div class="relative" @click.outside="materialOpen = false">
        <label class="font-mono text-[10px] uppercase tracking-wider text-text-dim block mb-1.5">Material</label>
        <button
          type="button"
          @click="materialOpen = !materialOpen; rulerOpen = false; denominationOpen = false; periodOpen = false"
          class="custom-select group"
          :class="{ 'custom-select-active': material !== 'all', 'custom-select-open': materialOpen }"
          aria-haspopup="listbox"
          :aria-expanded="materialOpen"
        >
          <span x-text="getLabel(materialOptions, material)" class="truncate"></span>
          <svg class="select-chevron" :class="{ 'rotate-180': materialOpen }" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
          </svg>
        </button>
        <div
          x-show="materialOpen"
          x-transition:enter="transition ease-out duration-200"
          x-transition:enter-start="opacity-0 -translate-y-2"
          x-transition:enter-end="opacity-100 translate-y-0"
          x-transition:leave="transition ease-in duration-150"
          x-transition:leave-start="opacity-100 translate-y-0"
          x-transition:leave-end="opacity-0 -translate-y-2"
          class="select-dropdown"
          role="listbox"
          x-cloak
        >
          <template x-for="option in materialOptions" :key="option.value">
            <button
              type="button"
              @click="material = option.value; materialOpen = false; filterItems()"
              class="select-option"
              :class="{ 'select-option-selected': material === option.value }"
              role="option"
              :aria-selected="material === option.value"
            >
              <span x-text="option.label"></span>
              <svg x-show="material === option.value" class="select-check" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd" />
              </svg>
            </button>
          </template>
        </div>
      </div>
    )}

    <!-- Period Dropdown -->
    {periods.length > 0 && (
      <div class="relative" @click.outside="periodOpen = false">
        <label class="font-mono text-[10px] uppercase tracking-wider text-text-dim block mb-1.5">Period</label>
        <button
          type="button"
          @click="periodOpen = !periodOpen; rulerOpen = false; denominationOpen = false; materialOpen = false"
          class="custom-select group"
          :class="{ 'custom-select-active': period !== 'all', 'custom-select-open': periodOpen }"
          aria-haspopup="listbox"
          :aria-expanded="periodOpen"
        >
          <span x-text="getLabel(periodOptions, period)" class="truncate"></span>
          <svg class="select-chevron" :class="{ 'rotate-180': periodOpen }" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
          </svg>
        </button>
        <div
          x-show="periodOpen"
          x-transition:enter="transition ease-out duration-200"
          x-transition:enter-start="opacity-0 -translate-y-2"
          x-transition:enter-end="opacity-100 translate-y-0"
          x-transition:leave="transition ease-in duration-150"
          x-transition:leave-start="opacity-100 translate-y-0"
          x-transition:leave-end="opacity-0 -translate-y-2"
          class="select-dropdown"
          role="listbox"
          x-cloak
        >
          <template x-for="option in periodOptions" :key="option.value">
            <button
              type="button"
              @click="period = option.value; periodOpen = false; filterItems()"
              class="select-option"
              :class="{ 'select-option-selected': period === option.value }"
              role="option"
              :aria-selected="period === option.value"
            >
              <span x-text="option.label"></span>
              <svg x-show="period === option.value" class="select-check" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd" />
              </svg>
            </button>
          </template>
        </div>
      </div>
    )}

    <div class="flex items-center gap-4 sm:ml-auto pt-2 sm:pt-0 border-t sm:border-t-0 border-white/5">
      <span class="font-mono text-xs text-text-muted" role="status" aria-live="polite">
        <span class="text-accent">></span>
        <span x-text="visibleCount"></span> coins
      </span>
      <button
        x-show="hasActiveFilters()"
        @click="clearFilters()"
        class="font-mono text-[10px] uppercase tracking-wider text-text-dim hover:text-accent transition-colors"
      >
        [Clear]
      </button>
    </div>
  </div>

  <!-- Empty state message -->
  <div
    x-show="visibleCount === 0"
    x-cloak
    class="mt-4 p-4 border border-border-light rounded-lg text-center"
    role="status"
  >
    <p class="font-mono text-sm text-text-muted">
      <span class="text-accent">//</span> No coins match your filters
    </p>
    <button
      @click="clearFilters()"
      class="mt-2 font-mono text-xs text-accent hover:underline"
    >
      Clear all filters
    </button>
  </div>
</div>

<script>
  document.addEventListener('astro:page-load', () => {
    const filterBar = document.querySelector('[x-data]');
    if (filterBar && window.Alpine) {
      const alpineData = window.Alpine.$data(filterBar);
      if (alpineData && typeof alpineData.init === 'function') {
        alpineData.init();
      }
    }
  });
</script>

<style>
  .custom-select {
    @apply relative flex items-center justify-between gap-2;
    @apply min-w-[140px] px-3 py-2;
    @apply bg-surface-light/50 backdrop-blur-sm;
    @apply border border-border rounded-lg;
    @apply font-mono text-xs text-text;
    @apply transition-all duration-200 ease-out;
    @apply cursor-pointer;
  }

  .custom-select:hover {
    @apply bg-surface-light border-border-light;
  }

  .custom-select-open {
    @apply border-accent/50 bg-surface-light;
    box-shadow: 0 0 0 1px rgba(34, 211, 238, 0.1), 0 4px 20px rgba(0, 0, 0, 0.3);
  }

  .custom-select-active {
    @apply border-accent/30 text-accent;
  }

  .custom-select-active:hover {
    @apply border-accent/50;
  }

  .select-chevron {
    @apply w-4 h-4 text-text-dim transition-transform duration-200;
  }

  .custom-select:hover .select-chevron {
    @apply text-text-muted;
  }

  .custom-select-active .select-chevron {
    @apply text-accent/70;
  }

  .select-dropdown {
    @apply absolute top-full left-0 mt-2;
    @apply min-w-full w-max max-w-[280px];
    @apply py-1.5;
    @apply bg-surface-elevated backdrop-blur-xl;
    @apply border border-border-light rounded-xl;
    @apply overflow-hidden;
    z-index: 9999;
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.05),
      0 4px 6px rgba(0, 0, 0, 0.3),
      0 12px 48px rgba(0, 0, 0, 0.5);
  }

  .select-option {
    @apply w-full flex items-center justify-between gap-3;
    @apply px-3.5 py-2.5;
    @apply font-mono text-xs text-text-muted;
    @apply transition-all duration-150;
    @apply cursor-pointer;
    @apply text-left;
  }

  .select-option:hover {
    @apply bg-white/5 text-text;
  }

  .select-option-selected {
    @apply text-accent bg-accent/5;
  }

  .select-option-selected:hover {
    @apply bg-accent/10 text-accent;
  }

  .select-check {
    @apply w-4 h-4 text-accent flex-shrink-0;
  }
</style>
