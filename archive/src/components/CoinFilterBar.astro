---
import { getCoins, getAllRulers, getAllDenominations, getAllMaterials, getAllEmpires, getCoinCountByEmpire, getDenominationsByEmpire, getRulersByEmpire, type Empire } from '../lib/items';

const coins = getCoins();
const empires = getAllEmpires();
const empireCounts = getCoinCountByEmpire();
const rulers = getAllRulers();
const denominations = getAllDenominations();
const materials = [...new Set(coins.map(c => c.material))].sort();
const tags = [...new Set(coins.flatMap(c => c.tags))].sort();
const totalCoins = coins.length;

const empireLabels: Record<Empire, string> = {
  roman: 'Roman',
  byzantine: 'Byzantine',
  greek: 'Greek',
  persian: 'Persian',
  islamic: 'Islamic',
  other: 'Other'
};

const materialOptions = [
  { value: 'all', label: 'All Materials' },
  ...materials.map(m => ({ value: m, label: m.charAt(0).toUpperCase() + m.slice(1) }))
];

const tagOptions = [
  { value: 'all', label: 'All Tags' },
  ...tags.map(t => ({ value: t, label: t.split('-').map(w => w.charAt(0).toUpperCase() + w.slice(1)).join(' ') }))
];

const sortOptions = [
  { value: 'name', label: 'Name A-Z' },
  { value: 'era-oldest', label: 'Era (Oldest)' },
  { value: 'era-newest', label: 'Era (Newest)' },
  { value: 'recent', label: 'Recently Added' },
];

const denominationsByEmpire: Record<string, string[]> = {
  all: denominations,
  ...Object.fromEntries(empires.map(e => [e, getDenominationsByEmpire(e)]))
};

const rulersByEmpire: Record<string, string[]> = {
  all: rulers,
  ...Object.fromEntries(empires.map(e => [e, getRulersByEmpire(e)]))
};

function getRulerCountByEmpire(empire: string): Record<string, number> {
  const filtered = empire === 'all' ? coins : coins.filter(c => c.empire === empire);
  const counts: Record<string, number> = {};
  filtered.forEach(coin => {
    if (coin.ruler) {
      counts[coin.ruler] = (counts[coin.ruler] || 0) + 1;
    }
  });
  return counts;
}

function getDenomCountByEmpire(empire: string): Record<string, number> {
  const filtered = empire === 'all' ? coins : coins.filter(c => c.empire === empire);
  const counts: Record<string, number> = {};
  filtered.forEach(coin => {
    if (coin.denomination) {
      counts[coin.denomination] = (counts[coin.denomination] || 0) + 1;
    }
  });
  return counts;
}

const rulerCountsByEmpire: Record<string, Record<string, number>> = {
  all: getRulerCountByEmpire('all'),
  ...Object.fromEntries(empires.map(e => [e, getRulerCountByEmpire(e)]))
};

const denomCountsByEmpire: Record<string, Record<string, number>> = {
  all: getDenomCountByEmpire('all'),
  ...Object.fromEntries(empires.map(e => [e, getDenomCountByEmpire(e)]))
};
---

<div
  x-data={`{
    empire: 'all',
    denomination: 'all',
    ruler: 'all',
    material: 'all',
    tag: 'all',
    sort: 'name',
    showSubFilters: false,
    materialOpen: false,
    tagOpen: false,
    sortOpen: false,
    mobileSortOpen: false,
    mobileExpanded: false,
    visibleCount: ${totalCoins},
    totalCoins: ${totalCoins},
    empireCounts: ${JSON.stringify(empireCounts)},
    empireLabels: ${JSON.stringify(empireLabels)},
    denominationsByEmpire: ${JSON.stringify(denominationsByEmpire)},
    rulersByEmpire: ${JSON.stringify(rulersByEmpire)},
    rulerCountsByEmpire: ${JSON.stringify(rulerCountsByEmpire)},
    denomCountsByEmpire: ${JSON.stringify(denomCountsByEmpire)},
    materialOptions: ${JSON.stringify(materialOptions)},
    tagOptions: ${JSON.stringify(tagOptions)},
    sortOptions: ${JSON.stringify(sortOptions)},
    init() {
      const params = new URLSearchParams(window.location.search);
      if (params.get('empire')) this.empire = params.get('empire');
      if (params.get('denomination')) this.denomination = params.get('denomination');
      if (params.get('ruler')) this.ruler = params.get('ruler');
      if (params.get('material')) this.material = params.get('material');
      if (params.get('tag')) this.tag = params.get('tag');
      if (params.get('sort')) this.sort = params.get('sort');
      this.filterAndSort();
    },
    getFilterSummary() {
      const parts = [];
      if (this.empire !== 'all') parts.push(this.empireLabels[this.empire] || this.empire);
      if (this.denomination !== 'all') parts.push(this.denomination);
      if (this.ruler !== 'all') parts.push(this.ruler);
      if (this.material !== 'all') parts.push(this.material.charAt(0).toUpperCase() + this.material.slice(1));
      if (this.tag !== 'all') parts.push(this.tag);
      if (parts.length === 0) return 'All Coins';
      if (parts.length <= 2) return parts.join(' · ');
      return parts.slice(0, 2).join(' · ') + ' +' + (parts.length - 2);
    },
    activeFilterCount() {
      let count = 0;
      if (this.empire !== 'all') count++;
      if (this.denomination !== 'all') count++;
      if (this.ruler !== 'all') count++;
      if (this.material !== 'all') count++;
      if (this.tag !== 'all') count++;
      return count;
    },
    updateURL() {
      const params = new URLSearchParams();
      if (this.empire !== 'all') params.set('empire', this.empire);
      if (this.denomination !== 'all') params.set('denomination', this.denomination);
      if (this.ruler !== 'all') params.set('ruler', this.ruler);
      if (this.material !== 'all') params.set('material', this.material);
      if (this.tag !== 'all') params.set('tag', this.tag);
      if (this.sort !== 'name') params.set('sort', this.sort);
      const newURL = params.toString() ? '?' + params.toString() : window.location.pathname;
      window.history.replaceState({}, '', newURL);
    },
    setEmpire(value) {
      if (this.empire === value) {
        this.showSubFilters = !this.showSubFilters;
      } else {
        this.empire = value;
        this.showSubFilters = value !== 'all';
        const availableDenoms = this.denominationsByEmpire[value] || [];
        const availableRulers = this.rulersByEmpire[value] || [];
        if (this.denomination !== 'all' && !availableDenoms.includes(this.denomination)) {
          this.denomination = 'all';
        }
        if (this.ruler !== 'all' && !availableRulers.includes(this.ruler)) {
          this.ruler = 'all';
        }
      }
      this.filterAndSort();
    },
    setDenomination(value) {
      this.denomination = value;
      this.filterAndSort();
    },
    setRuler(value) {
      this.ruler = value;
      this.filterAndSort();
    },
    getDenominations() {
      return this.denominationsByEmpire[this.empire] || [];
    },
    getRulers() {
      return this.rulersByEmpire[this.empire] || [];
    },
    getRulerCount(ruler) {
      return (this.rulerCountsByEmpire[this.empire] || {})[ruler] || 0;
    },
    getDenomCount(denom) {
      return (this.denomCountsByEmpire[this.empire] || {})[denom] || 0;
    },
    filtering: false,
    filterAndSort() {
      this.filtering = true;
      const grid = document.getElementById('coin-grid');
      if (grid) grid.style.opacity = '0.5';

      requestAnimationFrame(() => {
        const items = Array.from(document.querySelectorAll('[data-coin-item]'));
        let count = 0;

        items.forEach(item => {
          const matchEmpire = this.empire === 'all' || item.dataset.empire === this.empire;
          const matchDenomination = this.denomination === 'all' || item.dataset.denomination === this.denomination;
          const matchRuler = this.ruler === 'all' || item.dataset.ruler === this.ruler;
          const matchMaterial = this.material === 'all' || item.dataset.material === this.material;
          const matchTag = this.tag === 'all' || (item.dataset.tags && item.dataset.tags.split(',').includes(this.tag));
          const visible = matchEmpire && matchDenomination && matchRuler && matchMaterial && matchTag;
          item.style.display = visible ? '' : 'none';
          if (visible) count++;
        });

        const visibleItems = items.filter(item => item.style.display !== 'none');
        visibleItems.sort((a, b) => {
          if (this.sort === 'name') {
            return (a.dataset.name || '').localeCompare(b.dataset.name || '');
          } else if (this.sort === 'era-oldest') {
            return parseInt(a.dataset.year || '0') - parseInt(b.dataset.year || '0');
          } else if (this.sort === 'era-newest') {
            return parseInt(b.dataset.year || '0') - parseInt(a.dataset.year || '0');
          } else if (this.sort === 'recent') {
            const dateA = a.dataset.dateAdded || '1970-01-01';
            const dateB = b.dataset.dateAdded || '1970-01-01';
            return dateB.localeCompare(dateA);
          }
          return 0;
        });

        const gridEl = grid?.querySelector('.grid') || grid;
        if (gridEl) {
          visibleItems.forEach(item => gridEl.appendChild(item));
        }

        this.visibleCount = count;
        this.updateURL();

        if (grid) grid.style.opacity = '1';
        this.filtering = false;
      });
    },
    clearFilters() {
      this.empire = 'all';
      this.denomination = 'all';
      this.ruler = 'all';
      this.material = 'all';
      this.tag = 'all';
      this.filterAndSort();
    },
    hasActiveFilters() {
      return this.empire !== 'all' || this.denomination !== 'all' || this.ruler !== 'all' || this.material !== 'all' || this.tag !== 'all';
    },
    closeAll() {
      this.materialOpen = false;
      this.tagOpen = false;
      this.sortOpen = false;
      this.mobileSortOpen = false;
    },
    closeMobileFilters() {
      this.mobileExpanded = false;
      this.closeAll();
    },
    getLabel(options, value) {
      const opt = options.find(o => o.value === value);
      return opt ? opt.label : value;
    }
  }`}
  x-init="init()"
  @keydown.escape.window="closeAll(); mobileExpanded = false"
  class="coin-filter-bar md:glass-panel md:p-4 mb-8 overflow-visible relative z-40"
>
  <!-- Mobile Collapsed Bar (visible on mobile only) -->
  <div class="mobile-filter-header md:hidden sticky top-[57px] z-40 bg-void/95 backdrop-blur-xl border-b border-white/10">
    <div class="flex items-center gap-3 px-4 py-3">
      <!-- Filter Toggle Button -->
      <button
        type="button"
        @click="mobileExpanded = !mobileExpanded"
        class="flex items-center gap-2 px-3 py-2 bg-surface-light/50 border border-border rounded-lg font-mono text-xs text-text-muted hover:text-text hover:border-border-light transition-all"
        :class="{ 'border-accent/50 text-accent': mobileExpanded || hasActiveFilters() }"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z" />
        </svg>
        <span x-text="getFilterSummary()"></span>
        <span
          x-show="activeFilterCount() > 0"
          x-text="activeFilterCount()"
          class="inline-flex items-center justify-center min-w-[18px] h-[18px] px-1 bg-accent/20 text-accent text-[10px] rounded-full"
        ></span>
      </button>

      <!-- Mobile Sort Dropdown -->
      <div class="relative ml-auto" @click.outside="mobileSortOpen = false">
        <button
          type="button"
          @click="mobileSortOpen = !mobileSortOpen"
          class="flex items-center gap-1.5 px-2.5 py-2 bg-surface-light/50 border border-border rounded-lg font-mono text-[11px] text-text-muted"
          :class="{ 'border-accent/30 text-accent': sort !== 'name' }"
        >
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4h13M3 8h9m-9 4h6m4 0l4-4m0 0l4 4m-4-4v12" />
          </svg>
          <span x-text="getLabel(sortOptions, sort)"></span>
        </button>
        <div
          x-show="mobileSortOpen"
          x-transition:enter="transition ease-out duration-150"
          x-transition:enter-start="opacity-0 -translate-y-1"
          x-transition:enter-end="opacity-100 translate-y-0"
          x-transition:leave="transition ease-in duration-100"
          x-transition:leave-start="opacity-100"
          x-transition:leave-end="opacity-0"
          class="absolute right-0 top-full mt-1 min-w-[140px] py-1 bg-surface-elevated border border-border-light rounded-lg shadow-xl z-50"
          x-cloak
        >
          <template x-for="option in sortOptions" :key="option.value">
            <button
              type="button"
              @click="sort = option.value; mobileSortOpen = false; filterAndSort()"
              class="w-full px-3 py-2 text-left font-mono text-[11px] text-text-muted hover:bg-white/5 hover:text-text"
              :class="{ 'text-accent bg-accent/5': sort === option.value }"
            >
              <span x-text="option.label"></span>
            </button>
          </template>
        </div>
      </div>

      <!-- Coin Count -->
      <span class="font-mono text-[11px] text-text-dim whitespace-nowrap">
        <span class="text-accent" x-text="visibleCount"></span>
      </span>
    </div>
  </div>

  <!-- Mobile Expanded Filters -->
  <div
    x-show="mobileExpanded"
    x-transition:enter="transition ease-out duration-200"
    x-transition:enter-start="opacity-0 -translate-y-2"
    x-transition:enter-end="opacity-100 translate-y-0"
    x-transition:leave="transition ease-in duration-150"
    x-transition:leave-start="opacity-100 translate-y-0"
    x-transition:leave-end="opacity-0 -translate-y-2"
    class="md:hidden bg-surface/95 backdrop-blur-xl border-b border-white/10 px-4 py-4"
    x-cloak
  >
    <!-- Empire Pills (Mobile) -->
    <div class="mb-4">
      <label class="mobile-filter-label">Empire</label>
      <div class="flex flex-wrap gap-1.5">
        <button
          type="button"
          @click="setEmpire('all')"
          class="mobile-filter-pill"
          :class="{ 'mobile-filter-pill-active': empire === 'all' }"
        >All <span class="mobile-pill-count" x-text="empireCounts.all"></span></button>
        {empires.map(emp => (
          <button
            type="button"
            @click={`setEmpire('${emp}')`}
            class="mobile-filter-pill"
            :class={`{ 'mobile-filter-pill-active': empire === '${emp}' }`}
          >{empireLabels[emp]} <span class="mobile-pill-count">{empireCounts[emp] || 0}</span></button>
        ))}
      </div>
    </div>

    <!-- Type Pills (Mobile) -->
    <div class="mb-4" x-show="getDenominations().length > 0">
      <label class="mobile-filter-label">Type</label>
      <div class="flex flex-wrap gap-1.5">
        <button
          type="button"
          @click="setDenomination('all')"
          class="mobile-filter-pill"
          :class="{ 'mobile-filter-pill-active': denomination === 'all' }"
        >All</button>
        <template x-for="denom in getDenominations()" :key="denom">
          <button
            type="button"
            @click="setDenomination(denom)"
            class="mobile-filter-pill"
            :class="{ 'mobile-filter-pill-active': denomination === denom }"
          ><span x-text="denom"></span> <span class="mobile-pill-count" x-text="getDenomCount(denom)"></span></button>
        </template>
      </div>
    </div>

    <!-- Ruler Pills (Mobile) -->
    <div class="mb-4" x-show="getRulers().length > 0">
      <label class="mobile-filter-label">Ruler</label>
      <div class="flex flex-wrap gap-1.5">
        <button
          type="button"
          @click="setRuler('all')"
          class="mobile-filter-pill"
          :class="{ 'mobile-filter-pill-active': ruler === 'all' }"
        >All</button>
        <template x-for="r in getRulers()" :key="r">
          <button
            type="button"
            @click="setRuler(r)"
            class="mobile-filter-pill"
            :class="{ 'mobile-filter-pill-active': ruler === r }"
          ><span x-text="r"></span> <span class="mobile-pill-count" x-text="getRulerCount(r)"></span></button>
        </template>
      </div>
    </div>

    <!-- Material & Tag Row (Mobile) -->
    <div class="flex gap-3 mb-4">
      {materials.length > 1 && (
        <div class="flex-1">
          <label class="mobile-filter-label">Material</label>
          <select
            x-model="material"
            @change="filterAndSort()"
            class="w-full px-2.5 py-2 bg-surface-light/50 border border-border rounded-lg font-mono text-[11px] text-text"
          >
            {materialOptions.map(opt => (
              <option value={opt.value}>{opt.label}</option>
            ))}
          </select>
        </div>
      )}
      {tags.length > 0 && (
        <div class="flex-1">
          <label class="mobile-filter-label">Tag</label>
          <select
            x-model="tag"
            @change="filterAndSort()"
            class="w-full px-2.5 py-2 bg-surface-light/50 border border-border rounded-lg font-mono text-[11px] text-text"
          >
            {tagOptions.map(opt => (
              <option value={opt.value}>{opt.label}</option>
            ))}
          </select>
        </div>
      )}
    </div>

    <!-- Action Row (Mobile) -->
    <div class="flex items-center justify-between pt-3 border-t border-white/5">
      <button
        x-show="hasActiveFilters()"
        @click="clearFilters()"
        class="font-mono text-[11px] text-text-dim hover:text-accent transition-colors"
      >[Clear All]</button>
      <span x-show="!hasActiveFilters()" class="font-mono text-[11px] text-text-dim">
        <span class="text-accent" x-text="visibleCount"></span> coins
      </span>
      <button
        type="button"
        @click="closeMobileFilters()"
        class="px-4 py-2 bg-accent/10 border border-accent/50 rounded-lg font-mono text-xs text-accent hover:bg-accent/20 transition-colors"
      >Done</button>
    </div>
  </div>

  <!-- Desktop Filters (hidden on mobile) -->
  <div class="hidden md:block">
  <!-- Row 1: Empire Pills -->
  <div class="filter-row">
    <label class="filter-label">Empire</label>
    <div class="flex flex-wrap gap-2">
      <button
        type="button"
        @click="setEmpire('all')"
        class="filter-pill"
        :class="{ 'filter-pill-active': empire === 'all' }"
      >
        <span>All</span>
        <span class="filter-pill-count" x-text="empireCounts.all || 0"></span>
      </button>
      {empires.map(emp => (
        <button
          type="button"
          @click={`setEmpire('${emp}')`}
          class="filter-pill"
          :class={`{ 'filter-pill-active': empire === '${emp}' }`}
        >
          <span>{empireLabels[emp]}</span>
          <span class="filter-pill-count">{empireCounts[emp] || 0}</span>
        </button>
      ))}
    </div>
  </div>

  <!-- Sub-filters container with smooth height animation -->
  <div
    class="sub-filters-wrapper"
    :class="{ 'sub-filters-open': showSubFilters && (getDenominations().length > 0 || getRulers().length > 0) }"
  >
    <div class="sub-filters-inner">
      <!-- Row 2: Type Pills -->
      <div class="filter-row filter-row-sub" x-show="getDenominations().length > 0">
        <label class="filter-label">Type</label>
        <div class="flex flex-wrap gap-2">
          <button
            type="button"
            @click="setDenomination('all')"
            class="filter-pill filter-pill-sm"
            :class="{ 'filter-pill-active': denomination === 'all' }"
          >
            <span>All</span>
          </button>
          <template x-for="denom in getDenominations()" :key="denom">
            <button
              type="button"
              @click="setDenomination(denom)"
              class="filter-pill filter-pill-sm"
              :class="{ 'filter-pill-active': denomination === denom }"
            >
              <span x-text="denom"></span>
              <span class="filter-pill-count" x-text="getDenomCount(denom)"></span>
            </button>
          </template>
        </div>
      </div>

      <!-- Row 3: Ruler Pills -->
      <div class="filter-row filter-row-sub" x-show="getRulers().length > 0">
        <label class="filter-label">Ruler</label>
        <div class="flex flex-wrap gap-2">
          <button
            type="button"
            @click="setRuler('all')"
            class="filter-pill filter-pill-sm"
            :class="{ 'filter-pill-active': ruler === 'all' }"
          >
            <span>All</span>
          </button>
          <template x-for="r in getRulers()" :key="r">
            <button
              type="button"
              @click="setRuler(r)"
              class="filter-pill filter-pill-sm"
              :class="{ 'filter-pill-active': ruler === r }"
            >
              <span x-text="r"></span>
              <span class="filter-pill-count" x-text="getRulerCount(r)"></span>
            </button>
          </template>
        </div>
      </div>
    </div>
  </div>

  <!-- Row 4: Additional Filters (Dropdowns) + Sort + Count -->
  <div class="flex flex-col sm:flex-row sm:flex-wrap sm:items-center gap-4 md:gap-6 pt-4 mt-4 border-t border-white/5">
    <!-- Material Dropdown -->
    {materials.length > 1 && (
      <div class="relative" @click.outside="materialOpen = false">
        <label class="font-mono text-[10px] uppercase tracking-wider text-text-dim block mb-1.5">Material</label>
        <button
          type="button"
          @click="closeAll(); materialOpen = !materialOpen"
          class="custom-select group"
          :class="{ 'custom-select-active': material !== 'all', 'custom-select-open': materialOpen }"
          aria-haspopup="listbox"
          :aria-expanded="materialOpen"
        >
          <span x-text="getLabel(materialOptions, material)" class="truncate"></span>
          <svg class="select-chevron" :class="{ 'rotate-180': materialOpen }" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
          </svg>
        </button>
        <div
          x-show="materialOpen"
          x-transition:enter="transition ease-out duration-200"
          x-transition:enter-start="opacity-0 -translate-y-2"
          x-transition:enter-end="opacity-100 translate-y-0"
          x-transition:leave="transition ease-in duration-150"
          x-transition:leave-start="opacity-100 translate-y-0"
          x-transition:leave-end="opacity-0 -translate-y-2"
          class="select-dropdown"
          role="listbox"
          x-cloak
        >
          <template x-for="option in materialOptions" :key="option.value">
            <button
              type="button"
              @click="material = option.value; materialOpen = false; filterAndSort()"
              class="select-option"
              :class="{ 'select-option-selected': material === option.value }"
              role="option"
              :aria-selected="material === option.value"
            >
              <span x-text="option.label"></span>
              <svg x-show="material === option.value" class="select-check" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd" />
              </svg>
            </button>
          </template>
        </div>
      </div>
    )}

    <!-- Tag Dropdown -->
    {tags.length > 0 && (
      <div class="relative" @click.outside="tagOpen = false">
        <label class="font-mono text-[10px] uppercase tracking-wider text-text-dim block mb-1.5">Tag</label>
        <button
          type="button"
          @click="closeAll(); tagOpen = !tagOpen"
          class="custom-select group"
          :class="{ 'custom-select-active': tag !== 'all', 'custom-select-open': tagOpen }"
          aria-haspopup="listbox"
          :aria-expanded="tagOpen"
        >
          <span x-text="getLabel(tagOptions, tag)" class="truncate"></span>
          <svg class="select-chevron" :class="{ 'rotate-180': tagOpen }" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
          </svg>
        </button>
        <div
          x-show="tagOpen"
          x-transition:enter="transition ease-out duration-200"
          x-transition:enter-start="opacity-0 -translate-y-2"
          x-transition:enter-end="opacity-100 translate-y-0"
          x-transition:leave="transition ease-in duration-150"
          x-transition:leave-start="opacity-100 translate-y-0"
          x-transition:leave-end="opacity-0 -translate-y-2"
          class="select-dropdown max-h-64 overflow-y-auto"
          role="listbox"
          x-cloak
        >
          <template x-for="option in tagOptions" :key="option.value">
            <button
              type="button"
              @click="tag = option.value; tagOpen = false; filterAndSort()"
              class="select-option"
              :class="{ 'select-option-selected': tag === option.value }"
              role="option"
              :aria-selected="tag === option.value"
            >
              <span x-text="option.label"></span>
              <svg x-show="tag === option.value" class="select-check" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd" />
              </svg>
            </button>
          </template>
        </div>
      </div>
    )}

    <!-- Sort Dropdown -->
    <div class="relative" @click.outside="sortOpen = false">
      <label class="font-mono text-[10px] uppercase tracking-wider text-text-dim block mb-1.5">Sort</label>
      <button
        type="button"
        @click="closeAll(); sortOpen = !sortOpen"
        class="custom-select group"
        :class="{ 'custom-select-active': sort !== 'name', 'custom-select-open': sortOpen }"
        aria-haspopup="listbox"
        :aria-expanded="sortOpen"
      >
        <span x-text="getLabel(sortOptions, sort)" class="truncate"></span>
        <svg class="select-chevron" :class="{ 'rotate-180': sortOpen }" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
        </svg>
      </button>
      <div
        x-show="sortOpen"
        x-transition:enter="transition ease-out duration-200"
        x-transition:enter-start="opacity-0 -translate-y-2"
        x-transition:enter-end="opacity-100 translate-y-0"
        x-transition:leave="transition ease-in duration-150"
        x-transition:leave-start="opacity-100 translate-y-0"
        x-transition:leave-end="opacity-0 -translate-y-2"
        class="select-dropdown"
        role="listbox"
        x-cloak
      >
        <template x-for="option in sortOptions" :key="option.value">
          <button
            type="button"
            @click="sort = option.value; sortOpen = false; filterAndSort()"
            class="select-option"
            :class="{ 'select-option-selected': sort === option.value }"
            role="option"
            :aria-selected="sort === option.value"
          >
            <span x-text="option.label"></span>
            <svg x-show="sort === option.value" class="select-check" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd" />
            </svg>
          </button>
        </template>
      </div>
    </div>

    <div class="flex items-center gap-3 sm:ml-auto sm:self-end pb-0.5">
      <span class="font-mono text-xs text-text-muted whitespace-nowrap" role="status" aria-live="polite">
        <span class="text-accent">></span>
        <span x-text="visibleCount"></span> coins
      </span>
      <button
        x-show="hasActiveFilters()"
        x-transition:enter="transition ease-out duration-150"
        x-transition:enter-start="opacity-0"
        x-transition:enter-end="opacity-100"
        x-transition:leave="transition ease-in duration-100"
        x-transition:leave-start="opacity-100"
        x-transition:leave-end="opacity-0"
        @click="clearFilters()"
        class="font-mono text-[10px] uppercase tracking-wider text-text-dim hover:text-accent transition-colors whitespace-nowrap"
      >
        [Clear]
      </button>
    </div>
  </div>
  </div><!-- End Desktop Filters -->

  <!-- Empty state message -->
  <div
    x-show="visibleCount === 0"
    x-cloak
    class="mt-4 p-4 border border-border-light rounded-lg text-center mx-4 md:mx-0"
    role="status"
  >
    <p class="font-mono text-sm text-text-muted">
      <span class="text-accent">//</span> No coins match your filters
    </p>
    <button
      @click="clearFilters()"
      class="mt-2 font-mono text-xs text-accent hover:underline"
    >
      Clear all filters
    </button>
  </div>
</div>

<script>
  document.addEventListener('astro:page-load', () => {
    const filterBar = document.querySelector('[x-data]');
    if (filterBar && window.Alpine) {
      const alpineData = window.Alpine.$data(filterBar);
      if (alpineData && typeof alpineData.init === 'function') {
        alpineData.init();
      }
    }
  });
</script>

