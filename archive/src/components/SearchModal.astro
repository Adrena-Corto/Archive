---
import { getAllItems } from '../lib/items';

const items = getAllItems();
const base = import.meta.env.BASE_URL;

const searchableItems = items.map(item => ({
  id: item.id,
  name: item.name,
  category: item.category,
  era: item.era,
  period: item.period,
  material: item.material,
  image: item.images[0] ? `${base}/images/items/${item.id}/${item.images[0]}`.replace(/\/+/g, '/') : null,
  tags: item.tags,
}));
---

<div
  id="search-modal"
  x-data={`{
    open: false,
    query: '',
    results: [],
    selectedIndex: 0,
    items: ${JSON.stringify(searchableItems)},
    toggle() {
      this.open = !this.open;
      if (this.open) {
        this.query = '';
        this.search();
        this.$nextTick(() => this.$refs.searchInput?.focus());
      }
    },
    search() {
      if (!this.query.trim()) {
        this.results = this.items.slice(0, 6);
        return;
      }
      const q = this.query.toLowerCase();
      this.results = this.items.filter(item =>
        item.name.toLowerCase().includes(q) ||
        item.category.toLowerCase().includes(q) ||
        (item.period && item.period.toLowerCase().includes(q)) ||
        item.material.toLowerCase().includes(q) ||
        (item.tags && item.tags.some(t => t.toLowerCase().includes(q)))
      ).slice(0, 8);
      this.selectedIndex = 0;
    },
    handleKeydown(e) {
      if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
        e.preventDefault();
        this.toggle();
        return;
      }
      if (e.key === 'Escape' && this.open) {
        e.preventDefault();
        this.open = false;
        return;
      }
      if (!this.open) return;
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        this.selectedIndex = Math.min(this.selectedIndex + 1, this.results.length - 1);
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        this.selectedIndex = Math.max(this.selectedIndex - 1, 0);
      } else if (e.key === 'Enter' && this.results.length > 0) {
        e.preventDefault();
        this.goToItem(this.results[this.selectedIndex].id);
      }
    },
    goToItem(id) {
      this.open = false;
      window.location.href = '${base}/item/' + id;
    },
    categoryLabel(cat) {
      const labels = { coin: 'Coin', jewelry: 'Jewelry', ring: 'Ring', seal: 'Seal', misc: 'Misc' };
      return labels[cat] || cat;
    }
  }`}
  x-init="search()"
  @keydown.window="handleKeydown($event)"
  @toggle-search.window="toggle()"
  class="relative z-[200]"
  transition:persist
>
  <!-- Backdrop -->
  <div
    x-show="open"
    x-transition:enter="transition ease-out duration-200"
    x-transition:enter-start="opacity-0"
    x-transition:enter-end="opacity-100"
    x-transition:leave="transition ease-in duration-150"
    x-transition:leave-start="opacity-100"
    x-transition:leave-end="opacity-0"
    @click="open = false"
    class="fixed inset-0 bg-void/90 backdrop-blur-sm"
    x-cloak
  ></div>

  <!-- Modal -->
  <div
    x-show="open"
    x-transition:enter="transition ease-out duration-200"
    x-transition:enter-start="opacity-0 scale-95"
    x-transition:enter-end="opacity-100 scale-100"
    x-transition:leave="transition ease-in duration-150"
    x-transition:leave-start="opacity-100 scale-100"
    x-transition:leave-end="opacity-0 scale-95"
    class="fixed inset-x-4 top-[15vh] md:inset-x-auto md:left-1/2 md:-translate-x-1/2 md:w-full md:max-w-xl"
    x-cloak
  >
    <div class="bg-surface border border-border rounded-xl shadow-2xl overflow-hidden">
      <!-- Search Input -->
      <div class="flex items-center gap-3 px-4 py-3 border-b border-border">
        <svg class="w-5 h-5 text-text-dim flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
        <input
          x-ref="searchInput"
          x-model="query"
          @input="search()"
          type="text"
          placeholder="Search items..."
          class="flex-1 bg-transparent text-text placeholder-text-dim outline-none font-mono text-sm"
        />
        <kbd class="hidden sm:flex items-center gap-1 px-2 py-1 text-[10px] font-mono text-text-dim bg-surface-light rounded border border-border">
          ESC
        </kbd>
      </div>

      <!-- Results -->
      <div class="max-h-[50vh] overflow-y-auto">
        <template x-if="results.length === 0 && query.trim()">
          <div class="px-4 py-8 text-center">
            <p class="font-mono text-sm text-text-dim">No items found</p>
          </div>
        </template>

        <template x-for="(item, index) in results" :key="item.id">
          <button
            @click="goToItem(item.id)"
            @mouseenter="selectedIndex = index"
            :class="selectedIndex === index ? 'bg-accent/10 border-l-accent' : 'border-l-transparent hover:bg-surface-light'"
            class="w-full flex items-center gap-4 px-4 py-3 border-l-2 transition-colors"
          >
            <div class="w-12 h-12 rounded-lg overflow-hidden bg-surface-light flex-shrink-0">
              <template x-if="item.image">
                <img :src="item.image" :alt="item.name" class="w-full h-full object-cover" />
              </template>
              <template x-if="!item.image">
                <div class="w-full h-full flex items-center justify-center">
                  <svg class="w-5 h-5 text-text-dim" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                  </svg>
                </div>
              </template>
            </div>
            <div class="flex-1 text-left min-w-0">
              <p class="text-text font-medium truncate" x-text="item.name"></p>
              <p class="text-text-dim text-xs font-mono">
                <span x-text="categoryLabel(item.category)" class="text-accent"></span>
                <span class="mx-1">·</span>
                <span x-text="item.era"></span>
              </p>
            </div>
            <svg class="w-4 h-4 text-text-dim flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </button>
        </template>
      </div>

      <!-- Footer -->
      <div class="px-4 py-2 border-t border-border bg-surface-light/50 flex items-center justify-between">
        <div class="flex items-center gap-3 text-[10px] font-mono text-text-dim">
          <span class="flex items-center gap-1">
            <kbd class="px-1.5 py-0.5 bg-surface rounded border border-border">↑↓</kbd>
            navigate
          </span>
          <span class="flex items-center gap-1">
            <kbd class="px-1.5 py-0.5 bg-surface rounded border border-border">↵</kbd>
            select
          </span>
        </div>
        <a
          href={`${base}/search`}
          class="text-[10px] font-mono text-accent hover:underline"
        >
          Full search →
        </a>
      </div>
    </div>
  </div>
</div>
