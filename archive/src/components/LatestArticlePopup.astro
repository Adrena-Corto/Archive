---
import { getCollection } from 'astro:content';

const articles = (await getCollection('articles'))
  .filter(article => !article.data.draft)
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());

const latestArticle = articles[0];

const base = import.meta.env.BASE_URL;
function url(path: string): string {
  return `${base}${path}`.replace(/\/+/g, '/');
}

const articleUrl = url(`/articles/${latestArticle.slug}`);
const publishDate = latestArticle.data.publishDate.toLocaleDateString('en-US', {
  month: 'short',
  day: 'numeric',
  year: 'numeric'
});
---

<div
  id="latest-article-popup"
  class="fixed bottom-4 right-4 left-4 sm:left-auto sm:right-6 sm:bottom-6 z-50 sm:max-w-sm opacity-0 translate-y-4 pointer-events-none transition-all duration-500 ease-out"
  data-article-id={latestArticle.slug}
>
  <div class="glass-panel-solid border border-white/10 rounded-xl overflow-hidden shadow-2xl shadow-black/50">
    <!-- Header -->
    <div class="flex items-center justify-between px-4 py-3 border-b border-white/5 bg-white/[0.02]">
      <div class="flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-accent animate-pulse"></span>
        <span class="font-mono text-micro uppercase tracking-wider text-accent">New Article</span>
      </div>
      <button
        id="popup-dismiss"
        class="p-1 rounded-md hover:bg-white/5 transition-colors group"
        aria-label="Dismiss"
      >
        <svg class="w-4 h-4 text-text-dim group-hover:text-text transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Content -->
    <a href={articleUrl} class="block p-4 hover:bg-white/[0.02] transition-colors group">
      <p class="font-mono text-micro text-text-dim mb-2">{publishDate}</p>
      <h3 class="text-base text-text group-hover:text-accent transition-colors mb-2 line-clamp-2">
        {latestArticle.data.title}
      </h3>
      <p class="text-sm text-text-muted line-clamp-2 mb-3">
        {latestArticle.data.description}
      </p>
      <span class="inline-flex items-center gap-1.5 font-mono text-micro uppercase tracking-wider text-accent">
        Read Article
        <svg class="w-3 h-3 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </span>
    </a>
  </div>
</div>

<script>
  function initArticlePopup() {
    const popup = document.getElementById('latest-article-popup');
    const dismissBtn = document.getElementById('popup-dismiss');

    if (!popup || !dismissBtn) return;

    const articleId = popup.dataset.articleId;
    const storageKey = 'dismissed-article';
    const dismissedId = localStorage.getItem(storageKey);

    // Don't show if this article was already dismissed
    if (dismissedId === articleId) return;

    // Show popup after a short delay
    setTimeout(() => {
      popup.classList.remove('opacity-0', 'translate-y-4', 'pointer-events-none');
      popup.classList.add('opacity-100', 'translate-y-0', 'pointer-events-auto');
    }, 2000);

    // Dismiss handler
    const dismiss = () => {
      popup.classList.remove('opacity-100', 'translate-y-0', 'pointer-events-auto');
      popup.classList.add('opacity-0', 'translate-y-4', 'pointer-events-none');
      localStorage.setItem(storageKey, articleId || '');
    };

    dismissBtn.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      dismiss();
    });

    // Also dismiss when clicking the article link (after navigation starts)
    const link = popup.querySelector('a');
    if (link) {
      link.addEventListener('click', () => {
        localStorage.setItem(storageKey, articleId || '');
      });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initArticlePopup);
  } else {
    initArticlePopup();
  }

  document.addEventListener('astro:page-load', initArticlePopup);
</script>
