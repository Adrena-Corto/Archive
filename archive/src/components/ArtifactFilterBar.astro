---
import { getArtifacts, getArtifactCategories, getAllTags } from '../lib/items';

const artifacts = getArtifacts();
const categories = getArtifactCategories();
const materials = [...new Set(artifacts.map(a => a.material))].sort();
const periods = [...new Set(artifacts.map(a => a.period))].sort();
const tags = [...new Set(artifacts.flatMap(a => a.tags))].sort();
const totalArtifacts = artifacts.length;

const categoryLabels: Record<string, string> = {
  jewelry: 'Jewelry',
  ring: 'Rings',
  seal: 'Seals',
  misc: 'Misc',
};

const categoryOptions = [
  { value: 'all', label: 'All Categories' },
  ...categories.map(cat => ({ value: cat, label: categoryLabels[cat] || cat }))
];

const materialOptions = [
  { value: 'all', label: 'All Materials' },
  ...materials.map(mat => ({ value: mat, label: mat.charAt(0).toUpperCase() + mat.slice(1) }))
];

const periodOptions = [
  { value: 'all', label: 'All Periods' },
  ...periods.map(p => ({ value: p, label: p }))
];

const tagOptions = [
  { value: 'all', label: 'All Tags' },
  ...tags.map(t => ({ value: t, label: t.charAt(0).toUpperCase() + t.slice(1) }))
];

const sortOptions = [
  { value: 'name', label: 'Name A-Z' },
  { value: 'era-oldest', label: 'Era (Oldest)' },
  { value: 'era-newest', label: 'Era (Newest)' },
  { value: 'recent', label: 'Recently Added' },
];
---

<div
  x-data={`{
    category: 'all',
    material: 'all',
    period: 'all',
    tag: 'all',
    sort: 'name',
    categoryOpen: false,
    materialOpen: false,
    periodOpen: false,
    tagOpen: false,
    sortOpen: false,
    mobileSortOpen: false,
    mobileExpanded: false,
    visibleCount: ${totalArtifacts},
    totalItems: ${totalArtifacts},
    categoryOptions: ${JSON.stringify(categoryOptions)},
    categoryLabels: ${JSON.stringify(categoryLabels)},
    materialOptions: ${JSON.stringify(materialOptions)},
    periodOptions: ${JSON.stringify(periodOptions)},
    tagOptions: ${JSON.stringify(tagOptions)},
    sortOptions: ${JSON.stringify(sortOptions)},
    init() {
      const params = new URLSearchParams(window.location.search);
      if (params.get('category')) this.category = params.get('category');
      if (params.get('material')) this.material = params.get('material');
      if (params.get('period')) this.period = params.get('period');
      if (params.get('tag')) this.tag = params.get('tag');
      if (params.get('sort')) this.sort = params.get('sort');
      this.filterAndSort();
    },
    getFilterSummary() {
      const parts = [];
      if (this.category !== 'all') parts.push(this.categoryLabels[this.category] || this.category);
      if (this.material !== 'all') parts.push(this.material.charAt(0).toUpperCase() + this.material.slice(1));
      if (this.period !== 'all') parts.push(this.period);
      if (this.tag !== 'all') parts.push(this.tag);
      if (parts.length === 0) return 'All Artifacts';
      if (parts.length <= 2) return parts.join(' · ');
      return parts.slice(0, 2).join(' · ') + ' +' + (parts.length - 2);
    },
    activeFilterCount() {
      let count = 0;
      if (this.category !== 'all') count++;
      if (this.material !== 'all') count++;
      if (this.period !== 'all') count++;
      if (this.tag !== 'all') count++;
      return count;
    },
    updateURL() {
      const params = new URLSearchParams();
      if (this.category !== 'all') params.set('category', this.category);
      if (this.material !== 'all') params.set('material', this.material);
      if (this.period !== 'all') params.set('period', this.period);
      if (this.tag !== 'all') params.set('tag', this.tag);
      if (this.sort !== 'name') params.set('sort', this.sort);
      const newURL = params.toString() ? '?' + params.toString() : window.location.pathname;
      window.history.replaceState({}, '', newURL);
    },
    filtering: false,
    filterAndSort() {
      this.filtering = true;
      const grid = document.getElementById('artifact-grid');
      if (grid) grid.style.opacity = '0.5';

      requestAnimationFrame(() => {
        const items = Array.from(document.querySelectorAll('[data-category]'));
        let count = 0;

        items.forEach(item => {
          const matchCategory = this.category === 'all' || item.dataset.category === this.category;
          const matchMaterial = this.material === 'all' || item.dataset.material === this.material;
          const matchPeriod = this.period === 'all' || item.dataset.period === this.period;
          const matchTag = this.tag === 'all' || (item.dataset.tags && item.dataset.tags.split(',').includes(this.tag));
          const visible = matchCategory && matchMaterial && matchPeriod && matchTag;
          item.style.display = visible ? '' : 'none';
          if (visible) count++;
        });

        const visibleItems = items.filter(item => item.style.display !== 'none');
        visibleItems.sort((a, b) => {
          if (this.sort === 'name') {
            return (a.dataset.name || '').localeCompare(b.dataset.name || '');
          } else if (this.sort === 'era-oldest') {
            return parseInt(a.dataset.year || '0') - parseInt(b.dataset.year || '0');
          } else if (this.sort === 'era-newest') {
            return parseInt(b.dataset.year || '0') - parseInt(a.dataset.year || '0');
          } else if (this.sort === 'recent') {
            const dateA = a.dataset.dateAdded || '1970-01-01';
            const dateB = b.dataset.dateAdded || '1970-01-01';
            return dateB.localeCompare(dateA);
          }
          return 0;
        });

        const gridEl = document.getElementById('item-grid');
        if (gridEl) {
          visibleItems.forEach(item => gridEl.appendChild(item));
        }

        this.visibleCount = count;
        this.updateURL();

        if (grid) grid.style.opacity = '1';
        this.filtering = false;
      });
    },
    clearFilters() {
      this.category = 'all';
      this.material = 'all';
      this.period = 'all';
      this.tag = 'all';
      this.filterAndSort();
    },
    hasActiveFilters() {
      return this.category !== 'all' || this.material !== 'all' || this.period !== 'all' || this.tag !== 'all';
    },
    closeAll() {
      this.categoryOpen = false;
      this.materialOpen = false;
      this.periodOpen = false;
      this.tagOpen = false;
      this.sortOpen = false;
      this.mobileSortOpen = false;
    },
    closeMobileFilters() {
      this.mobileExpanded = false;
      this.closeAll();
    },
    getLabel(options, value) {
      const opt = options.find(o => o.value === value);
      return opt ? opt.label : value;
    }
  }`}
  x-init="init()"
  @keydown.escape.window="closeAll(); mobileExpanded = false"
  class="artifact-filter-bar md:glass-panel md:p-4 mb-8 overflow-visible relative z-40"
>
  <!-- Mobile Collapsed Bar (visible on mobile only) -->
  <div class="mobile-filter-header md:hidden sticky top-[57px] z-40 bg-void/95 backdrop-blur-xl border-b border-white/10">
    <div class="flex items-center gap-3 px-4 py-3">
      <!-- Filter Toggle Button -->
      <button
        type="button"
        @click="mobileExpanded = !mobileExpanded"
        class="flex items-center gap-2 px-3 py-2 bg-surface-light/50 border border-border rounded-lg font-mono text-xs text-text-muted hover:text-text hover:border-border-light transition-all"
        :class="{ 'border-accent/50 text-accent': mobileExpanded || hasActiveFilters() }"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z" />
        </svg>
        <span x-text="getFilterSummary()"></span>
        <span
          x-show="activeFilterCount() > 0"
          x-text="activeFilterCount()"
          class="inline-flex items-center justify-center min-w-[18px] h-[18px] px-1 bg-accent/20 text-accent text-micro rounded-full"
        ></span>
      </button>

      <!-- Mobile Sort Dropdown -->
      <div class="relative ml-auto" @click.outside="mobileSortOpen = false">
        <button
          type="button"
          @click="mobileSortOpen = !mobileSortOpen"
          class="flex items-center gap-1.5 px-2.5 py-2 bg-surface-light/50 border border-border rounded-lg font-mono text-tiny text-text-muted"
          :class="{ 'border-accent/30 text-accent': sort !== 'name' }"
        >
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4h13M3 8h9m-9 4h6m4 0l4-4m0 0l4 4m-4-4v12" />
          </svg>
          <span x-text="getLabel(sortOptions, sort)"></span>
        </button>
        <div
          x-show="mobileSortOpen"
          x-transition:enter="transition ease-out duration-150"
          x-transition:enter-start="opacity-0 -translate-y-1"
          x-transition:enter-end="opacity-100 translate-y-0"
          x-transition:leave="transition ease-in duration-100"
          x-transition:leave-start="opacity-100"
          x-transition:leave-end="opacity-0"
          class="absolute right-0 top-full mt-1 min-w-[140px] py-1 bg-surface-elevated border border-border-light rounded-lg shadow-xl z-50"
          x-cloak
        >
          <template x-for="option in sortOptions" :key="option.value">
            <button
              type="button"
              @click="sort = option.value; mobileSortOpen = false; filterAndSort()"
              class="w-full px-3 py-2 text-left font-mono text-tiny text-text-muted hover:bg-white/5 hover:text-text"
              :class="{ 'text-accent bg-accent/5': sort === option.value }"
            >
              <span x-text="option.label"></span>
            </button>
          </template>
        </div>
      </div>

      <!-- Artifact Count -->
      <span class="font-mono text-tiny text-text-dim whitespace-nowrap">
        <span class="text-accent" x-text="visibleCount"></span>
      </span>
    </div>
  </div>

  <!-- Mobile Expanded Filters -->
  <div
    x-show="mobileExpanded"
    x-transition:enter="transition ease-out duration-200"
    x-transition:enter-start="opacity-0 -translate-y-2"
    x-transition:enter-end="opacity-100 translate-y-0"
    x-transition:leave="transition ease-in duration-150"
    x-transition:leave-start="opacity-100 translate-y-0"
    x-transition:leave-end="opacity-0 -translate-y-2"
    class="md:hidden bg-surface/95 backdrop-blur-xl border-b border-white/10 px-4 py-4"
    x-cloak
  >
    <!-- Category & Material Row -->
    <div class="grid grid-cols-2 gap-3 mb-3">
      <div>
        <label class="mobile-filter-label">Category</label>
        <select
          x-model="category"
          @change="filterAndSort()"
          class="mobile-select"
        >
          {categoryOptions.map(opt => (
            <option value={opt.value}>{opt.label}</option>
          ))}
        </select>
      </div>
      {materials.length > 0 && (
        <div>
          <label class="mobile-filter-label">Material</label>
          <select
            x-model="material"
            @change="filterAndSort()"
            class="mobile-select"
          >
            {materialOptions.map(opt => (
              <option value={opt.value}>{opt.label}</option>
            ))}
          </select>
        </div>
      )}
    </div>

    <!-- Period & Tag Row -->
    <div class="grid grid-cols-2 gap-3 mb-4">
      {periods.length > 0 && (
        <div>
          <label class="mobile-filter-label">Period</label>
          <select
            x-model="period"
            @change="filterAndSort()"
            class="mobile-select"
          >
            {periodOptions.map(opt => (
              <option value={opt.value}>{opt.label}</option>
            ))}
          </select>
        </div>
      )}
      {tags.length > 0 && (
        <div>
          <label class="mobile-filter-label">Tag</label>
          <select
            x-model="tag"
            @change="filterAndSort()"
            class="mobile-select"
          >
            {tagOptions.map(opt => (
              <option value={opt.value}>{opt.label}</option>
            ))}
          </select>
        </div>
      )}
    </div>

    <!-- Action Row (Mobile) -->
    <div class="flex items-center justify-between pt-3 border-t border-white/5">
      <button
        x-show="hasActiveFilters()"
        @click="clearFilters()"
        class="font-mono text-tiny text-text-dim hover:text-accent transition-colors"
      >[Clear All]</button>
      <span x-show="!hasActiveFilters()" class="font-mono text-tiny text-text-dim">
        <span class="text-accent" x-text="visibleCount"></span> artifacts
      </span>
      <button
        type="button"
        @click="closeMobileFilters()"
        class="px-4 py-2 bg-accent/10 border border-accent/50 rounded-lg font-mono text-xs text-accent hover:bg-accent/20 transition-colors"
      >Done</button>
    </div>
  </div>

  <!-- Desktop Filters (hidden on mobile) -->
  <div class="hidden md:flex flex-col sm:flex-row sm:flex-wrap sm:items-center gap-4 md:gap-6">
    <!-- Category Dropdown -->
    <div class="relative" @click.outside="categoryOpen = false">
      <label class="font-mono text-micro uppercase tracking-wider text-text-dim block mb-1.5">Category</label>
      <button
        type="button"
        @click="categoryOpen = !categoryOpen; materialOpen = false; periodOpen = false"
        class="custom-select group"
        :class="{ 'custom-select-active': category !== 'all', 'custom-select-open': categoryOpen }"
        aria-haspopup="listbox"
        :aria-expanded="categoryOpen"
      >
        <span x-text="getLabel(categoryOptions, category)" class="truncate"></span>
        <svg class="select-chevron" :class="{ 'rotate-180': categoryOpen }" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
        </svg>
      </button>
      <div
        x-show="categoryOpen"
        x-transition:enter="transition ease-out duration-200"
        x-transition:enter-start="opacity-0 -translate-y-2"
        x-transition:enter-end="opacity-100 translate-y-0"
        x-transition:leave="transition ease-in duration-150"
        x-transition:leave-start="opacity-100 translate-y-0"
        x-transition:leave-end="opacity-0 -translate-y-2"
        class="select-dropdown"
        role="listbox"
        x-cloak
      >
        <template x-for="option in categoryOptions" :key="option.value">
          <button
            type="button"
            @click="category = option.value; categoryOpen = false; filterAndSort()"
            class="select-option"
            :class="{ 'select-option-selected': category === option.value }"
            role="option"
            :aria-selected="category === option.value"
          >
            <span x-text="option.label"></span>
            <svg x-show="category === option.value" class="select-check" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd" />
            </svg>
          </button>
        </template>
      </div>
    </div>

    <!-- Material Dropdown -->
    {materials.length > 0 && (
      <div class="relative" @click.outside="materialOpen = false">
        <label class="font-mono text-micro uppercase tracking-wider text-text-dim block mb-1.5">Material</label>
        <button
          type="button"
          @click="materialOpen = !materialOpen; categoryOpen = false; periodOpen = false"
          class="custom-select group"
          :class="{ 'custom-select-active': material !== 'all', 'custom-select-open': materialOpen }"
          aria-haspopup="listbox"
          :aria-expanded="materialOpen"
        >
          <span x-text="getLabel(materialOptions, material)" class="truncate"></span>
          <svg class="select-chevron" :class="{ 'rotate-180': materialOpen }" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
          </svg>
        </button>
        <div
          x-show="materialOpen"
          x-transition:enter="transition ease-out duration-200"
          x-transition:enter-start="opacity-0 -translate-y-2"
          x-transition:enter-end="opacity-100 translate-y-0"
          x-transition:leave="transition ease-in duration-150"
          x-transition:leave-start="opacity-100 translate-y-0"
          x-transition:leave-end="opacity-0 -translate-y-2"
          class="select-dropdown"
          role="listbox"
          x-cloak
        >
          <template x-for="option in materialOptions" :key="option.value">
            <button
              type="button"
              @click="material = option.value; materialOpen = false; filterAndSort()"
              class="select-option"
              :class="{ 'select-option-selected': material === option.value }"
              role="option"
              :aria-selected="material === option.value"
            >
              <span x-text="option.label"></span>
              <svg x-show="material === option.value" class="select-check" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd" />
              </svg>
            </button>
          </template>
        </div>
      </div>
    )}

    <!-- Period Dropdown -->
    {periods.length > 0 && (
      <div class="relative" @click.outside="periodOpen = false">
        <label class="font-mono text-micro uppercase tracking-wider text-text-dim block mb-1.5">Period</label>
        <button
          type="button"
          @click="periodOpen = !periodOpen; closeAll(); periodOpen = true"
          class="custom-select group"
          :class="{ 'custom-select-active': period !== 'all', 'custom-select-open': periodOpen }"
          aria-haspopup="listbox"
          :aria-expanded="periodOpen"
        >
          <span x-text="getLabel(periodOptions, period)" class="truncate"></span>
          <svg class="select-chevron" :class="{ 'rotate-180': periodOpen }" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
          </svg>
        </button>
        <div
          x-show="periodOpen"
          x-transition:enter="transition ease-out duration-200"
          x-transition:enter-start="opacity-0 -translate-y-2"
          x-transition:enter-end="opacity-100 translate-y-0"
          x-transition:leave="transition ease-in duration-150"
          x-transition:leave-start="opacity-100 translate-y-0"
          x-transition:leave-end="opacity-0 -translate-y-2"
          class="select-dropdown"
          role="listbox"
          x-cloak
        >
          <template x-for="option in periodOptions" :key="option.value">
            <button
              type="button"
              @click="period = option.value; periodOpen = false; filterAndSort()"
              class="select-option"
              :class="{ 'select-option-selected': period === option.value }"
              role="option"
              :aria-selected="period === option.value"
            >
              <span x-text="option.label"></span>
              <svg x-show="period === option.value" class="select-check" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd" />
              </svg>
            </button>
          </template>
        </div>
      </div>
    )}

    <!-- Tag Dropdown -->
    {tags.length > 0 && (
      <div class="relative" @click.outside="tagOpen = false">
        <label class="font-mono text-micro uppercase tracking-wider text-text-dim block mb-1.5">Tag</label>
        <button
          type="button"
          @click="closeAll(); tagOpen = !tagOpen"
          class="custom-select group"
          :class="{ 'custom-select-active': tag !== 'all', 'custom-select-open': tagOpen }"
          aria-haspopup="listbox"
          :aria-expanded="tagOpen"
        >
          <span x-text="getLabel(tagOptions, tag)" class="truncate"></span>
          <svg class="select-chevron" :class="{ 'rotate-180': tagOpen }" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
          </svg>
        </button>
        <div
          x-show="tagOpen"
          x-transition:enter="transition ease-out duration-200"
          x-transition:enter-start="opacity-0 -translate-y-2"
          x-transition:enter-end="opacity-100 translate-y-0"
          x-transition:leave="transition ease-in duration-150"
          x-transition:leave-start="opacity-100 translate-y-0"
          x-transition:leave-end="opacity-0 -translate-y-2"
          class="select-dropdown max-h-64 overflow-y-auto"
          role="listbox"
          x-cloak
        >
          <template x-for="option in tagOptions" :key="option.value">
            <button
              type="button"
              @click="tag = option.value; tagOpen = false; filterAndSort()"
              class="select-option"
              :class="{ 'select-option-selected': tag === option.value }"
              role="option"
              :aria-selected="tag === option.value"
            >
              <span x-text="option.label"></span>
              <svg x-show="tag === option.value" class="select-check" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd" />
              </svg>
            </button>
          </template>
        </div>
      </div>
    )}

    <!-- Sort Dropdown -->
    <div class="relative" @click.outside="sortOpen = false">
      <label class="font-mono text-micro uppercase tracking-wider text-text-dim block mb-1.5">Sort</label>
      <button
        type="button"
        @click="closeAll(); sortOpen = !sortOpen"
        class="custom-select group"
        :class="{ 'custom-select-active': sort !== 'name', 'custom-select-open': sortOpen }"
        aria-haspopup="listbox"
        :aria-expanded="sortOpen"
      >
        <span x-text="getLabel(sortOptions, sort)" class="truncate"></span>
        <svg class="select-chevron" :class="{ 'rotate-180': sortOpen }" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
        </svg>
      </button>
      <div
        x-show="sortOpen"
        x-transition:enter="transition ease-out duration-200"
        x-transition:enter-start="opacity-0 -translate-y-2"
        x-transition:enter-end="opacity-100 translate-y-0"
        x-transition:leave="transition ease-in duration-150"
        x-transition:leave-start="opacity-100 translate-y-0"
        x-transition:leave-end="opacity-0 -translate-y-2"
        class="select-dropdown"
        role="listbox"
        x-cloak
      >
        <template x-for="option in sortOptions" :key="option.value">
          <button
            type="button"
            @click="sort = option.value; sortOpen = false; filterAndSort()"
            class="select-option"
            :class="{ 'select-option-selected': sort === option.value }"
            role="option"
            :aria-selected="sort === option.value"
          >
            <span x-text="option.label"></span>
            <svg x-show="sort === option.value" class="select-check" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd" />
            </svg>
          </button>
        </template>
      </div>
    </div>

    <div class="flex items-center gap-4 sm:ml-auto pt-2 sm:pt-0 border-t sm:border-t-0 border-white/5">
      <span class="font-mono text-xs text-text-muted" role="status" aria-live="polite">
        <span class="text-accent">></span>
        <span x-text="visibleCount"></span> artifacts
      </span>
      <button
        x-show="hasActiveFilters()"
        @click="clearFilters()"
        class="font-mono text-micro uppercase tracking-wider text-text-dim hover:text-accent transition-colors"
      >
        [Clear]
      </button>
    </div>
  </div><!-- End Desktop Filters -->

  <!-- Empty state message -->
  <div
    x-show="visibleCount === 0"
    x-cloak
    class="mt-4 p-4 border border-border-light rounded-lg text-center mx-4 md:mx-0"
    role="status"
  >
    <p class="font-mono text-sm text-text-muted">
      <span class="text-accent">//</span> No artifacts match your filters
    </p>
    <button
      @click="clearFilters()"
      class="mt-2 font-mono text-xs text-accent hover:underline"
    >
      Clear all filters
    </button>
  </div>
</div>

<script>
  // Defer filter initialization to reduce TBT
  function initArtifactFilters() {
    const filterBar = document.querySelector('[x-data]');
    if (filterBar && window.Alpine) {
      const alpineData = window.Alpine.$data(filterBar);
      if (alpineData && typeof alpineData.init === 'function') {
        alpineData.init();
      }
    }
  }

  function scheduleFilterInit() {
    if ('requestIdleCallback' in window) {
      requestIdleCallback(initArtifactFilters, { timeout: 1500 });
    } else {
      setTimeout(initArtifactFilters, 50);
    }
  }

  document.addEventListener('astro:page-load', scheduleFilterInit);
</script>

