---
import type { CoinItem } from '../lib/items';
import { parseYearFromEra } from '../lib/items';
import BlurImage from './BlurImage.astro';

interface Props {
  coin: CoinItem;
  priority?: boolean;
}

const { coin, priority = false } = Astro.props;
const base = import.meta.env.BASE_URL;
function url(path: string): string {
  return `${base}${path}`.replace(/\/+/g, '/');
}
const imagePath = coin.images[0] ? `/images/items/${coin.id}/${coin.images[0]}` : null;
const yearStart = parseYearFromEra(coin.era);
---

<a
  href={url(`/item/${coin.id}`)}
  class="group block glass-panel-solid overflow-hidden card-hover reveal"
  data-coin-item
  data-empire={coin.empire || ''}
  data-ruler={coin.ruler || ''}
  data-denomination={coin.denomination || ''}
  data-material={coin.material}
  data-period={coin.period}
  data-name={coin.name}
  data-year={yearStart}
  data-date-added={coin.dateAdded || ''}
  data-tags={coin.tags.join(',')}
>
  <div class="aspect-square bg-surface-light overflow-hidden relative">
    {imagePath ? (
      <BlurImage
        src={imagePath}
        alt={coin.name}
        width={400}
        height={400}
        class="brightness-90 group-hover:brightness-110 transition-[filter] duration-300"
        priority={priority}
      />
    ) : (
      <div class="w-full h-full flex flex-col items-center justify-center gap-2 bg-surface">
        <svg class="w-8 h-8 text-text-dim" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
        </svg>
        <span class="font-mono text-[10px] text-text-dim uppercase tracking-wider">No Image</span>
      </div>
    )}
    <div class="absolute inset-0 bg-gradient-to-t from-surface/80 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none" />
  </div>

  <div class="p-4 space-y-3">
    <div class="flex items-center gap-2">
      {coin.denomination && (
        <span class="font-mono text-[10px] uppercase tracking-wider text-accent">
          {coin.denomination}
        </span>
      )}
      {coin.denomination && coin.ruler && <span class="text-text-dim">·</span>}
      {coin.ruler && (
        <span class="font-mono text-[10px] uppercase tracking-wider text-text-dim truncate">
          {coin.ruler}
        </span>
      )}
      {!coin.denomination && !coin.ruler && (
        <span class="font-mono text-[10px] uppercase tracking-wider text-accent">
          COIN
        </span>
      )}
    </div>

    <div class="border-t border-border pt-3">
      <h3 class="text-lg text-text leading-tight group-hover:text-accent transition-colors duration-300 line-clamp-2 min-h-[2.5rem]">
        {coin.name}
      </h3>
    </div>

    <div class="space-y-1.5 pt-2">
      <div class="flex items-center justify-between">
        <span class="data-label">Era</span>
        <span class="data-value">{coin.era}</span>
      </div>
      <div class="flex items-center justify-between">
        <span class="data-label">Material</span>
        <span class="data-value capitalize">{coin.material}</span>
      </div>
      {coin.weight && (
        <div class="flex items-center justify-between">
          <span class="data-label">Weight</span>
          <span class="data-value">{coin.weight}</span>
        </div>
      )}
    </div>
  </div>
</a>

