---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { getAllItems, getItemById, getRelatedItems } from '../../lib/items';
import type { Item } from '../../lib/items';
import thumbhashManifest from '../../data/thumbhash-manifest.json';

export async function getStaticPaths() {
  const items = getAllItems();
  return items.map((item) => ({
    params: { id: item.id },
    props: { item },
  }));
}

interface Props {
  item: Item;
}

const { item } = Astro.props;

const categoryLabels: Record<Item['category'], string> = {
  coin: 'Coin',
  jewelry: 'Jewelry',
  ring: 'Ring',
  seal: 'Seal',
  misc: 'Miscellaneous',
};

const allItems = getAllItems();
const currentIndex = allItems.findIndex(i => i.id === item.id);
const prevItem = currentIndex > 0 ? allItems[currentIndex - 1] : null;
const nextItem = currentIndex < allItems.length - 1 ? allItems[currentIndex + 1] : null;
const relatedItems = getRelatedItems(item, 3);
const base = import.meta.env.BASE_URL;

function url(path: string): string {
  return `${base}${path}`.replace(/\/+/g, '/');
}

function getThumbhash(imagePath: string): string | null {
  return (thumbhashManifest as Record<string, string>)[imagePath] || null;
}

function getOptimizedSrc(imageName: string) {
  const basePath = `/images/items/${item.id}/${imageName.replace(/\.(jpg|jpeg|png)$/i, '')}`;
  return {
    thumb: `${basePath}-thumb.webp`,
    medium: `${basePath}-medium.webp`,
    original: `/images/items/${item.id}/${imageName}`,
  };
}

const imageThumbhashes = item.images.map(image => {
  const path = `/images/items/${item.id}/${image}`;
  const optimized = getOptimizedSrc(image);
  return { path, thumbhash: getThumbhash(path), optimized };
});

const siteUrl = 'https://theantiquearchive.com';
const breadcrumbItems = item.category === 'coin'
  ? [
      { name: 'Home', url: siteUrl },
      { name: 'Coins', url: `${siteUrl}/coins` },
      { name: item.name, url: `${siteUrl}/item/${item.id}` }
    ]
  : [
      { name: 'Home', url: siteUrl },
      { name: 'Artifacts', url: `${siteUrl}/artifacts` },
      { name: item.name, url: `${siteUrl}/item/${item.id}` }
    ];

const itemStructuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Product",
      "name": item.name,
      "description": item.description,
      "category": categoryLabels[item.category],
      "material": item.material,
      "image": item.images.length > 0 ? `${siteUrl}${url(`/images/items/${item.id}/${item.images[0]}`)}` : undefined,
      "additionalProperty": [
        { "@type": "PropertyValue", "name": "Era", "value": item.era },
        { "@type": "PropertyValue", "name": "Period", "value": item.period },
        { "@type": "PropertyValue", "name": "Origin", "value": item.origin },
        ...(item.weight ? [{ "@type": "PropertyValue", "name": "Weight", "value": item.weight }] : []),
        ...(item.dimensions ? [{ "@type": "PropertyValue", "name": "Dimensions", "value": item.dimensions }] : []),
        ...(item.condition ? [{ "@type": "PropertyValue", "name": "Condition", "value": item.condition }] : [])
      ]
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": breadcrumbItems.map((item, index) => ({
        "@type": "ListItem",
        "position": index + 1,
        "name": item.name,
        "item": item.url
      }))
    }
  ]
};
---

<BaseLayout title={`${item.name} | The Antique Archive`} description={item.description} structuredData={itemStructuredData} image={item.images.length > 0 ? url(`/images/items/${item.id}/${item.images[0]}`) : undefined}>
  <article class="relative py-16 min-h-screen w-full overflow-x-hidden" data-pagefind-body>

    <div class="container-narrow relative w-full">
      <div data-pagefind-ignore>
        <Breadcrumb items={item.category === 'coin' ? [
          { label: 'Coins', href: url('/coins') },
          { label: item.name }
        ] : [
          { label: 'Artifacts', href: url('/artifacts') },
          { label: categoryLabels[item.category], href: url(`/artifacts?category=${item.category}`) },
          { label: item.name }
        ]} />
      </div>

      <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 w-full max-w-full">
        <div x-data={`{
          activeImage: 0,
          lightboxOpen: false,
          totalImages: ${item.images.length},
          magnifier: { active: false, x: 0, y: 0, bgX: 0, bgY: 0, bgW: 0, bgH: 0, imgSrc: '', zoom: 2.5, size: 150, viewX: 0, viewY: 0, viewW: 0, viewH: 0 },
          lbMagnifier: { active: false, x: 0, y: 0, bgX: 0, bgY: 0, bgW: 0, bgH: 0, imgSrc: '', zoom: 3, size: 200, viewX: 0, viewY: 0, viewW: 0, viewH: 0 },
          touchMagnifier: { active: false, x: 0, y: 0, bgX: 0, bgY: 0, bgW: 0, bgH: 0, imgSrc: '', zoom: 2.5, size: 120 },
          swipe: { startX: 0, startY: 0, startTime: 0, swiping: false },
          openLightbox(index) {
            this.activeImage = index;
            this.lightboxOpen = true;
            document.body.style.overflow = 'hidden';
          },
          closeLightbox() {
            this.lightboxOpen = false;
            document.body.style.overflow = '';
          },
          nextImage() {
            this.activeImage = (this.activeImage + 1) % this.totalImages;
          },
          prevImage() {
            this.activeImage = (this.activeImage - 1 + this.totalImages) % this.totalImages;
          },
          handleMagnifier(e) {
            const img = e.target;
            const rect = img.getBoundingClientRect();
            const x = e.clientX - rect.left;
            const y = e.clientY - rect.top;
            const zoom = this.magnifier.zoom;
            const size = this.magnifier.size;
            this.magnifier.x = e.clientX - size / 2;
            this.magnifier.y = e.clientY - size / 2;
            this.magnifier.bgX = -(x * zoom - size / 2);
            this.magnifier.bgY = -(y * zoom - size / 2);
            this.magnifier.bgW = rect.width * zoom;
            this.magnifier.bgH = rect.height * zoom;
            this.magnifier.imgSrc = img.src;
            this.magnifier.viewX = (x / rect.width) * 100;
            this.magnifier.viewY = (y / rect.height) * 100;
            this.magnifier.viewW = (size / zoom / rect.width) * 100;
            this.magnifier.viewH = (size / zoom / rect.height) * 100;
          },
          showMagnifier(e) {
            this.magnifier.active = true;
            this.handleMagnifier(e);
          },
          hideMagnifier() {
            this.magnifier.active = false;
          },
          handleLbMagnifier(e) {
            const img = e.target;
            const rect = img.getBoundingClientRect();
            const x = e.clientX - rect.left;
            const y = e.clientY - rect.top;
            const zoom = this.lbMagnifier.zoom;
            const size = this.lbMagnifier.size;
            this.lbMagnifier.x = e.clientX - size / 2;
            this.lbMagnifier.y = e.clientY - size / 2;
            this.lbMagnifier.bgX = -(x * zoom - size / 2);
            this.lbMagnifier.bgY = -(y * zoom - size / 2);
            this.lbMagnifier.bgW = rect.width * zoom;
            this.lbMagnifier.bgH = rect.height * zoom;
            this.lbMagnifier.imgSrc = img.src;
            this.lbMagnifier.viewX = (x / rect.width) * 100;
            this.lbMagnifier.viewY = (y / rect.height) * 100;
            this.lbMagnifier.viewW = (size / zoom / rect.width) * 100;
            this.lbMagnifier.viewH = (size / zoom / rect.height) * 100;
          },
          showLbMagnifier(e) {
            this.lbMagnifier.active = true;
            this.handleLbMagnifier(e);
          },
          hideLbMagnifier() {
            this.lbMagnifier.active = false;
          },
          handleTouchStart(e) {
            if (e.touches.length === 1) {
              this.swipe.startX = e.touches[0].clientX;
              this.swipe.startY = e.touches[0].clientY;
              this.swipe.startTime = Date.now();
              this.swipe.swiping = true;
            }
          },
          handleTouchMove(e) {
            if (!this.swipe.swiping || e.touches.length !== 1) return;
            const deltaX = e.touches[0].clientX - this.swipe.startX;
            const deltaY = Math.abs(e.touches[0].clientY - this.swipe.startY);
            if (Math.abs(deltaX) > 10 && deltaY < 50) {
              e.preventDefault();
            }
          },
          handleTouchEnd(e) {
            if (!this.swipe.swiping) return;
            const touch = e.changedTouches[0];
            const deltaX = touch.clientX - this.swipe.startX;
            const deltaY = Math.abs(touch.clientY - this.swipe.startY);
            const deltaTime = Date.now() - this.swipe.startTime;
            this.swipe.swiping = false;
            if (deltaTime < 300 && Math.abs(deltaX) > 50 && deltaY < 100 && this.totalImages > 1) {
              if (deltaX > 0) {
                this.prevImage();
              } else {
                this.nextImage();
              }
            }
          },
          handleTouchMagnifier(e) {
            if (e.touches.length !== 1) return;
            const touch = e.touches[0];
            const img = e.target;
            const rect = img.getBoundingClientRect();
            const x = touch.clientX - rect.left;
            const y = touch.clientY - rect.top;
            const zoom = this.touchMagnifier.zoom;
            const size = this.touchMagnifier.size;
            this.touchMagnifier.x = touch.clientX - size / 2;
            this.touchMagnifier.y = touch.clientY - size - 40;
            this.touchMagnifier.bgX = -(x * zoom - size / 2);
            this.touchMagnifier.bgY = -(y * zoom - size / 2);
            this.touchMagnifier.bgW = rect.width * zoom;
            this.touchMagnifier.bgH = rect.height * zoom;
            this.touchMagnifier.imgSrc = img.src;
          },
          showTouchMagnifier(e) {
            e.preventDefault();
            this.touchMagnifier.active = true;
            this.handleTouchMagnifier(e);
          },
          hideTouchMagnifier() {
            this.touchMagnifier.active = false;
          }
        }`}
        @keydown.arrow-left.window="if(lightboxOpen) prevImage(); else if(totalImages > 1) { activeImage = (activeImage - 1 + totalImages) % totalImages }"
        @keydown.arrow-right.window="if(lightboxOpen) nextImage(); else if(totalImages > 1) { activeImage = (activeImage + 1) % totalImages }"
        @keydown.escape.window="closeLightbox()"
        class="space-y-4 w-full max-w-full">
          {item.images.length > 0 ? (
            <>
              <div
                class="glass-panel overflow-hidden w-full max-w-full rounded-lg relative touch-manipulation"
                @touchstart="handleTouchStart($event)"
                @touchmove="handleTouchMove($event)"
                @touchend="handleTouchEnd($event)"
              >
                {imageThumbhashes.map(({ path, thumbhash, optimized }, index) => (
                  <div
                    x-show={`activeImage === ${index}`}
                    x-transition:enter="transition ease-out duration-300"
                    x-transition:enter-start="opacity-0"
                    x-transition:enter-end="opacity-100"
                    class="relative"
                  >
                    {thumbhash && (
                      <canvas
                        class="detail-placeholder absolute inset-0 w-full h-full object-cover pointer-events-none"
                        data-thumbhash={thumbhash}
                        style="filter: blur(20px); transform: scale(1.1);"
                        aria-hidden="true"
                      />
                    )}
                    <picture>
                      <source
                        type="image/webp"
                        srcset={`${optimized.thumb} 400w, ${optimized.medium} 800w`}
                        sizes="(max-width: 1024px) 100vw, 50vw"
                      />
                      <img
                        @mouseenter="showMagnifier($event)"
                        @mousemove="handleMagnifier($event)"
                        @mouseleave="hideMagnifier()"
                        @click="openLightbox(activeImage)"
                        @touchstart.passive="showTouchMagnifier($event)"
                        @touchmove.prevent="handleTouchMagnifier($event)"
                        @touchend="hideTouchMagnifier()"
                        src={optimized.medium}
                        alt={`${item.name} - Image ${index + 1}`}
                        width="1400"
                        height="933"
                        class="detail-image w-full h-auto cursor-zoom-in opacity-0 transition-opacity duration-500"
                        loading={index === 0 ? 'eager' : 'lazy'}
                        fetchpriority={index === 0 ? 'high' : undefined}
                        draggable="false"
                        onload="this.classList.remove('opacity-0'); this.classList.add('opacity-100'); this.previousElementSibling?.classList.add('opacity-0')"
                      />
                    </picture>
                  </div>
                ))}

                <!-- Minimap (on image frame) -->
                <div
                  x-show="magnifier.active"
                  x-cloak
                  x-transition:enter="transition ease-out duration-200"
                  x-transition:enter-start="opacity-0 scale-95"
                  x-transition:enter-end="opacity-100 scale-100"
                  x-transition:leave="transition ease-in duration-150"
                  x-transition:leave-start="opacity-100"
                  x-transition:leave-end="opacity-0"
                  class="absolute top-3 right-3 w-36 h-28 border border-accent/40 rounded-lg overflow-hidden bg-void/90 backdrop-blur-sm z-40 hidden md:block shadow-lg shadow-accent/10"
                >
                  <img
                    :src="magnifier.imgSrc"
                    alt="Minimap"
                    class="w-full h-full object-contain opacity-70"
                  />
                  <div
                    class="absolute border-2 border-accent rounded-sm shadow-[0_0_8px_rgba(34,211,238,0.5)]"
                    :style="`left: ${magnifier.viewX - magnifier.viewW/2}%; top: ${magnifier.viewY - magnifier.viewH/2}%; width: ${magnifier.viewW}%; height: ${magnifier.viewH}%;`"
                  ></div>
                </div>
              </div>

              <!-- Magnifier Lens (Desktop) -->
              <div
                x-show="magnifier.active"
                x-cloak
                class="pointer-events-none fixed rounded-full border-2 border-accent/50 shadow-lg shadow-accent/20 z-50 hidden md:block"
                :style="`left: ${magnifier.x}px; top: ${magnifier.y}px; width: ${magnifier.size}px; height: ${magnifier.size}px; background-image: url('${magnifier.imgSrc}'); background-size: ${magnifier.bgW}px ${magnifier.bgH}px; background-position: ${magnifier.bgX}px ${magnifier.bgY}px;`"
              ></div>
              <!-- Touch Magnifier Lens (Mobile) -->
              <div
                x-show="touchMagnifier.active"
                x-cloak
                class="pointer-events-none fixed rounded-full border-2 border-accent/50 shadow-lg shadow-accent/20 z-50 md:hidden"
                :style="`left: ${touchMagnifier.x}px; top: ${touchMagnifier.y}px; width: ${touchMagnifier.size}px; height: ${touchMagnifier.size}px; background-image: url('${touchMagnifier.imgSrc}'); background-size: ${touchMagnifier.bgW}px ${touchMagnifier.bgH}px; background-position: ${touchMagnifier.bgX}px ${touchMagnifier.bgY}px;`"
              ></div>
              {item.images.length > 1 && (
                <div
                  x-ref="thumbnailStrip"
                  class="flex gap-3 overflow-x-auto pb-2"
                  x-effect="$nextTick(() => { const btn = $refs.thumbnailStrip?.children[activeImage]; if(btn) btn.scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' }) })"
                >
                  {item.images.map((image, index) => {
                    const optimized = getOptimizedSrc(image);
                    return (
                      <button
                        @click={`activeImage = ${index}`}
                        :class={`activeImage === ${index} ? 'border-accent' : 'border-transparent opacity-60 hover:opacity-100'`}
                        class="flex-shrink-0 w-20 h-20 min-w-[44px] min-h-[44px] rounded-lg overflow-hidden transition-all duration-200 border-2"
                      >
                        <img
                          src={optimized.thumb}
                          alt={`Thumbnail ${index + 1}`}
                          width="80"
                          height="80"
                          class="w-full h-full object-cover"
                          loading="lazy"
                        />
                      </button>
                    );
                  })}
                </div>
              )}
            </>
          ) : (
            <div class="aspect-square glass-panel flex flex-col items-center justify-center gap-2">
              <svg class="w-12 h-12 text-text-dim" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
              <span class="font-mono text-xs text-text-dim uppercase tracking-wider">No image available</span>
            </div>
          )}

          <!-- Lightbox Overlay -->
          <div
            x-show="lightboxOpen"
            x-cloak
            x-transition:enter="transition ease-out duration-300"
            x-transition:enter-start="opacity-0"
            x-transition:enter-end="opacity-100"
            x-transition:leave="transition ease-in duration-200"
            x-transition:leave-start="opacity-100"
            x-transition:leave-end="opacity-0"
            class="fixed inset-0 z-[100] bg-void/95 backdrop-blur-xl flex items-center justify-center"
            @click.self="closeLightbox()"
            role="dialog"
            aria-modal="true"
            aria-label="Image lightbox"
          >
            <!-- Close button -->
            <button
              @click="closeLightbox()"
              class="absolute top-4 right-4 p-2 text-text-muted hover:text-accent transition-colors z-10"
              aria-label="Close lightbox"
            >
              <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 18L18 6M6 6l12 12" />
              </svg>
            </button>

            <!-- Previous button -->
            {item.images.length > 1 && (
              <button
                @click="prevImage()"
                class="absolute left-4 top-1/2 -translate-y-1/2 p-3 text-text-muted hover:text-accent transition-colors z-10"
                aria-label="Previous image"
              >
                <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                </svg>
              </button>
            )}

            <!-- Next button -->
            {item.images.length > 1 && (
              <button
                @click="nextImage()"
                class="absolute right-4 top-1/2 -translate-y-1/2 p-3 text-text-muted hover:text-accent transition-colors z-10"
                aria-label="Next image"
              >
                <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </button>
            )}

            <!-- Image container -->
            <div
              class="max-w-[90vw] max-h-[90vh] relative touch-manipulation"
              @touchstart="handleTouchStart($event)"
              @touchmove="handleTouchMove($event)"
              @touchend="handleTouchEnd($event)"
            >
              {item.images.map((image, index) => {
                const optimized = getOptimizedSrc(image);
                return (
                  <img
                    x-show={`activeImage === ${index}`}
                    x-transition:enter="transition ease-out duration-300"
                    x-transition:enter-start="opacity-0 scale-95"
                    x-transition:enter-end="opacity-100 scale-100"
                    @mouseenter="showLbMagnifier($event)"
                    @mousemove="handleLbMagnifier($event)"
                    @mouseleave="hideLbMagnifier()"
                    src={optimized.medium}
                    alt={`${item.name} - Image ${index + 1}`}
                    width="1400"
                    height="933"
                    class="max-w-full max-h-[85vh] object-contain cursor-crosshair"
                    draggable="false"
                  />
                );
              })}

              <!-- Minimap (on image frame) -->
              <div
                x-show="lbMagnifier.active"
                x-cloak
                x-transition:enter="transition ease-out duration-200"
                x-transition:enter-start="opacity-0 scale-95"
                x-transition:enter-end="opacity-100 scale-100"
                x-transition:leave="transition ease-in duration-150"
                x-transition:leave-start="opacity-100"
                x-transition:leave-end="opacity-0"
                class="absolute top-3 right-3 w-40 h-32 border border-accent/40 rounded-lg overflow-hidden bg-void/90 backdrop-blur-sm z-[110] hidden md:block shadow-lg shadow-accent/10"
              >
                <img
                  :src="lbMagnifier.imgSrc"
                  alt="Minimap"
                  class="w-full h-full object-contain opacity-70"
                />
                <div
                  class="absolute border-2 border-accent rounded-sm shadow-[0_0_8px_rgba(34,211,238,0.5)]"
                  :style="`left: ${lbMagnifier.viewX - lbMagnifier.viewW/2}%; top: ${lbMagnifier.viewY - lbMagnifier.viewH/2}%; width: ${lbMagnifier.viewW}%; height: ${lbMagnifier.viewH}%;`"
                ></div>
              </div>
            </div>

            <!-- Lightbox Magnifier Lens -->
            <div
              x-show="lbMagnifier.active"
              x-cloak
              class="pointer-events-none fixed rounded-full border-2 border-accent/50 shadow-lg shadow-accent/20 z-[110] hidden md:block"
              :style="`left: ${lbMagnifier.x}px; top: ${lbMagnifier.y}px; width: ${lbMagnifier.size}px; height: ${lbMagnifier.size}px; background-image: url('${lbMagnifier.imgSrc}'); background-size: ${lbMagnifier.bgW}px ${lbMagnifier.bgH}px; background-position: ${lbMagnifier.bgX}px ${lbMagnifier.bgY}px;`"
            ></div>

            <!-- Image counter -->
            {item.images.length > 1 && (
              <div class="absolute bottom-4 left-1/2 -translate-x-1/2 font-mono text-sm text-text-muted">
                <span x-text="activeImage + 1"></span> / {item.images.length}
              </div>
            )}

            <!-- Keyboard hint -->
            <div class="absolute bottom-4 right-4 font-mono text-xs text-text-dim hidden md:block">
              ← → navigate · ESC close
            </div>
          </div>
        </div>

        <div class="lg:sticky lg:top-24 lg:self-start">
          <div class="flex items-center gap-2 mb-4">
            <span class="font-mono text-xs uppercase tracking-wider text-accent">
              {categoryLabels[item.category]}
            </span>
            <span class="text-text-dim">·</span>
            <span class="font-mono text-xs uppercase tracking-wider text-text-dim">
              {item.period}
            </span>
          </div>

          <h1 class="text-3xl md:text-4xl text-text mb-6" data-pagefind-meta="title">{item.name}</h1>
          <span data-pagefind-meta={`category:${categoryLabels[item.category]}`} class="hidden"></span>
          <span data-pagefind-meta={`period:${item.period}`} class="hidden"></span>
          <span data-pagefind-meta={`origin:${item.origin}`} class="hidden"></span>
          <span data-pagefind-meta={`material:${item.material}`} class="hidden"></span>

          <div class="glass-panel p-6">
            <p class="text-text-muted text-[15px] md:text-base leading-[1.8] md:leading-relaxed tracking-[0.01em]">{item.description}</p>
          </div>

          <div class="glass-panel p-6 mt-4">
            <h2 class="font-mono text-xs uppercase tracking-wider text-accent mb-4">// Details</h2>

            <dl class="grid grid-cols-[auto_1fr] gap-y-3 gap-x-6">
              {item.category === 'coin' && item.denomination && (
                <>
                  <dt class="data-label">Denomination</dt>
                  <dd class="data-value text-right">{item.denomination}</dd>
                </>
              )}

              {item.category === 'coin' && item.ruler && (
                <>
                  <dt class="data-label">Ruler</dt>
                  <dd class="data-value text-right">{item.ruler}</dd>
                </>
              )}

              <dt class="data-label">Era</dt>
              <dd class="data-value text-right">{item.era}</dd>

              <dt class="data-label">Period</dt>
              <dd class="data-value text-right">{item.period}</dd>

              <dt class="data-label">Origin</dt>
              <dd class="data-value text-right">{item.origin}</dd>

              <dt class="data-label">Material</dt>
              <dd class="data-value text-right capitalize">{item.material}</dd>

              {item.weight && (
                <>
                  <dt class="data-label">Weight</dt>
                  <dd class="data-value text-right">{item.weight}</dd>
                </>
              )}

              {item.dimensions && (
                <>
                  <dt class="data-label">Dimensions</dt>
                  <dd class="data-value text-right">{item.dimensions}</dd>
                </>
              )}

              {item.condition && (
                <>
                  <dt class="data-label">Condition</dt>
                  <dd class="data-value text-right">{item.condition}</dd>
                </>
              )}
            </dl>
          </div>

          {item.category === 'coin' && (item.obverse || item.reverse) && (
            <div class="glass-panel p-6 mt-4">
              <h2 class="font-mono text-xs uppercase tracking-wider text-accent mb-4">// Coin Description</h2>
              <dl class="space-y-3">
                {item.obverse && (
                  <div>
                    <dt class="data-label mb-1">Obverse</dt>
                    <dd class="text-text-muted text-sm">{item.obverse}</dd>
                  </div>
                )}
                {item.reverse && (
                  <div>
                    <dt class="data-label mb-1">Reverse</dt>
                    <dd class="text-text-muted text-sm">{item.reverse}</dd>
                  </div>
                )}
              </dl>
            </div>
          )}

          {item.tags.length > 0 && (
            <div class="glass-panel p-6 mt-4">
              <h2 class="font-mono text-xs uppercase tracking-wider text-accent mb-4">// Tags</h2>
              <div class="flex flex-wrap gap-2">
                {item.tags.map((tag) => (
                  <a
                    href={url(`${item.category === 'coin' ? '/coins' : '/artifacts'}?tag=${encodeURIComponent(tag)}`)}
                    class="tag-chip px-3 py-1 bg-surface-light border border-border rounded font-mono text-xs text-text-muted hover:border-accent hover:text-accent transition-all duration-200"
                  >
                    {tag}
                  </a>
                ))}
              </div>
            </div>
          )}
        </div>
      </div>

      {relatedItems.length > 0 && (
        <section class="mt-20 pt-8 border-t border-border" data-pagefind-ignore>
          <h2 class="font-mono text-xs uppercase tracking-wider text-accent mb-6">// Related Items</h2>
          <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
            {relatedItems.map((related) => (
              <a
                href={url(`/item/${related.id}`)}
                class="glass-panel p-4 card-hover group"
              >
                <div class="flex items-center gap-2 mb-2">
                  <span class="font-mono text-micro uppercase tracking-wider text-accent">
                    {categoryLabels[related.category]}
                  </span>
                  <span class="text-text-dim">·</span>
                  <span class="font-mono text-micro uppercase tracking-wider text-text-dim">
                    {related.period}
                  </span>
                </div>
                <h3 class="text-lg text-text group-hover:text-accent transition-colors">
                  {related.name}
                </h3>
                <p class="data-label mt-1">{related.era}</p>
              </a>
            ))}
          </div>
        </section>
      )}

      <nav class="flex justify-between items-center mt-12 pt-8 border-t border-border" data-pagefind-ignore>
        {prevItem ? (
          <a href={url(`/item/${prevItem.id}`)} class="group">
            <span class="font-mono text-xs uppercase tracking-widest text-text-dim">Previous</span>
            <p class="text-lg text-text group-hover:text-accent transition-colors">{prevItem.name}</p>
          </a>
        ) : <div />}
        {nextItem ? (
          <a href={url(`/item/${nextItem.id}`)} class="group text-right">
            <span class="font-mono text-xs uppercase tracking-widest text-text-dim">Next</span>
            <p class="text-lg text-text group-hover:text-accent transition-colors">{nextItem.name}</p>
          </a>
        ) : <div />}
      </nav>
    </div>
  </article>

  <script>
    import { thumbHashToDataURL } from 'thumbhash';

    function base64ToBytes(base64: string): Uint8Array {
      const binary = atob(base64);
      const bytes = new Uint8Array(binary.length);
      for (let i = 0; i < binary.length; i++) {
        bytes[i] = binary.charCodeAt(i);
      }
      return bytes;
    }

    function initDetailPlaceholders() {
      const canvases = document.querySelectorAll<HTMLCanvasElement>('.detail-placeholder');
      canvases.forEach(canvas => {
        const thumbhash = canvas.dataset.thumbhash;
        if (!thumbhash) return;

        try {
          const hash = base64ToBytes(thumbhash);
          const dataUrl = thumbHashToDataURL(hash);

          const img = new Image();
          img.onload = () => {
            const ctx = canvas.getContext('2d');
            if (ctx) {
              canvas.width = canvas.offsetWidth || 400;
              canvas.height = canvas.offsetHeight || 300;
              ctx.drawImage(img, 0, 0, canvas.width, canvas.height);
            }
          };
          img.src = dataUrl;
        } catch (e) {
          console.warn('Failed to decode thumbhash:', e);
        }
      });
    }

    initDetailPlaceholders();
    document.addEventListener('astro:page-load', initDetailPlaceholders);
  </script>
</BaseLayout>
