---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getI18nData, DEFAULT_LOCALE, getLocalePath } from '../lib/i18n';

// Get i18n data
const i18n = getI18nData(Astro);
const { locale, t, pathWithoutLocale } = i18n;

// Get query parameters
const url = Astro.url.searchParams.get('url') || '';
const articleSlug = Astro.url.searchParams.get('slug') || '';
const articleTitle = Astro.url.searchParams.get('title') || '';
const submitted = Astro.url.searchParams.get('submitted') === 'true';

// Build mailto link with pre-filled content
const mailtoSubject = encodeURIComponent(t.report.emailSubject);
const mailtoBody = encodeURIComponent(
  `URL: ${url || 'Not specified'}\n` +
  `Language: ${locale}\n` +
  `Article: ${articleTitle || articleSlug || 'Not specified'}\n\n` +
  `Issue description:\n(Please describe the issue here)`
);
const mailtoHref = `mailto:support@theantiquearchive.com?subject=${mailtoSubject}&body=${mailtoBody}`;

// Get translations for issue types
const issueTypes = Object.entries(t.report.issueTypes) as [string, string][];
---

<BaseLayout
  title={`${t.report.title} | ${t.meta.siteName}`}
  description={t.report.description}
>
  <div class="min-h-screen py-16 md:py-24">
    <div class="container-narrow max-w-xl">
      <header class="mb-10 text-center">
        <p class="font-mono text-xs uppercase tracking-[0.2em] text-accent mb-3">
          // {t.report.subtitle}
        </p>
        <h1 class="text-3xl md:text-4xl text-text mb-4">
          {t.report.title}
        </h1>
        <p class="text-text-muted">
          {t.report.description}
        </p>
      </header>

      {submitted ? (
        <div class="glass-panel p-8 text-center">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-16 h-16 text-accent mx-auto mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <h2 class="text-xl text-text mb-2">{t.report.successMessage}</h2>
          <a href={url || getLocalePath(locale, '/')} class="inline-flex items-center gap-2 mt-4 text-accent hover:underline font-mono text-sm">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
            </svg>
            {t.common.back}
          </a>
        </div>
      ) : (
        <form 
          class="glass-panel p-6 md:p-8 space-y-6"
          action="mailto:support@theantiquearchive.com"
          method="post"
          enctype="text/plain"
          onsubmit="event.preventDefault(); window.location.href = this.action + '?subject=' + encodeURIComponent(this.querySelector('[name=subject]').value) + '&body=' + encodeURIComponent(this.querySelector('[name=body]').value);"
        >
          <!-- Hidden fields for email composition -->
          <input type="hidden" name="subject" value={t.report.emailSubject} />
          
          <!-- URL Field -->
          <div class="space-y-2">
            <label for="url" class="block font-mono text-xs uppercase tracking-wider text-text-dim">
              {t.report.urlLabel}
              <span class="text-accent/60">({t.report.optional})</span>
            </label>
            <input
              type="url"
              id="url"
              name="Report URL"
              value={url}
              placeholder={t.report.urlPlaceholder}
              readonly={url ? true : undefined}
              class="w-full bg-surface border border-white/10 rounded px-4 py-3 text-text placeholder:text-text-dim/50 focus:border-accent/50 focus:outline-none transition-colors"
            />
          </div>

          <!-- Language Field -->
          <div class="space-y-2">
            <label for="locale" class="block font-mono text-xs uppercase tracking-wider text-text-dim">
              {t.report.localeLabel}
              <span class="text-accent/60">({t.report.required})</span>
            </label>
            <input
              type="text"
              id="locale"
              name="Language"
              value={locale}
              readonly
              class="w-full bg-surface-light/50 border border-white/10 rounded px-4 py-3 text-text-dim cursor-not-allowed"
            />
          </div>

          <!-- Article Info (if available) -->
          {(articleTitle || articleSlug) && (
            <div class="space-y-2">
              <label for="article" class="block font-mono text-xs uppercase tracking-wider text-text-dim">
                Article
                <span class="text-accent/60">({t.report.optional})</span>
              </label>
              <input
                type="text"
                id="article"
                name="Article"
                value={articleTitle || articleSlug}
                readonly
                class="w-full bg-surface-light/50 border border-white/10 rounded px-4 py-3 text-text-dim cursor-not-allowed"
              />
            </div>
          )}

          <!-- Issue Type -->
          <div class="space-y-2">
            <label for="issueType" class="block font-mono text-xs uppercase tracking-wider text-text-dim">
              {t.report.issueLabel}
              <span class="text-accent/60">({t.report.optional})</span>
            </label>
            <select
              id="issueType"
              name="Issue Type"
              class="w-full bg-surface border border-white/10 rounded px-4 py-3 text-text focus:border-accent/50 focus:outline-none transition-colors appearance-none cursor-pointer"
              style="background-image: url('data:image/svg+xml,%3Csvg xmlns=%27http://www.w3.org/2000/svg%27 fill=%27none%27 viewBox=%270 0 24 24%27 stroke=%27rgba(255,255,255,0.5)%27%3E%3Cpath stroke-linecap=%27round%27 stroke-linejoin=%27round%27 stroke-width=%272%27 d=%27M19 9l-7 7-7-7%27/%3E%3C/svg%3E'); background-repeat: no-repeat; background-position: right 12px center; background-size: 16px;"
            >
              <option value="" disabled selected>{t.report.issuePlaceholder}</option>
              {issueTypes.map(([key, label]) => (
                <option value={label}>{label}</option>
              ))}
            </select>
          </div>

          <!-- Details -->
          <div class="space-y-2">
            <label for="details" class="block font-mono text-xs uppercase tracking-wider text-text-dim">
              {t.report.detailsLabel}
              <span class="text-accent/60">({t.report.optional})</span>
            </label>
            <textarea
              id="details"
              name="Details"
              rows={5}
              placeholder={t.report.detailsPlaceholder}
              class="w-full bg-surface border border-white/10 rounded px-4 py-3 text-text placeholder:text-text-dim/50 focus:border-accent/50 focus:outline-none transition-colors resize-y"
            ></textarea>
          </div>

          <!-- Hidden body field for mailto -->
          <textarea name="body" class="hidden">{`
URL: ${url || 'Not specified'}
Language: ${locale}
Article: ${articleTitle || articleSlug || 'Not specified'}

Please describe the issue:
(Your description will be added here)
          `}</textarea>

          <!-- Submit Button -->
          <div class="pt-4">
            <a
              href={mailtoHref}
              class="w-full inline-flex items-center justify-center gap-2 bg-accent/10 border border-accent/30 text-accent hover:bg-accent/20 hover:border-accent/50 px-6 py-3 rounded font-mono text-sm uppercase tracking-wider transition-all duration-200"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
              {t.report.submitButton}
            </a>
            <p class="text-center text-xs text-text-dim mt-4">
              {t.report.submitVia}{' '}
              <a href="mailto:support@theantiquearchive.com" class="text-accent hover:underline">
                support@theantiquearchive.com
              </a>
            </p>
          </div>
        </form>
      )}
    </div>
  </div>
</BaseLayout>
