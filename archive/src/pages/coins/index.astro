---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CoinCard from '../../components/CoinCard.astro';
import CoinFilterBar from '../../components/CoinFilterBar.astro';
import { getCoins } from '../../lib/items';

const coins = getCoins();
---

<BaseLayout
  title="Ancient Coins Collection | Greek, Roman & Byzantine Numismatics"
  description="Browse our collection of ancient Greek, Roman, Byzantine, and Near Eastern coins. Each piece authenticated with detailed provenance and historical context."
>
  <section class="relative py-16 min-h-screen">

    <div class="container-narrow relative">
      <div class="mb-12">
        <p class="font-mono text-xs uppercase tracking-[0.2em] text-accent mb-3">
          // Numismatic Collection
        </p>
        <h1 class="text-4xl md:text-5xl text-text mb-4">Ancient Coins</h1>
        <p class="text-text-muted text-lg">
          Explore <span class="text-accent font-mono">{coins.length}</span> coins spanning ancient civilizations.
        </p>
      </div>

      <CoinFilterBar />

      <div id="coin-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 transition-opacity duration-200 reveal-stagger">
        {coins.length > 0 ? (
          coins.map((coin, index) => (
            <CoinCard coin={coin} priority={index < 6} />
          ))
        ) : (
          <div class="col-span-full text-center py-16">
            <div class="glass-panel p-8 inline-block">
              <svg class="w-12 h-12 text-text-dim mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <p class="font-mono text-sm text-text-muted">
                <span class="text-accent">//</span> No coins in collection yet
              </p>
              <p class="text-text-dim text-xs mt-2">
                Coins will appear here once added
              </p>
            </div>
          </div>
        )}
      </div>
    </div>
  </section>
</BaseLayout>
