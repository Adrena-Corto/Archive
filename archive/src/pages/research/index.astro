    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .step {
    display: flex;
    gap: 1.5rem;
    align-items: flex-start;
  }
  .step-num {
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: rgba(196,149,106,0.15);
    color: #c4956a;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 600;
    font-size: 1.1rem;
  }
  .step-content h3 {
    font-size: 1rem;
    font-weight: 600;
    margin-bottom: 0.4rem;
    color: #f0e6d8;
  }
  .step-content p {
    font-size: 0.9rem;
    line-height: 1.6;
    color: #9a8e82;
  }

  /* Visualization */
  .viz-subtitle {
    color: #9a8e82;
    font-size: 0.95rem;
    margin-bottom: 1.5rem;
  }
  .viz-container {
    position: relative;
    width: 100%;
    height: 600px;
    background: #0a0a0a;
    border-radius: 12px;
    border: 1px solid rgba(255,255,255,0.06);
    overflow: hidden;
  }
  #tsne-canvas {
    width: 100%;
    height: 100%;
  }
