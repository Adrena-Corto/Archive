    border-radius: 6px;
    font-size: 13px;
    pointer-events: none;
    z-index: 10;
    color: #e8e0d4;
  }
  #tsne-legend {
    position: absolute;
    top: 12px;
    right: 12px;
    background: rgba(0,0,0,0.85);
    padding: 12px;
    border-radius: 8px;
    border: 1px solid #333;
    font-size: 11px;
