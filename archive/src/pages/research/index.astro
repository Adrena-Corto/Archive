    display: flex;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }
  .vt-btn {
    padding: 6px 16px;
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 6px;
    color: #7a6e63;
    cursor: pointer;
    font-size: 0.85rem;
    transition: all 0.2s;
  }
  .vt-btn.active {
    background: rgba(196,149,106,0.15);
    border-color: #c4956a;
    color: #c4956a;
  }
  .vt-btn:hover { border-color: #c4956a; }

  /* Distortions */
  .distortions, .tools { margin-bottom: 4rem; }
  .distortion-table {
    border: 1px solid rgba(255,255,255,0.06);
    border-radius: 8px;
    overflow: hidden;
  }
  .dt-row {
    display: grid;
    grid-template-columns: 1fr 1.2fr 1.5fr 0.8fr;
    padding: 10px 16px;
    border-bottom: 1px solid rgba(255,255,255,0.04);
    font-size: 0.85rem;
    color: #9a8e82;
    gap: 8px;
  }
  .dt-header {
    background: rgba(255,255,255,0.03);
    font-weight: 600;
    color: #b8a99a;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .dt-term { font-family: 'JetBrains Mono', monospace; color: #f0e6d8; }
  .dt-sig { color: #ff6b6b; }
  .dt-mod { color: #ffa94d; }
  .dt-min { color: #69db7c; }

  /* Tools */
  .tools-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
  }
  .tool-card {
    display: block;
    padding: 2rem;
    background: rgba(196,149,106,0.05);
    border: 1px solid rgba(196,149,106,0.15);
    border-radius: 12px;
    text-decoration: none;
    transition: border-color 0.3s, transform 0.2s;
  }
  .tool-card:hover {
    border-color: rgba(196,149,106,0.4);
    transform: translateY(-2px);
  }
  .tool-card h3 { font-size: 1.1rem; color: #f0e6d8; margin-bottom: 0.5rem; }
  .tool-card p { font-size: 0.9rem; color: #9a8e82; line-height: 1.5; }

  /* Stats */
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 1.5rem;
  }
  .stat {
    text-align: center;
    padding: 1.5rem;
    background: rgba(255,255,255,0.02);
    border-radius: 8px;
    border: 1px solid rgba(255,255,255,0.04);
  }
  .stat-num {
    font-size: 2rem;
    font-weight: 300;
    color: #c4956a;
    font-family: 'JetBrains Mono', monospace;
  }
  .stat-label {
    font-size: 0.85rem;
    color: #7a6e63;
    margin-top: 0.3rem;
  }

  /* Related */
  .related-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1.5rem;
  }
  .related-card {
    display: block;
    padding: 1.5rem;
    background: rgba(255,255,255,0.02);
    border: 1px solid rgba(255,255,255,0.06);
    border-radius: 8px;
    text-decoration: none;
    transition: border-color 0.3s, transform 0.2s;
  }
  .related-card:hover {
    border-color: rgba(196,149,106,0.3);
    transform: translateY(-2px);
  }
  .related-card.featured {
    border-color: rgba(196,149,106,0.3);
    background: rgba(196,149,106,0.06);
  }
  .card-tag {
    display: inline-block;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #c4956a;
    margin-bottom: 0.5rem;
  }
  .related-card h3 {
    font-size: 1rem;
    color: #f0e6d8;
    margin-bottom: 0.5rem;
  }
  .related-card p {
    font-size: 0.85rem;
    color: #9a8e82;
    line-height: 1.5;
  }
</style>

<script is:inline define:vars={{ }}>
let currentData = null;
const dataCache = {};

function loadViz(mode) {
  const url = mode === 'umap' ? '/data/umap_sumerian.json' : '/data/tsne_sumerian.json';
  if (dataCache[mode]) { initTSNE(dataCache[mode]); return; }
  fetch(url).then(r => r.json()).then(data => {
    dataCache[mode] = data;
    initTSNE(data);
  });
}

document.querySelectorAll('.vt-btn').forEach(btn => {
  btn.addEventListener('click', () => {
    document.querySelectorAll('.vt-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    loadViz(btn.dataset.mode);
  });
});

loadViz('tsne');

function initTSNE(points) {
  const colors = {
    "ME (divine powers)": "#ff4444",
    "NAM- roles": "#ff8800",
    "NAM- qualities": "#ffcc00",
    "NAM- states": "#88cc00",
    "NAM- crafts": "#00cc88",
    "NAM- social": "#00aaff",
    "Light/radiance": "#ffff00",
    "Divine": "#cc44ff",
    "Spatial/cosmic": "#44ccff",
    "Blueprint/design": "#ff44cc",
    "other": "#222222",
  };

  const canvas = document.getElementById('tsne-canvas');
  const ctx = canvas.getContext('2d');
  const tooltip = document.getElementById('tsne-tooltip');
  const search = document.getElementById('tsne-search');
  const legend = document.getElementById('tsne-legend');

  // Build legend
  legend.innerHTML = Object.entries(colors)
    .filter(([k]) => k !== 'other')
    .map(([cat, col]) => 
      `<div style="margin:3px 0;"><span style="display:inline-block;width:8px;height:8px;border-radius:50%;background:${col};margin-right:6px;"></span>${cat}</div>`
    ).join('');

  let W, H, scale, ox, oy;
  let highlighted = null;

  function resize() {
    const rect = canvas.parentElement.getBoundingClientRect();
    W = canvas.width = rect.width * window.devicePixelRatio;
    H = canvas.height = rect.height * window.devicePixelRatio;
    canvas.style.width = rect.width + 'px';
    canvas.style.height = rect.height + 'px';
    ctx.scale(window.devicePixelRatio, window.devicePixelRatio);
    
    const xs = points.map(p => p.x), ys = points.map(p => p.y);
    const xmin = Math.min(...xs), xmax = Math.max(...xs);
    const ymin = Math.min(...ys), ymax = Math.max(...ys);
    const pad = 40;
    const w = rect.width, h = rect.height;
    scale = Math.min((w - 2*pad) / (xmax - xmin), (h - 2*pad) / (ymax - ymin));
    ox = pad - xmin * scale + (w - 2*pad - (xmax-xmin)*scale) / 2;
    oy = pad - ymin * scale + (h - 2*pad - (ymax-ymin)*scale) / 2;
    draw();
  }

  function toScreen(p) { return [p.x * scale + ox, p.y * scale + oy]; }

  function draw() {
    const w = W / window.devicePixelRatio;
    const h = H / window.devicePixelRatio;
    ctx.clearRect(0, 0, w, h);
    
    for (const p of points) {
      if (p.category === 'other') {
        const [sx, sy] = toScreen(p);
        ctx.beginPath();
        ctx.arc(sx, sy, 1.5, 0, Math.PI*2);
        ctx.fillStyle = '#1a1a1a';
        ctx.fill();
      }
    }
    for (const p of points) {
      if (p.category !== 'other') {
        const [sx, sy] = toScreen(p);
        const isHL = highlighted === p.word;
        ctx.beginPath();
        ctx.arc(sx, sy, isHL ? 7 : 4, 0, Math.PI*2);
        ctx.fillStyle = colors[p.category] || '#666';
        ctx.fill();
        ctx.font = isHL ? 'bold 12px Inter, sans-serif' : '9px Inter, sans-serif';
        ctx.fillStyle = colors[p.category] || '#999';
        ctx.fillText(p.word, sx + 6, sy + 3);
      }
    }
    if (highlighted) {
      const p = points.find(p => p.word === highlighted);
      if (p) {
        const [sx, sy] = toScreen(p);
        ctx.beginPath();
        ctx.arc(sx, sy, 10, 0, Math.PI*2);
        ctx.strokeStyle = '#fff';
        ctx.lineWidth = 2;
        ctx.stroke();
      }
    }
  }

  canvas.addEventListener('mousemove', e => {
    const rect = canvas.getBoundingClientRect();
    const mx = e.clientX - rect.left, my = e.clientY - rect.top;
    let closest = null, minD = 15;
    for (const p of points) {
      const [sx, sy] = toScreen(p);
      const d = Math.hypot(mx-sx, my-sy);
      if (d < minD) { minD = d; closest = p; }
    }
    if (closest) {
      tooltip.style.display = 'block';
      tooltip.style.left = (e.clientX - rect.left + 15) + 'px';
      tooltip.style.top = (e.clientY - rect.top - 10) + 'px';
      tooltip.innerHTML = `<b>${closest.word}</b><br><span style="color:${colors[closest.category]}">${closest.category}</span>`;
    } else {
      tooltip.style.display = 'none';
    }
  });

  search.addEventListener('input', () => {
    highlighted = search.value.trim() || null;
    draw();
  });

  window.addEventListener('resize', resize);
  resize();
}
</script>
