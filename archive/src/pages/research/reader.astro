---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Text Reader — Inana's Descent | The Antique Archive"
  description="Interactive retranslation of Inana's Descent to the Nether World. Hover any highlighted term to see conventional vs computational readings."
>
  <main class="reader">
    <section class="reader-hero">
      <a href="/research" class="back-link">← Research Lab</a>
      <h1>Inana's Descent to the Nether World</h1>
      <p class="subtitle">
        437 lines. 30 occurrences of <em>me</em>, 30 of <em>kug</em>, 2 of <em>nam-tag</em>.
        Hover any <span class="sample-highlight">highlighted term</span> to see the conventional translation 
        vs. what the computational evidence suggests.
      </p>
    </section>

    <!-- Legend -->
    <section class="reader-legend">
      <h3>Key Terms</h3>
      <div class="legend-items" id="legend-items"></div>
      <div class="legend-controls">
        <label><input type="checkbox" id="show-gloss" /> Show word glosses</label>
        <label><input type="checkbox" id="show-translation" checked /> Show English translation</label>
        <label><input type="checkbox" id="highlight-only" /> Show only lines with key terms</label>
      </div>
    </section>

    <!-- Text body -->
    <section class="reader-body" id="reader-body">
      <div class="loading">Loading text...</div>
    </section>

    <!-- Floating annotation panel -->
    <div class="annotation-panel" id="annotation-panel">
      <div class="ann-term" id="ann-term"></div>
      <div class="ann-row">
        <span class="ann-label">Conventional:</span>
        <span class="ann-value" id="ann-conv"></span>
      </div>
      <div class="ann-row">
        <span class="ann-label">Computational:</span>
        <span class="ann-value ann-comp" id="ann-comp"></span>
      </div>
      <div class="ann-conf" id="ann-conf"></div>
    </div>
  </main>
</BaseLayout>

<style>
  .reader {
    max-width: 900px;
    margin: 0 auto;
    padding: 2rem 1.5rem 6rem;
    color: #e0d5c1;
  }
  .back-link {
    color: #a89274;
    text-decoration: none;
    font-size: 0.9rem;
  }
  .back-link:hover { color: #e8b84b; }

  .reader-hero h1 {
    font-family: 'Cinzel', serif;
    font-size: 2rem;
    color: #e8b84b;
    margin: 1rem 0 0.5rem;
  }
  .subtitle {
    color: #a89274;
    line-height: 1.6;
    font-size: 0.95rem;
  }
  .sample-highlight {
    background: rgba(232,184,75,0.2);
    padding: 0.1em 0.3em;
    border-radius: 3px;
    color: #e8b84b;
  }

  /* Legend */
  .reader-legend {
    margin: 2rem 0;
    padding: 1.5rem;
    background: rgba(30,25,20,0.6);
    border: 1px solid rgba(232,184,75,0.15);
    border-radius: 8px;
  }
  .reader-legend h3 {
    font-family: 'Cinzel', serif;
    color: #e8b84b;
    margin: 0 0 1rem;
    font-size: 1rem;
  }
  .legend-items {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }
  .legend-chip {
    padding: 0.25rem 0.6rem;
    border-radius: 4px;
    font-size: 0.8rem;
    cursor: pointer;
    transition: opacity 0.2s;
    border: 1px solid transparent;
  }
  .legend-chip:hover { opacity: 0.8; }
  .legend-chip.active { border-color: currentColor; }
  .legend-controls {
    display: flex;
    gap: 1.5rem;
    flex-wrap: wrap;
  }
  .legend-controls label {
    font-size: 0.85rem;
    color: #a89274;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  /* Text body */
  .reader-body {
    font-family: 'JetBrains Mono', 'Fira Code', monospace;
    font-size: 0.85rem;
    line-height: 1.8;
  }
  .loading { color: #a89274; text-align: center; padding: 3rem; }

  .text-line {
    display: flex;
    gap: 0.8rem;
    padding: 0.15rem 0;
    border-bottom: 1px solid rgba(232,184,75,0.04);
    transition: background 0.15s;
  }
  .text-line:hover {
    background: rgba(232,184,75,0.04);
  }
  .text-line.has-key {
    background: rgba(232,184,75,0.03);
  }
  .text-line.hidden { display: none; }
  .line-num {
    color: #5a4f3e;
    min-width: 2.5rem;
    text-align: right;
    flex-shrink: 0;
    user-select: none;
    font-size: 0.75rem;
    padding-top: 0.15rem;
  }
  .line-content {
    flex: 1;
    min-width: 0;
  }
  .line-sumerian {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.3rem;
    align-items: flex-start;
  }

  .word {
    position: relative;
    cursor: default;
    padding: 0.05rem 0.15rem;
    border-radius: 2px;
    transition: background 0.15s;
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    vertical-align: top;
  }
  .word.key-term {
    cursor: pointer;
    font-weight: 600;
  }
  .word.key-term .word-form {
    border-bottom: 2px solid currentColor;
  }
  .word.key-term:hover {
    filter: brightness(1.3);
  }
  .word .word-gloss {
    display: none;
    color: #6b5f4f;
    font-size: 0.65rem;
    line-height: 1.2;
    white-space: nowrap;
    font-family: 'EB Garamond', Georgia, serif;
    font-style: italic;
    margin-top: 0.1rem;
  }
  .show-glosses .word .word-gloss {
    display: block !important;
  }

  .line-translation {
    color: #6b5f4f;
    font-family: 'EB Garamond', Georgia, serif;
    font-size: 0.85rem;
    font-style: italic;
    margin-top: 0.1rem;
    padding-left: 0.2rem;
    display: none;
  }
  .show-translations .line-translation {
    display: block;
  }

  /* Section breaks */
  .section-break {
    border-top: 1px solid rgba(232,184,75,0.12);
    margin: 1.5rem 0 0.5rem;
    padding-top: 0.5rem;
  }
  .section-label {
    color: #a89274;
    font-family: 'Cinzel', serif;
    font-size: 0.8rem;
    letter-spacing: 0.05em;
  }

  /* Annotation panel */
  .annotation-panel {
    display: none;
    position: fixed;
    z-index: 100;
    background: #1a1510;
    border: 1px solid rgba(232,184,75,0.3);
    border-radius: 8px;
    padding: 1rem 1.2rem;
    max-width: 360px;
    box-shadow: 0 8px 32px rgba(0,0,0,0.5);
    pointer-events: none;
  }
  .annotation-panel.visible { display: block; }
  .ann-term {
    font-family: 'Cinzel', serif;
    font-size: 1.1rem;
    font-weight: 700;
    margin-bottom: 0.6rem;
  }
  .ann-row {
    margin: 0.4rem 0;
    font-size: 0.85rem;
    line-height: 1.5;
  }
  .ann-label {
    color: #a89274;
    font-weight: 600;
  }
  .ann-value {
    color: #e0d5c1;
    margin-left: 0.3rem;
  }
  .ann-comp {
    color: #e8b84b;
    font-weight: 600;
  }
  .ann-conf {
    margin-top: 0.5rem;
    font-size: 0.75rem;
    padding: 0.2rem 0.5rem;
    border-radius: 3px;
    display: inline-block;
  }
  .ann-conf.strong { background: rgba(107,255,184,0.15); color: #6bffb8; }
  .ann-conf.moderate { background: rgba(232,184,75,0.15); color: #e8b84b; }

  /* Responsive */
  @media (max-width: 640px) {
    .reader { padding: 1rem; }
    .reader-hero h1 { font-size: 1.4rem; }
    .reader-body { font-size: 0.78rem; }
    .annotation-panel { max-width: 280px; }
  }
</style>

<script>
  // ETCSL translation segments (line ranges → English)
  const TRANSLATIONS = {
    1: "From the great heaven she set her mind on the great below.",
    2: "From the great heaven the goddess set her mind on the great below.",
    3: "From the great heaven Inana set her mind on the great below.",
    4: "My mistress abandoned heaven, abandoned earth, and descended to the underworld.",
    5: "Inana abandoned heaven, abandoned earth, and descended to the underworld.",
    6: "She abandoned the office of en, abandoned the office of lagar, and descended to the underworld.",
    7: "She abandoned the E-ana in Unug, and descended to the underworld.",
    8: "She abandoned the E-muš-kalama in Bad-tibira, and descended to the underworld.",
    9: "She abandoned the Giguna in Zabalam, and descended to the underworld.",
    10: "She abandoned the E-šara in Adab, and descended to the underworld.",
    11: "She abandoned the Barag-dur-ĝara in Nibru, and descended to the underworld.",
    12: "She abandoned the Hursaĝ-kalama in Kiš, and descended to the underworld.",
    13: "She abandoned the E-Ulmaš in Agade, and descended to the underworld.",
    22: "She took the seven divine powers.",
    23: "She collected the divine powers and grasped them in her hand.",
    24: "With the good divine powers, she went on her way.",
    25: "She put a turban, headgear for the open country, on her head.",
    26: "She took a wig for her forehead.",
    27: "She hung small lapis-lazuli beads around her neck.",
    28: "She placed twin egg-shaped beads on her breast.",
    29: "She covered her body with a pala dress, the garment of ladyship.",
    30: "She placed mascara which is called 'Let a man come' on her eyes.",
    31: "She pulled the pectoral which is called 'Come, man, come' over her breast.",
    32: "She placed a golden ring on her hand.",
    33: "She held the lapis-lazuli measuring rod and measuring line in her hand.",
    34: "Inana travelled towards the underworld.",
    35: "Her minister Ninšubura travelled behind her.",
    36: "Holy Inana said to Ninšubura:",
    37: "'Come my faithful minister of E-ana, my minister who speaks fair words, my escort who speaks trustworthy words.'",
    54: "'Father Enlil, don't let anyone kill your daughter in the underworld.'",
    55: "'Don't let your precious metal be alloyed there with the dirt of the underworld.'",
    88: "'Open up, doorman, open up. I am all alone and I want to come in.'",
    90: "Neti, the chief doorman, answered holy Inana.",
    96: "Holy Inana answered him:",
    97: "'My elder sister holy Ereškigala—'",
    100: "'—she offers generous libations at his wake — that is the reason.'",
    102: "Holy Inana said to Neti:",
    113: "'She took the seven divine powers.'",
    114: "'She collected the divine powers and grasped them in her hand.'",
    115: "'With all the good divine powers, she went on her way.'",
    120: "'She covered her body with the pala dress of ladyship.'",
    138: "He said to holy Inana: 'Come on, Inana, and enter.'",
    145: "'Be satisfied, Inana, a divine power of the underworld has been fulfilled. You must not open your mouth against the rites of the underworld.'",
    150: "'Be satisfied, Inana, a divine power of the underworld has been fulfilled.'",
    155: "'Be satisfied, Inana, a divine power of the underworld has been fulfilled.'",
    160: "'Be satisfied, Inana, a divine power of the underworld has been fulfilled.'",
    165: "'Be satisfied, Inana, a divine power of the underworld has been fulfilled.'",
    170: "'Be satisfied, Inana, a divine power of the underworld has been fulfilled.'",
    173: "The pala dress, the garment of ladyship, was removed from her body.",
    175: "'Be satisfied, Inana, a divine power of the underworld has been fulfilled.'",
    181: "They looked at her — it was the look of death.",
    182: "They spoke to her — it was the speech of anger.",
    183: "They shouted at her — it was the shout of heavy guilt.",
    184: "The afflicted woman was turned into a corpse.",
    203: "'Don't let your precious metal be alloyed with the dirt of the underworld.'",
    210: "'The divine powers of the underworld are divine powers which should not be craved, for whoever gets them must remain in the underworld.'",
    224: "'The divine powers of the underworld are divine powers which should not be craved.'",
    230: "'Don't let your precious metal be alloyed with the dirt of the underworld.'",
    251: "Her holy shoulders were not covered by a linen cloth.",
    278: "Her holy shoulders were not covered by a linen cloth.",
    295: "Holy Ereškigala answered the gala-tura and the kur-ĝara.",
    333: "The demons said to holy Inana:",
    335: "Holy Inana answered the demons:",
    358: "The demons said to holy Inana:",
    360: "Holy Inana answered the demons:",
    368: "The demons said to holy Inana:",
    370: "Holy Inana answered the demons:",
    380: "She looked at him, it was the look of death.",
    381: "She spoke to him, it was the speech of anger.",
    382: "She shouted at him, it was the shout of heavy guilt.",
    383: "'How much longer? Take him away.'",
    384: "Holy Inana gave Dumuzid the shepherd into their hands.",
    409: "Holy Inana ... her heart.",
    410: "Holy Inana wept bitterly for her husband.",
    415: "'You wives who lie in your men's embrace, where is my precious husband?'",
    416: "'You children who lie in your men's embrace, where is my precious child?'",
    419: "A fly spoke to holy Inana.",
    421: "Holy Inana answered the fly.",
    424: "The fly helped holy Inana.",
    428: "Now Inana decreed this fate and thus it came to be.",
    435: "Holy Inana gave Dumuzid as a substitute.",
    436: "Holy Ereškigala — sweet is your praise.",
  };

  // Computational retranslation notes for key passages
  const RETRANSLATIONS = {
    22: "She took the seven ME → She loaded seven operational parameters.",
    23: "She collected the ME and grasped them in her hand → She gathered the parameters and held them ready.",
    24: "With the good ME, she went on her way → With the proper configurations active, she set out.",
    29: "She covered her body with the garment of ladyship → She enveloped herself with the nam-nin configuration.",
    36: "Holy Inana → Ritually-pure Inana (kug = purity, not luminosity).",
    145: "A divine power of the underworld has been fulfilled → A parameter of the underworld has been executed. Each gate strips one ME — not symbolic undressing, but systematic deconfiguration.",
    183: "The shout of heavy guilt → The shout of nam-tag: accumulated weight. Not moral judgment — a measurable burden that can be applied.",
    210: "The ME of the underworld should not be craved → The parameters of the underworld are incompatible configurations — loading them locks you in.",
    382: "The shout of heavy guilt → Again nam-tag: Inana applies karmic weight to Dumuzid. It's an act of transfer, not moral accusation.",
    428: "Inana decreed the fate → nam-tar here: she deployed a seizing-condition. Both fate-as-concept and fate-as-agent.",
  };

  let data = null;
  const panel = document.getElementById('annotation-panel');
  const body = document.getElementById('reader-body');

  async function init() {
    const resp = await fetch('/data/retranslation_descent.json');
    data = await resp.json();
    render();
    setupControls();
  }

  function render() {
    const findings = data.findings;

    // Build legend
    const legendEl = document.getElementById('legend-items');
    legendEl.innerHTML = '';
    for (const [key, f] of Object.entries(findings)) {
      const chip = document.createElement('span');
      chip.className = 'legend-chip active';
      chip.style.background = f.color + '22';
      chip.style.color = f.color;
      chip.textContent = key;
      chip.dataset.term = key;
      chip.onclick = () => {
        chip.classList.toggle('active');
        document.querySelectorAll(`.word[data-term="${key}"]`).forEach(el => {
          el.classList.toggle('key-term', chip.classList.contains('active'));
        });
      };
      legendEl.appendChild(chip);
    }

    // Build text lines
    let html = '';
    for (const line of data.lines) {
      const hasKey = line.w.some(w => w.k);
      const lineClass = `text-line${hasKey ? ' has-key' : ''}`;

      let wordsHtml = '';
      for (const w of line.w) {
        const f = w.k ? findings[w.k] : null;
        const cls = f ? 'word key-term' : 'word';
        const style = f ? `color:${f.color}` : '';
        const termAttr = w.k ? `data-term="${w.k}"` : '';
        const gloss = w.g ? `<span class="word-gloss" style="display:none">${w.g}</span>` : '';
        wordsHtml += `<span class="${cls}" style="${style}" ${termAttr}><span class="word-form">${w.f}</span>${gloss}</span> `;
      }

      // Translation
      const trans = TRANSLATIONS[line.n] || '';
      const retrans = RETRANSLATIONS[line.n] || '';
      let transHtml = '';
      if (trans) {
        transHtml = `<div class="line-translation">${trans}`;
        if (retrans) {
          transHtml += `<br/><span style="color:#e8b84b;font-style:normal;font-size:0.8rem;">🧵 ${retrans}</span>`;
        }
        transHtml += '</div>';
      }

      html += `<div class="${lineClass}" data-line="${line.n}">
        <div class="line-num">${line.n}</div>
        <div class="line-content">
          <div class="line-sumerian">${wordsHtml}</div>
          ${transHtml}
        </div>
      </div>`;
    }

    body.innerHTML = html;

    // Hover events for key terms
    body.querySelectorAll('.word.key-term').forEach(el => {
      el.addEventListener('mouseenter', showAnnotation);
      el.addEventListener('mouseleave', hideAnnotation);
    });
  }

  function showAnnotation(e) {
    const term = e.target.dataset.term;
    if (!term) return;
    const f = data.findings[term];
    if (!f) return;

    document.getElementById('ann-term').textContent = term;
    document.getElementById('ann-term').style.color = f.color;
    document.getElementById('ann-conv').textContent = f.conv;
    document.getElementById('ann-comp').textContent = f.comp;
    const confEl = document.getElementById('ann-conf');
    confEl.textContent = f.conf === 'strong' ? '✓ Strong evidence (triple-confirmed)' : '~ Moderate evidence';
    confEl.className = `ann-conf ${f.conf}`;

    const rect = e.target.getBoundingClientRect();
    panel.style.left = Math.min(rect.left, window.innerWidth - 380) + 'px';
    panel.style.top = (rect.bottom + 8) + 'px';
    panel.classList.add('visible');
  }

  function hideAnnotation() {
    panel.classList.remove('visible');
  }

  function setupControls() {
    document.getElementById('show-gloss').addEventListener('change', e => {
      body.classList.toggle('show-glosses', e.target.checked);
    });
    document.getElementById('show-translation').addEventListener('change', e => {
      body.classList.toggle('show-translations', e.target.checked);
    });
    body.classList.add('show-translations');
    
    document.getElementById('highlight-only').addEventListener('change', e => {
      document.querySelectorAll('.text-line').forEach(line => {
        if (!line.classList.contains('has-key')) {
          line.classList.toggle('hidden', e.target.checked);
        }
      });
    });
  }

  init();
</script>
