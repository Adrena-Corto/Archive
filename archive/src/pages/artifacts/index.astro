---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ItemGrid from '../../components/ItemGrid.astro';
import ArtifactFilterBar from '../../components/ArtifactFilterBar.astro';
import { getArtifacts } from '../../lib/items';

const artifacts = getArtifacts();
---

<BaseLayout title="Artifacts | Archive">
  <section class="relative py-16 min-h-screen">

    <div class="container-narrow relative">
      <div class="mb-12">
        <p class="font-mono text-xs uppercase tracking-[0.2em] text-accent mb-3">
          // Antiquities Collection
        </p>
        <h1 class="text-4xl md:text-5xl text-text mb-4">Artifacts</h1>
        <p class="text-text-muted text-lg">
          Explore <span class="text-accent font-mono">{artifacts.length}</span> artifacts spanning ancient civilizations to the modern era.
        </p>
      </div>

      <ArtifactFilterBar />

      <div id="artifact-grid">
        <ItemGrid items={artifacts} columns={3} />
      </div>
    </div>
  </section>
</BaseLayout>
