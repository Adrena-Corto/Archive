---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const articles = (await getCollection('articles'))
  .filter(article => !article.data.draft)
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 3);

const books = await getCollection('books');
const recentBooks = books.slice(0, 3);

const base = import.meta.env.BASE_URL;
function url(path: string): string {
  return `${base}${path}`.replace(/\/+/g, '/');
}

function formatDate(date: Date): string {
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric'
  });
}
---

<BaseLayout
  title="Library | Articles & Books on Ancient Coins and Artifacts"
  description="Educational articles on ancient coin collecting, cylinder seals, and artifact identification. Reference books and collecting guides for numismatists."
>
  <section class="relative py-16 min-h-screen">
    <div class="container-narrow relative">
      <div class="mb-16">
        <p class="font-mono text-xs uppercase tracking-[0.2em] text-accent mb-3">
          // Reference Materials
        </p>
        <h1 class="text-4xl md:text-5xl text-text mb-4">Library</h1>
        <p class="text-text-muted text-lg max-w-2xl">
          A collection of articles, guides, and reference books for collectors and enthusiasts of ancient coins, cylinder seals, and antiquities.
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-8 reveal-stagger">
        <!-- Articles Section -->
        <a href={url('/library/articles')} class="group glass-panel p-10 hover:border-accent/30 transition-all duration-300 reveal card-hover">
          <div class="flex items-center gap-3 mb-6">
            <div class="w-12 h-12 rounded-lg bg-accent/10 flex items-center justify-center">
              <svg class="w-6 h-6 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
              </svg>
            </div>
            <h2 class="text-2xl text-text group-hover:text-accent transition-colors">Articles</h2>
          </div>
          <p class="text-text-muted mb-8">
            Essays, identification guides, and collecting notes on ancient coins, cylinder seals, and other antiquities.
          </p>

          {articles.length > 0 ? (
            <div class="space-y-4 mb-8">
              {articles.map((article) => (
                <div class="flex items-center justify-between text-sm border-b border-white/5 pb-4 last:border-0 last:pb-0">
                  <span class="text-text-muted truncate pr-4">{article.data.title}</span>
                  <time class="font-mono text-xs text-text-dim shrink-0">{formatDate(article.data.publishDate)}</time>
                </div>
              ))}
            </div>
          ) : null}

          <span class="inline-flex items-center gap-2 font-mono text-xs uppercase tracking-widest text-accent">
            Browse Articles
            <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </span>
        </a>

        <!-- Books Section -->
        <a href={url('/library/books')} class="group glass-panel p-10 hover:border-accent/30 transition-all duration-300 reveal card-hover">
          <div class="flex items-center gap-3 mb-6">
            <div class="w-12 h-12 rounded-lg bg-accent/10 flex items-center justify-center">
              <svg class="w-6 h-6 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
              </svg>
            </div>
            <h2 class="text-2xl text-text group-hover:text-accent transition-colors">Books</h2>
          </div>
          <p class="text-text-muted mb-8">
            Reference books and literature on numismatics, ancient history, and artifact collecting from my personal library.
          </p>

          {recentBooks.length > 0 ? (
            <div class="flex gap-4 mb-8">
              {recentBooks.map((book) => (
                <div class="w-20 aspect-[2/3] rounded overflow-hidden bg-white/5 border border-white/10">
                  <img
                    src={url(`/images/books/${book.data.cover}`)}
                    alt={book.data.title}
                    class="w-full h-full object-cover"
                  />
                </div>
              ))}
              <div class="flex items-center">
                <span class="text-text-dim text-sm">+{books.length - 3} more</span>
              </div>
            </div>
          ) : null}

          <span class="inline-flex items-center gap-2 font-mono text-xs uppercase tracking-widest text-accent">
            View Collection
            <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
